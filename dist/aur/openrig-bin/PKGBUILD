# Proposed AUR packaging for openrig-bin, kept reviewed in upstream dist/.
# The AUR package itself is maintained by robertfoster
# (https://aur.archlinux.org/packages/openrig-bin); send him improvements
# from this file (see dist/README.md).
pkgname=openrig-bin
pkgver=0.12.0
pkgrel=1
pkgdesc='Open source guitar pedalboard: neural amps, IRs, LV2 plugins, scenes, looper and MIDI (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://openrig.eu'
license=('GPL-3.0-or-later')
depends=('jack' 'lilv' 'alsa-lib' 'fontconfig' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrender' 'libglvnd' 'wayland'
         'hicolor-icon-theme')
provides=('openrig')
conflicts=('openrig' 'openrig-git')
source=('openrig.desktop'
        'openrig.svg'
        'eu.openrig.OpenRig.metainfo.xml')
source_x86_64=("openrig-$pkgver-linux-x86_64.tar.gz::https://github.com/Siryu6/OpenRig/releases/download/v$pkgver/openrig-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("openrig-$pkgver-linux-aarch64.tar.gz::https://github.com/Siryu6/OpenRig/releases/download/v$pkgver/openrig-$pkgver-linux-aarch64.tar.gz")
sha256sums=('d4cd1a590bcb3f0c3bf044ac9bcbf4cc865c260d8f11784079ff058738407447'
            'a53419218f5f865d698ae2b8dbc21926ca63eceed7e4b886bd425d11d7223e86'
            '94e1ebd082cef163132c23d6b52d9efe68081dc13459f679c467e7dce9cb4cc4')
sha256sums_x86_64=('dd690af42f8b40535ced4d5f538d1a412fe119a02ef441462298b3d98f3358f5')
sha256sums_aarch64=('8234bfe7217529fda52389bfe7f5751726aad3561f339c7fbf519c855e301ade')

package() {
  install -Dm755 "openrig-$pkgver-linux-$CARCH/pedalboard" "$pkgdir/usr/bin/pedalboard"
  install -Dm644 openrig.desktop "$pkgdir/usr/share/applications/openrig.desktop"
  install -Dm644 openrig.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/openrig.svg"
  install -Dm644 eu.openrig.OpenRig.metainfo.xml "$pkgdir/usr/share/metainfo/eu.openrig.OpenRig.metainfo.xml"
  install -Dm644 "openrig-$pkgver-linux-$CARCH/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "openrig-$pkgver-linux-$CARCH/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
