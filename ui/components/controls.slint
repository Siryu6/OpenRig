import { Features } from "../features.slint";
import { Theme } from "../theme.slint";
import { Encoder } from "../encoder.slint";
import { Icon } from "icon.slint";

export { Icon }

// ---------------------------------------------------------------------------
// Encoder focus: an accent tint over its parent, in the parent's own shape
// (give its corner radius), with a lit edge; a stronger tint and edge while
// the encoder adjusts it. Shown only once the encoder is in use.
// ---------------------------------------------------------------------------
export component FocusHighlight inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    in property <bool> strong: false;
    visible: Encoder.active;
    border-radius: root.radius;
    background: Theme.accent.with-alpha(root.strong ? 0.22 : 0.12);
    border-width: root.strong ? 2px : 1px;
    border-color: Theme.accent.with-alpha(root.strong ? 1.0 : 0.75);
}

// ---------------------------------------------------------------------------
// Button: the single button used across the app.
//   variant: "primary" | "secondary" | "ghost" | "danger" | "solid-danger"
//            | "success" | "warning"
//   active:  tinted accent state (for toggle-like buttons)
// Minimum size is the touch target (44x44); icon-only when text is empty.
// ---------------------------------------------------------------------------
export component Button inherits Rectangle {
    in property <bool> focused: false;            // the encoder is on it
    in property <string> text;
    in property <string> icon;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <length> font-size: Theme.font-body;
    in property <length> icon-size: Theme.icon-size;
    in property <image> logo;                       // brand mark before the text (none = empty)
    in property <length> logo-height: 12px;
    // On a signature plate: a dark key with silk-screened text in both themes
    in property <bool> plate: false;
    out property <bool> pressed: root.down;
    private property <bool> down: ta.pressed && root.enabled;

    callback clicked();

    private property <color> fg:
        root.active ? Theme.accent :
        root.variant == "primary" ? Theme.accent :
        root.variant == "solid-danger" ? Theme.on-semantic :
        root.variant == "danger" ? Theme.danger :
        root.variant == "success" ? Theme.success :
        root.variant == "warning" ? Theme.warning :
        root.variant == "ghost" ? Theme.text-secondary :
        root.plate ? Theme.plate-silk :
        Theme.text-primary;

    // Physical key look: raised gradient with a lit top edge, sunk when pressed
    private property <bool> keycap: root.variant != "ghost";

    min-width: Theme.touch-target;
    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    opacity: root.enabled ? 1.0 : 0.4;
    border-width: root.keycap ? Theme.border-width : 0px;
    border-color: root.active ? Theme.accent
        : root.variant == "primary" ? Theme.accent.with-alpha(0.55)
        : root.variant == "solid-danger" ? Theme.danger.darker(0.3)
        : root.variant == "danger" ? Theme.danger.with-alpha(0.45)
        : root.variant == "success" ? Theme.success.with-alpha(0.45)
        : root.variant == "warning" ? Theme.warning.with-alpha(0.45)
        : root.plate ? Theme.plate-edge
        : Theme.edge-dark-soft;
    background:
        root.variant == "solid-danger" ? (root.down ? Theme.danger.darker(0.2) : Theme.danger) :
        root.variant == "ghost" ? (root.down ? Theme.surface-hover : transparent) :
        root.plate ? (root.down ? Theme.plate-key-pressed : Theme.plate-key) :
        (root.down ? Theme.key-pressed : Theme.key);

    // Lit top edge (hidden while pressed: the key is down)
    if root.keycap && !root.down: Rectangle {
        x: root.border-radius / 2;
        y: 1px;
        width: parent.width - root.border-radius;
        height: 1px;
        background: root.plate ? Theme.plate-key-edge : Theme.edge-light;
    }
    // Lit key (toggle on, main action): LED strip under the label
    if root.active || (root.variant == "primary" && root.enabled): Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 5px;
        width: min(parent.width - 12px, 28px);
        height: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: root.text == "" ? 0px : Theme.space-lg;
        padding-right: root.text == "" ? 0px : Theme.space-lg;
        spacing: Theme.space-sm;
        alignment: center;

        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: root.icon-size;
                color: root.fg;
            }
        }

        if root.logo.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.logo;
                height: root.logo-height;
                width: self.height * root.logo.width / root.logo.height;
                image-fit: contain;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // Stays enabled when the button is not: a tap on a disabled button must
    // not fall through to what lies behind it
    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    if root.focused: FocusHighlight {
        radius: root.border-radius;
    }
}

// ---------------------------------------------------------------------------
// Card: graphite panel with a lit top edge.
// ---------------------------------------------------------------------------
export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius-lg;
    border-width: Theme.border-width;
    border-color: Theme.border;

    Rectangle {
        x: root.border-radius;
        y: 1px;
        width: parent.width - 2 * root.border-radius;
        height: 1px;
        background: Theme.edge-light;
    }
}

// ---------------------------------------------------------------------------
// Display: inset screen (tuner, looper), darker than the panels around it.
// ---------------------------------------------------------------------------
export component Display inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.display;
    border-width: Theme.border-width;
    border-color: Theme.edge-dark;

    // Inset shadow
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 3px;
        background: Theme.inset-shadow;
    }
}

// ---------------------------------------------------------------------------
// Overline section header ("PRESETS", "PARAMETERS", ...)
// ---------------------------------------------------------------------------
export component SectionHeader inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    font-weight: Theme.weight-bold;
    vertical-alignment: center;
}

// ---------------------------------------------------------------------------
// Badge: small pill label. tone: "neutral" | "accent" | "success" | "warning" | "danger"
// ---------------------------------------------------------------------------
export component Badge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";

    private property <color> fg:
        root.tone == "accent" ? Theme.accent :
        root.tone == "success" ? Theme.success :
        root.tone == "warning" ? Theme.warning :
        root.tone == "danger" ? Theme.danger :
        Theme.text-secondary;

    height: 22px;
    border-radius: Theme.radius-sm;
    background: root.tone == "neutral" ? Theme.surface-hover : root.fg.with-alpha(0.14);

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// Chip: selectable pill (filters, categories)
// ---------------------------------------------------------------------------
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    background: ta.pressed ? Theme.key-pressed : Theme.key;
    border-width: Theme.border-width;
    border-color: root.selected ? Theme.accent : Theme.edge-dark-soft;

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        Text {
            text: root.text;
            color: root.selected ? Theme.accent : Theme.text-secondary;
            font-size: Theme.font-small;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ---------------------------------------------------------------------------
// Toggle switch (44px tall hit area). Controlled: the parent owns `checked`
// and updates it in response to `toggled(new-value)`.
// ---------------------------------------------------------------------------
export component Toggle inherits Rectangle {
    in property <bool> focused: false;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <color> accent: Theme.accent;
    // Its slot: a plate passes its own dark window colour (gear stays dark)
    in property <color> well: Theme.display;
    callback toggled(bool);

    width: 56px;
    height: Theme.touch-target;
    opacity: root.enabled ? 1.0 : 0.4;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 28px;
        border-radius: Theme.radius-sm;
        background: root.well;
        border-width: Theme.border-width;
        border-color: Theme.edge-dark;

        // Lit slot behind the cap
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 1px;
            background: root.checked ? root.accent.with-alpha(0.85) : transparent;
            animate background { duration: Theme.motion-normal; }
        }
        // Cap
        Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 24px;
            height: parent.height - 6px;
            border-radius: 1px;
            background: @linear-gradient(180deg, #4a4c51 0%, #2a2b2f 100%);
            border-width: 1px;
            border-color: #000000a0;
            animate x { duration: Theme.motion-normal; easing: ease-out; }
            // Grip line
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 5px;
                width: 2px;
                height: parent.height - 10px;
                background: #00000080;
            }
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled(!root.checked);
        }
    }

    // On the switch itself, not the taller touch area around it
    if root.focused: FocusHighlight {
        y: track.y;
        height: track.height;
        radius: track.border-radius;
    }
}

// ---------------------------------------------------------------------------
// Horizontal slider (value in [minimum, maximum]). Controlled: shows the live
// drag value while pressed, then `value` (owned by the parent / backend).
// ---------------------------------------------------------------------------
export component Slider inherits Rectangle {
    in property <bool> focused: false;
    in property <bool> adjusting: false;          // the encoder moves it
    in property <float> value: 0.5;
    out property <bool> dragging: ta.pressed;
    out property <float> shown-value: ta.pressed ? root.live-value : root.value;
    private property <float> live-value: root.value;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <bool> enabled: true;
    // Fill from the middle of the track (pan, balance) instead of its start
    in property <bool> centered: false;
    callback changed(float);

    private property <float> norm: (root.maximum - root.minimum) == 0 ? 0 :
        max(0, min(1, (root.shown-value - root.minimum) / (root.maximum - root.minimum)));
    private property <length> thumb: 24px;

    min-width: 120px;
    height: Theme.touch-target;
    opacity: root.enabled ? 1.0 : 0.4;

    // Track
    Rectangle {
        x: root.thumb / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.thumb;
        height: 4px;
        background: Theme.track;

        Rectangle {
            x: root.centered ? parent.width * min(0.5, root.norm) : 0;
            width: parent.width * (root.centered ? abs(root.norm - 0.5) : root.norm);
            height: 100%;
            background: Theme.accent;
        }
    }

    // Thumb
    Rectangle {
        x: root.thumb / 2 + (parent.width - root.thumb) * root.norm - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 30px;
        border-radius: 2px;
        background: @linear-gradient(180deg, #55575c 0%, #2c2d31 100%);
        border-width: 1px;
        border-color: #000000;
        // Index line, across the travel
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 3px;
            width: 2px;
            height: parent.height - 6px;
            background: #ffffffd0;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        function update(px: length) {
            let value = root.minimum + (root.maximum - root.minimum)
                * max(0, min(1, (px - root.thumb / 2) / max(1px, root.width - root.thumb)));
            // Only report real moves (each one reaches the audio engine)
            if (value != root.live-value) {
                root.live-value = value;
                root.changed(value);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.update(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                self.update(self.mouse-x);
            }
        }
    }

    if root.focused: FocusHighlight {
        radius: Theme.radius-md;
        strong: root.adjusting;
    }
}

// Plate knob drawings, viewbox 100 x 100
global KnobPaths {
    // 11 scale ticks from 7:30 to 4:30
    out property <string> ticks: "M 19.59 80.41 L 15.35 84.65 M 9.10 63.29 L 3.40 65.14 M 7.53 43.27 L 1.60 42.33 M 15.21 24.73 L 10.36 21.20 M 30.48 11.69 L 27.75 6.34 M 50.00 7.00 L 50.00 1.00 M 69.52 11.69 L 72.25 6.34 M 84.79 24.73 L 89.64 21.20 M 92.47 43.27 L 98.40 42.33 M 90.90 63.29 L 96.60 65.14 M 80.41 80.41 L 84.65 84.65";
    // Knurled skirt: 48 short radial lines
    out property <string> knurl: "M 83.00 50.00 L 91.00 50.00 M 82.72 54.31 L 90.65 55.35 M 81.88 58.54 L 89.60 60.61 M 80.49 62.63 L 87.88 65.69 M 78.58 66.50 L 85.51 70.50 M 76.18 70.09 L 82.53 74.96 M 73.33 73.33 L 78.99 78.99 M 70.09 76.18 L 74.96 82.53 M 66.50 78.58 L 70.50 85.51 M 62.63 80.49 L 65.69 87.88 M 58.54 81.88 L 60.61 89.60 M 54.31 82.72 L 55.35 90.65 M 50.00 83.00 L 50.00 91.00 M 45.69 82.72 L 44.65 90.65 M 41.46 81.88 L 39.39 89.60 M 37.37 80.49 L 34.31 87.88 M 33.50 78.58 L 29.50 85.51 M 29.91 76.18 L 25.04 82.53 M 26.67 73.33 L 21.01 78.99 M 23.82 70.09 L 17.47 74.96 M 21.42 66.50 L 14.49 70.50 M 19.51 62.63 L 12.12 65.69 M 18.12 58.54 L 10.40 60.61 M 17.28 54.31 L 9.35 55.35 M 17.00 50.00 L 9.00 50.00 M 17.28 45.69 L 9.35 44.65 M 18.12 41.46 L 10.40 39.39 M 19.51 37.37 L 12.12 34.31 M 21.42 33.50 L 14.49 29.50 M 23.82 29.91 L 17.47 25.04 M 26.67 26.67 L 21.01 21.01 M 29.91 23.82 L 25.04 17.47 M 33.50 21.42 L 29.50 14.49 M 37.37 19.51 L 34.31 12.12 M 41.46 18.12 L 39.39 10.40 M 45.69 17.28 L 44.65 9.35 M 50.00 17.00 L 50.00 9.00 M 54.31 17.28 L 55.35 9.35 M 58.54 18.12 L 60.61 10.40 M 62.63 19.51 L 65.69 12.12 M 66.50 21.42 L 70.50 14.49 M 70.09 23.82 L 74.96 17.47 M 73.33 26.67 L 78.99 21.01 M 76.18 29.91 L 82.53 25.04 M 78.58 33.50 L 85.51 29.50 M 80.49 37.37 L 87.88 34.31 M 81.88 41.46 L 89.60 39.39 M 82.72 45.69 L 90.65 44.65";
}

// ---------------------------------------------------------------------------
// Rotary knob: 270 degree arc, drag vertically to change. Controlled like
// Slider: live value while dragging, then the parent-owned `value`.
// Double tap: back to `default-value`. Hold without moving: swap with the
// value before the last change (A/B compare).
// ---------------------------------------------------------------------------
export component Knob inherits Rectangle {
    in property <float> value: 0.5;
    out property <float> shown-value: ta.pressed ? root.live-value : root.value;
    private property <float> live-value: root.value;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <bool> integer: false;
    in property <bool> focused: false;
    // The encoder is on it, and in use
    private property <bool> lit: root.focused && Encoder.active;
    in property <bool> enabled: true;
    in property <length> size: 76px;
    in property <color> accent: Theme.accent;      // value arc (the block's colour)
    // Knob of an OpenRig FX plate (openrig:knobStyle): "skirted",
    // "chickenhead" or "domed" on a silk scale; anything else is the
    // OpenRig knob with its value arc
    in property <string> knob-style: "";
    // A steel cap (skirted knobs on a very dark plate), else a black one
    in property <bool> steel: false;
    in property <float> default-value: root.minimum;
    out property <bool> dragging: ta.pressed;
    callback changed(float);

    // The value before the last change, for the A/B compare
    private property <float> previous: root.value;
    private property <bool> has-previous: false;
    // The finger moved the knob: no double tap, no compare
    private property <bool> moved: false;

    function set(v: float) {
        if (v != root.value) {
            root.previous = root.value;
            root.has-previous = true;
            root.changed(v);
        }
    }

    private property <float> norm: (root.maximum - root.minimum) == 0 ? 0 :
        max(0, min(1, (root.shown-value - root.minimum) / (root.maximum - root.minimum)));
    // Angles in degrees, clockwise from +x (screen coordinates)
    private property <float> angle: 135 + 270 * root.norm;
    private property <bool> plain: root.knob-style != "skirted" && root.knob-style != "chickenhead"
        && root.knob-style != "domed";
    private property <bool> hot: root.lit || ta.pressed;
    private property <float> start-norm: 0;
    private property <length> start-y: 0;
    private property <float> pending: 0;

    width: root.size;
    height: root.size;
    opacity: root.enabled ? 1.0 : 0.4;

    // Value arc around the knob (viewbox 100x100, radius 44)
    if root.plain: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.track;
        stroke-width: 6px;
        fill: transparent;
        commands: "M 18.89 81.11 A 44 44 0 1 1 81.11 81.11";
    }

    if root.plain && root.norm > 0.004: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.hot ? root.accent.brighter(0.25) : root.accent;
        stroke-width: 6px;
        fill: transparent;
        commands: "M 18.89 81.11 A 44 44 0 " + (270 * root.norm > 180 ? "1" : "0") + " 1 "
            + (50 + 44 * cos(root.angle * 1deg)) + " " + (50 + 44 * sin(root.angle * 1deg));
    }

    // Plate knobs: a silk scale, a dot for the value
    if !root.plain: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.plate-silk-muted;
        stroke-width: 1.5px;
        fill: transparent;
        commands: KnobPaths.ticks;
    }
    if !root.plain: Rectangle {
        x: root.width * (0.5 + 0.47 * cos(root.angle * 1deg)) - self.width / 2;
        y: root.height * (0.5 + 0.47 * sin(root.angle * 1deg)) - self.height / 2;
        width: max(4px, root.size * 0.05);
        height: self.width;
        border-radius: self.width / 2;
        background: root.hot ? root.accent.brighter(0.3) : root.accent;
    }

    // Skirt (a shadow ring under a chickenhead or a dome)
    Rectangle {
        x: parent.width * (root.knob-style == "skirted" ? 0.09 : root.knob-style == "domed" ? 0.13 : 0.17);
        y: self.x;
        width: parent.width - 2 * self.x;
        height: self.width;
        border-radius: self.width / 2;
        background: root.plain ? #0c0d10
            : root.knob-style == "skirted" && !root.steel ? Theme.knob-skirt-light : Theme.knob-black;
        border-width: 1px;
        border-color: root.lit ? root.accent : root.plain ? #30343c : #000000;
    }
    if root.knob-style == "skirted": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.steel ? #ffffff26 : #00000059;
        stroke-width: 1px;
        fill: transparent;
        commands: KnobPaths.knurl;
    }

    // Chickenhead: a pointer shape around a round body
    if root.knob-style == "chickenhead": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: Theme.knob-black;
        stroke: #000000;
        stroke-width: 1px;
        commands: "M " + (50 + 44 * cos(root.angle * 1deg)) + " " + (50 + 44 * sin(root.angle * 1deg))
            + " L " + (50 + 27 * cos((root.angle + 52) * 1deg)) + " " + (50 + 27 * sin((root.angle + 52) * 1deg))
            + " L " + (50 + 30 * cos((root.angle + 150) * 1deg)) + " " + (50 + 30 * sin((root.angle + 150) * 1deg))
            + " L " + (50 + 30 * cos((root.angle + 210) * 1deg)) + " " + (50 + 30 * sin((root.angle + 210) * 1deg))
            + " L " + (50 + 27 * cos((root.angle - 52) * 1deg)) + " " + (50 + 27 * sin((root.angle - 52) * 1deg)) + " Z";
    }

    // Cap: lit from above
    Rectangle {
        x: parent.width * (root.knob-style == "skirted" ? 0.21 : root.knob-style == "chickenhead" ? 0.26
            : root.knob-style == "domed" ? 0.15 : 0.24);
        y: self.x;
        width: parent.width - 2 * self.x;
        height: self.width;
        border-radius: self.width / 2;
        background: root.knob-style == "domed" ? (Features.flat ? Theme.knob-alu-flat : Theme.knob-alu)
            : root.knob-style == "skirted" && root.steel ? (Features.flat ? Theme.knob-steel-flat : Theme.knob-steel)
            : !root.plain ? (Features.flat ? Theme.knob-black-top
                : @linear-gradient(180deg, Theme.knob-black-top 0%, Theme.knob-black 70%))
            : Features.flat ? (ta.pressed ? #292c32 : #30343b)
            : ta.pressed ? @linear-gradient(180deg, #34383f 0%, #1e2126 100%)
            : @linear-gradient(180deg, #41464f 0%, #1f2227 100%);
        border-width: 1px;
        border-color: #00000099;
    }

    // Pointer: a dot on a dome, a line from the cap centre otherwise
    if root.knob-style == "domed": Rectangle {
        x: root.width * (0.5 + 0.25 * cos(root.angle * 1deg)) - self.width / 2;
        y: root.height * (0.5 + 0.25 * sin(root.angle * 1deg)) - self.height / 2;
        width: max(5px, root.size * 0.08);
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.knob-black;
    }
    if root.knob-style != "domed": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.plain ? #f4f6f8 : Theme.knob-line;
        stroke-width: root.plain ? 3px : max(2px, root.size * 0.03);
        fill: transparent;
        // Inner and outer radius of the line
        property <float> r0: root.knob-style == "chickenhead" || root.knob-style == "skirted" ? 10 : 8;
        property <float> r1: root.knob-style == "chickenhead" ? 40 : root.knob-style == "skirted" ? 28 : 31;
        commands: "M " + (50 + self.r0 * cos(root.angle * 1deg)) + " " + (50 + self.r0 * sin(root.angle * 1deg))
            + " L " + (50 + self.r1 * cos(root.angle * 1deg)) + " " + (50 + self.r1 * sin(root.angle * 1deg));
    }


    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.live-value = root.value;
                root.start-norm = root.norm;
                root.start-y = self.mouse-y;
                root.moved = false;
            } else if (event.kind == PointerEventKind.up && root.moved) {
                // The value before this drag
                root.previous = root.minimum + (root.maximum - root.minimum) * root.start-norm;
                root.has-previous = true;
            }
        }
        moved => {
            if (self.pressed) {
                // 160px of vertical travel = full range
                root.pending = root.minimum + (root.maximum - root.minimum)
                    * max(0, min(1, root.start-norm + (root.start-y - self.mouse-y) / 160px));
                if (root.integer) {
                    root.pending = round(root.pending);
                }
                if (root.pending != root.live-value) {
                    root.moved = true;
                    root.live-value = root.pending;
                    root.changed(root.pending);
                }
            }
        }
        double-clicked => {
            if (!root.moved) {
                root.set(root.default-value);
            }
        }
    }

    // Hold: A/B compare
    Timer {
        interval: 600ms;
        running: ta.pressed && !root.moved && root.has-previous;
        triggered => {
            root.moved = true;  // the release must not count as a tap
            root.set(root.previous);
        }
    }
}

// One key of a Segmented control
component SegmentKey inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> plate;
    in property <length> font-size;
    callback clicked();

    border-radius: Theme.radius-sm;
    background: root.plate ? transparent : root.on ? Theme.key : (ta.pressed ? Theme.surface-hover : transparent);
    border-width: !root.plate && root.on ? 1px : 0px;
    border-color: Theme.edge-dark-soft;

    if !root.plate && root.on: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 5px;
        width: min(parent.width - 12px, 28px);
        height: 2px;
        background: Theme.accent;
    }
    // On a plate: an LED, lit on the chosen mode
    if root.plate: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        background: root.on ? Theme.accent : Theme.led-off;
        border-width: 1px;
        border-color: #000000;
    }

    Text {
        x: root.plate ? 22px : 0px;
        width: parent.width - self.x;
        text: root.plate ? root.label.to-uppercase() : root.label;
        color: root.plate ? (root.on ? Theme.plate-silk : Theme.plate-silk-muted)
            : root.on ? Theme.text-primary : Theme.text-secondary;
        font-size: root.font-size;
        font-weight: root.plate ? Theme.weight-bold : Theme.weight-semibold;
        letter-spacing: root.plate ? 0.8px : 0px;
        horizontal-alignment: root.plate ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ---------------------------------------------------------------------------
// Segmented control (equal-size options). Controlled: parent updates
// `current-index` in response to `activated(index)`. `vertical` stacks the
// keys (give it a height); `plate` draws them silk-screened on a faceplate,
// an LED by each label, as a pedal's mode selector.
// ---------------------------------------------------------------------------
export component Segmented inherits Rectangle {
    in property <bool> focused: false;
    in property <bool> adjusting: false;          // the encoder moves it
    in property <[string]> options;
    in property <int> current-index: 0;
    in property <length> font-size: Theme.font-small;
    in property <bool> vertical: false;
    in property <bool> plate: false;
    callback activated(int);

    property <length> pad: root.plate ? 0px : 3px;
    property <length> gap: 2px;
    property <length> key-height: (root.height - 2 * root.pad - (root.options.length - 1) * root.gap) / max(1, root.options.length);
    property <[string]> in-row: root.vertical ? [] : root.options;

    min-height: root.vertical ? 0px : Theme.touch-target;
    border-radius: Theme.radius-md;
    background: root.plate ? transparent : Theme.surface-raised;
    border-width: root.plate ? 0px : Theme.border-width;
    border-color: Theme.border;

    HorizontalLayout {
        padding: root.pad;
        spacing: root.gap;
        for option[i] in root.in-row: SegmentKey {
            horizontal-stretch: 1;
            min-width: 36px;
            label: option;
            on: i == root.current-index;
            plate: root.plate;
            font-size: root.font-size;
            clicked => {
                root.activated(i);
            }
        }
    }
    if root.vertical: Rectangle {
        for option[i] in root.options: SegmentKey {
            x: root.pad;
            y: root.pad + i * (root.key-height + root.gap);
            width: root.width - 2 * root.pad;
            height: root.key-height;
            label: option;
            on: i == root.current-index;
            plate: root.plate;
            font-size: root.font-size;
            clicked => {
                root.activated(i);
            }
        }
    }

    if root.focused: FocusHighlight {
        radius: root.border-radius;
        strong: root.adjusting;
    }
}

// ---------------------------------------------------------------------------
// Stepper: [-] value [+]
// ---------------------------------------------------------------------------
export component Stepper inherits Rectangle {
    in property <bool> focused: false;
    in property <bool> adjusting: false;
    in property <string> text;
    in property <bool> can-decrement: true;
    in property <bool> can-increment: true;
    callback decrement();
    callback increment();

    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    border-width: Theme.border-width;
    border-color: Theme.border;

    HorizontalLayout {
        Button {
            icon: "minus";
            variant: "ghost";
            enabled: root.can-decrement;
            clicked => {
                root.decrement();
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        Button {
            icon: "plus";
            variant: "ghost";
            enabled: root.can-increment;
            clicked => {
                root.increment();
            }
        }
    }

    if root.focused: FocusHighlight {
        radius: root.border-radius;
        strong: root.adjusting;
    }
}

// ---------------------------------------------------------------------------
// Empty state: centred icon + title + message
// ---------------------------------------------------------------------------
export component EmptyState inherits VerticalLayout {
    in property <string> icon: "info";
    in property <string> title;
    in property <string> message;

    alignment: center;
    spacing: Theme.space-md;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: Theme.radius-lg;
            background: Theme.surface-raised;
            Icon {
                name: root.icon;
                size: 26px;
                color: Theme.text-muted;
            }
        }
    }

    Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
    }

    if root.message != "": Text {
        text: root.message;
        color: Theme.text-secondary;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------------------
// Thin separator lines
// ---------------------------------------------------------------------------
export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}
