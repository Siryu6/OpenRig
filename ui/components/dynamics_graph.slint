import { Theme } from "../theme.slint";
import { DynView, DynLive } from "../types.slint";
import { Caption, DbLabels, Handle, InOut, Plot, PlotPath } from "plot.slint";

// Level curve of a compressor, limiter or gate, with what it does right now:
// the sound on the curve, the last seconds in and out, and the gain
// reduction. Drag the threshold point across, or the end of a compressor's
// curve up and down for its ratio.
export component DynamicsGraph inherits Rectangle {
    in property <DynView> dyn;
    in property <DynLive> live;
    in property <color> accent: Theme.accent;
    in property <bool> bypassed: false;

    private property <color> line: root.dyn.enabled && !root.bypassed ? root.accent : Theme.text-muted;
    private property <length> side: root.height - 34px;

    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    // Shared by the curve and the history
    DbLabels {
        top: curve.y;
        side: root.side;
    }

    curve := Plot {
        x: 40px;
        y: 12px;
        width: root.side;
        height: root.side;

        for f in [0.2, 0.4, 0.6, 0.8]: Rectangle {
            x: f * curve.width;
            width: 1px;
            height: curve.height;
            background: Theme.border;
        }
        // Unity: what comes in goes out
        PlotPath {
            commands: "M 0 1000 L 1000 0";
            stroke: Theme.border-strong;
            stroke-width: 1px;
        }
        PlotPath {
            commands: root.dyn.curve;
            stroke: root.line;
            stroke-width: 2.5px;
        }
    }

    // Ratio and threshold handles, over the curve (the threshold on top: at
    // 0 dB both sit in the corner, where the ratio changes nothing)
    Handle {
        handle: root.dyn.ratio;
        accent: root.line;
        plot-x: curve.x;
        plot-y: curve.y;
        plot-width: curve.width;
        plot-height: curve.height;
    }
    Handle {
        handle: root.dyn.threshold;
        accent: root.line;
        plot-x: curve.x;
        plot-y: curve.y;
        plot-width: curve.width;
        plot-height: curve.height;
    }
    // The sound, on the curve (over the handles, which it passes through)
    if root.live.active: Rectangle {
        x: curve.x + root.live.input * curve.width - 6px;
        y: curve.y + (1 - root.live.output) * curve.height - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text-primary;
        border-width: 2px;
        border-color: root.line;
    }

    // The last seconds: in (grey), out (block colour), reduction from the top
    history := Plot {
        x: curve.x + curve.width + 12px;
        y: curve.y;
        width: root.width - self.x - 64px;
        height: curve.height;
        wide: true;

        InOut {
            input: root.live.history-in;
            output: root.live.history-out;
            accent: root.line;
        }
        PlotPath {
            commands: root.live.history-reduction;
            stroke: Theme.danger;
            stroke-width: 2px;
        }
        Caption {
            x: 6px;
            y: history.height - self.height - 6px;
            text: root.dyn.kind + (root.dyn.summary == "" ? "" : "  ·  " + root.dyn.summary);
        }
    }

    // Gain reduction meter, falling from the top
    Rectangle {
        x: root.width - 52px;
        y: curve.y;
        width: 40px;
        height: curve.height;
        Text {
            y: 0;
            width: parent.width;
            text: "GR";
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
        }
        bar := Rectangle {
            x: (parent.width - 14px) / 2;
            y: 16px;
            width: 14px;
            height: parent.height - 40px;
            background: Theme.display;
            border-radius: Theme.radius-sm;
            Rectangle {
                y: 0;
                width: parent.width;
                // 30 dB over the whole bar (dynamics_ui::REDUCTION_SCALE)
                height: min(1, -root.live.reduction / 30) * parent.height;
                background: Theme.danger;
                border-radius: Theme.radius-sm;
            }
        }
        Text {
            y: parent.height - 18px;
            width: parent.width;
            text: root.live.reduction-text;
            color: root.live.reduction < -0.5 ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            horizontal-alignment: center;
        }
    }
}
