import { Features } from "../features.slint";
import { Theme } from "../theme.slint";
import { BlockFace } from "../types.slint";
import { T3kMark } from "tone3000_brand.slint";
import { LogoMark } from "logo.slint";
import { PlateName } from "plate.slint";

// Rack block drawn after the gear it stands for, so the chain reads at a
// glance: an amp head is a flat box with its control panel, a combo adds a
// grille, a cabinet shows its speakers, a pedal has its footswitch, a space
// is a rounded box, a send or a return is a jack plate. Other blocks are
// plain cards. A plugin whose store picture shows its own face (a pedal, an
// amp) is drawn as that picture, framed in its colour.
// Faces are dark (black tolex, grilles, graphite enclosures): the block's
// colour (its family's, or the user's) is only its frame and trim, plus a
// faint glow while it plays. A bypassed block loses its colour and its LED.
// An OpenRig FX block carries its origin: a basic one is the plain card
// with an amber left edge, the OR FX mark, its name and a drawing of what
// it does.
export component BlockShape {
    in property <string> kind;          // "amp" | "combo" | "cab" | "pedal" | "space" | "send" | "return" | ""
    in property <string> name;
    in property <color> tint;           // the user's colour, else the family's
    in property <bool> bypassed: false;
    in property <bool> selected: false;
    in property <bool> pressed: false;
    in property <bool> t3k: false;      // loads a TONE3000 tone: carries its mark
    in property <image> picture;        // the plugin's own face, from the store
    in property <bool> has-picture: false;
    // OpenRig FX look; signature: a small pedal on its plate (picture, or
    // colour when flat)
    in property <BlockFace> faceplate;

    // Picture: fitted in 84 x 60, wide strips cropped to 36 high
    private property <float> aspect: root.picture.width / max(1, root.picture.height);

    // Size of the gear (the rack keeps the same cells for every kind)
    out property <length> shape-width: root.signature ? 72px : root.has-picture ? min(84px, 60px * root.aspect)
        : root.kind == "amp" ? 90px : root.kind == "combo" ? 82px
        : root.kind == "cab" ? 68px : root.kind == "pedal" ? 62px : root.jack ? 66px : 84px;
    out property <length> shape-height: root.signature ? 60px : root.has-picture ? max(36px, min(60px, 84px / root.aspect))
        : root.kind == "amp" ? 46px : root.kind == "combo" ? 58px
        : root.kind == "cab" ? 58px : root.kind == "pedal" ? 60px : root.kind == "space" ? 46px
        : root.jack ? 40px : 52px;

    private property <bool> gear: root.kind != "";
    private property <bool> basic: root.faceplate.look == "basic";
    private property <bool> signature: root.faceplate.look == "signature";
    // Frame and trim colour
    private property <color> trim: root.bypassed ? #34363b : root.tint;
    private property <color> face: root.pressed ? #2a2b2f : #1b1c1f;
    private property <length> radius: root.kind == "space" ? 6px
        : root.kind == "pedal" ? 4px : 3px;
    // Amp control panel strip
    private property <bool> has-panel: root.kind == "amp" || root.kind == "combo";
    private property <length> panel-h: 12px;
    // Send or return: a jack socket on the side the signal leaves or enters by
    private property <bool> jack: root.kind == "send" || root.kind == "return";
    private property <length> socket: 14px;

    width: root.shape-width;
    height: root.shape-height;

    // Glow of a block that plays (no blur: a soft halo)
    if !root.bypassed: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 3px;
        background: root.tint.with-alpha(0.16);
    }

    // Selection ring, outside the gear
    if root.selected: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: root.radius + 4px;
        border-width: 2px;
        border-color: Theme.selection;
    }

    Rectangle {
        visible: !root.signature;
        border-radius: root.radius;
        background: Features.flat ? root.face : @linear-gradient(180deg, root.face.brighter(0.15) 0%, root.face.darker(0.25) 100%);
        border-width: 2px;
        border-color: root.trim;
        clip: true;

        // Amp head / combo: control panel with a row of knobs
        if root.has-panel: Rectangle {
            y: 0;
            height: root.panel-h;
            background: @linear-gradient(180deg, #3a3b40 0%, #26272b 100%);
            // Trim under the panel
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: root.trim;
            }
            // Moved right to make room for the T3K mark
            for k in 5: Rectangle {
                x: parent.width / 2 + (k - 2) * 11px - 2.5px + (root.t3k ? 7px : 0px);
                y: (parent.height - 5px) / 2;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: root.bypassed ? #5a5f68 : #f2f2f2d0;
            }
        }

        // Combo and cabinet: grille cloth
        if root.kind == "combo" || root.kind == "cab": Rectangle {
            x: 4px;
            y: root.kind == "combo" ? root.panel-h + 3px : 4px;
            width: parent.width - 8px;
            height: parent.height - self.y - 4px;
            border-radius: 1px;
            background: #0b0b0c;
            border-width: 1px;
            border-color: #000000;

            // Speakers
            for s in root.kind == "cab" ? 2 : 1: Rectangle {
                property <length> d: min(parent.height - 6px, root.kind == "cab" ? 24px : 30px);
                x: root.kind == "cab" ? parent.width / 2 + (s == 0 ? -self.d - 1px : 1px) : (parent.width - self.d) / 2;
                y: (parent.height - self.d) / 2;
                width: self.d;
                height: self.d;
                border-radius: self.d / 2;
                border-width: 1px;
                border-color: #ffffff1c;
                Rectangle {
                    width: parent.d / 3;
                    height: parent.d / 3;
                    border-radius: parent.d / 6;
                    background: #ffffff0c;
                }
            }
        }

        // Pedal: two knobs on top, footswitch at the bottom
        if root.kind == "pedal": Rectangle {
            for k in 2: Rectangle {
                x: k == 0 ? 8px : parent.width - 8px - 8px;
                y: 6px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.bypassed ? #5a5f68 : #f2f2f2d0;
            }
            Rectangle {
                x: (parent.width - 12px) / 2;
                y: parent.height - 15px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #c9ccd2;
                border-width: 1px;
                border-color: #6b7280;
            }
        }

        if root.jack: Rectangle {
            x: root.kind == "return" ? 6px : parent.width - 6px - root.socket;
            y: (parent.height - root.socket) / 2;
            width: root.socket;
            height: root.socket;
            border-radius: root.socket / 2;
            background: #0b0b0c;
            border-width: 2px;
            border-color: root.bypassed ? #5a5f68 : #b9bcc2;
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: #000000;
            }
        }

        Text {
            x: root.kind == "return" ? root.socket + 8px : 3px;
            y: root.has-panel ? root.panel-h : root.kind == "pedal" ? 15px : 3px;
            width: parent.width - 6px - (root.jack ? root.socket + 5px : 0px);
            height: parent.height - self.y - (root.kind == "pedal" ? 17px : 2px);
            visible: !root.has-picture && !root.basic;
            text: root.name;
            color: root.bypassed ? Theme.text-muted : #ffffff;
            font-size: root.kind == "pedal" || root.kind == "cab" || root.jack ? 10px : Theme.font-caption;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }

        if root.has-picture: Image {
            width: parent.width;
            height: parent.height;
            source: root.picture;
            image-fit: cover;
        }
        // Bypassed: faded; pressed: lit
        if root.has-picture && (root.bypassed || root.pressed): Rectangle {
            background: root.bypassed ? #000000a0 : #ffffff1c;
        }
        // Frame over the picture
        if root.has-picture: Rectangle {
            border-radius: root.radius;
            border-width: 2px;
            border-color: root.trim;
        }

        // OpenRig FX, basic: amber edge, mark, name, what it does
        if root.basic: Rectangle {
            Rectangle {
                x: 2px;
                y: 2px;
                width: 3px;
                height: parent.height - 4px;
                background: root.bypassed ? Theme.led-off : Theme.accent;
            }
            HorizontalLayout {
                x: 9px;
                y: 4px;
                height: 10px;
                spacing: 3px;
                LogoMark {
                    size: 9px;
                    color: root.bypassed ? Theme.text-muted : Theme.accent;
                }
                Text {
                    text: "OR FX";
                    color: root.bypassed ? Theme.text-muted : Theme.accent;
                    font-size: Theme.font-micro;
                    font-weight: Theme.weight-bold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 9px;
                y: 15px;
                width: parent.width - 14px;
                height: 18px;
                text: root.faceplate.name;
                color: root.bypassed ? Theme.text-muted : #ffffff;
                font-size: Theme.font-small;
                font-weight: Theme.weight-bold;
                vertical-alignment: center;
                overflow: elide;
            }
            Path {
                x: 10px;
                y: 35px;
                width: parent.width - 20px;
                height: 11px;
                viewbox-width: 50;
                viewbox-height: 14;
                stroke: root.bypassed ? Theme.text-muted : Theme.accent;
                stroke-width: 1.5px;
                fill: transparent;
                commands: root.faceplate.glyph;
            }
        }
    }

    // OpenRig FX, signature: a small pedal: its plate, two knobs in its
    // style, its silk name and a footswitch (the LED is the block's own)
    if root.signature: Rectangle {
        border-radius: root.radius;
        background: root.faceplate.plate-color;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.faceplate.plate;
            image-fit: fill;
        }
        Rectangle {
            x: 2px;
            y: 1px;
            width: parent.width - 4px;
            height: 1px;
            background: Theme.plate-bevel;
        }
        for k in 2: Rectangle {
            x: k == 0 ? 7px : parent.width - 7px - self.width;
            y: 5px;
            width: 13px;
            height: 13px;
            border-radius: self.width / 2;
            background: root.faceplate.knob-style == "domed" ? (Features.flat ? Theme.knob-alu-flat : Theme.knob-alu)
                : root.faceplate.steel ? (Features.flat ? Theme.knob-steel-flat : Theme.knob-steel)
                : Theme.knob-black;
            border-width: root.faceplate.knob-style == "skirted" ? 2px : 1px;
            border-color: root.faceplate.knob-style == "skirted" && !root.faceplate.steel ? Theme.knob-skirt-light : #00000099;
            // Pointer: a dot on a dome, a line otherwise
            Rectangle {
                x: parent.width / 2 - 1px + (k == 0 ? -2px : 2px);
                y: 2px;
                width: 2px;
                height: root.faceplate.knob-style == "domed" ? 2px : 4px;
                background: root.faceplate.knob-style == "domed" ? Theme.knob-black : Theme.knob-line;
            }
        }
        PlateName {
            x: 2px;
            y: 22px;
            width: parent.width - 4px;
            height: 16px;
            text: root.faceplate.name;
            style: root.faceplate.plate-style;
            least-font-size: 10px;
            room: self.width;
            horizontal-alignment: center;
        }
        // Footswitch
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 18px;
            width: 13px;
            height: 13px;
            border-radius: self.width / 2;
            background: Features.flat ? Theme.knob-alu-flat : Theme.knob-alu;
            border-width: 1px;
            border-color: #00000099;
        }
        // Bypassed: the plate goes dark; pressed: lit
        if root.bypassed || root.pressed: Rectangle {
            background: root.bypassed ? #00000090 : #ffffff1c;
        }
        Rectangle {
            border-radius: root.radius;
            border-width: 1px;
            border-color: Theme.plate-edge;
        }
    }

    // Origin of the loaded tone (TONE3000 design requirements)
    // Top left, clear of the name; on a pedal its knob is there, so bottom left
    if root.t3k: T3kMark {
        x: 4px;
        y: root.kind == "pedal" ? parent.height - self.height - 4px : root.has-panel ? (root.panel-h - self.height) / 2 : 4px;
        height: 6px;
        opacity: root.bypassed ? 0.45 : 1.0;
    }

    // Status LED, with a halo when lit
    if !root.bypassed: Rectangle {
        x: led.x - 3px;
        y: led.y - 3px;
        width: led.width + 6px;
        height: led.height + 6px;
        border-radius: self.width / 2;
        background: (root.kind == "pedal" && !root.signature ? Theme.led-red : Theme.led-green).with-alpha(0.35);
    }
    led := Rectangle {
        x: root.signature ? (parent.width - self.width) / 2 : root.has-picture ? parent.width - 9px : root.kind == "pedal" ? (parent.width - self.width) / 2 : parent.width - 11px;
        y: root.signature ? 9px : root.has-picture ? 4px : root.kind == "pedal" ? 8px : root.has-panel ? 4px : 6px;
        width: root.signature ? 6px : 5px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.bypassed ? Theme.led-off : root.kind == "pedal" && !root.signature ? Theme.led-red : Theme.led-green;
    }
}
