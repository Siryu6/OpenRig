import { Theme } from "../theme.slint";
import { PlotHandle } from "../types.slint";

// Pieces of the views drawn above a block's parameters (EQ, level curve,
// scope). Rust draws them (src/plugin_view.rs) and reads the handles back:
// the UI only says where a plot is laid out and where a handle is dragged.

export global PlotEvents {
    callback resized(length, length);       // the wide plot of the view shown was laid out
    callback drag(string, float, float);    // handle, where to, 0..1 from the plot's bottom left
    callback released();                    // the handle dragged was let go
    callback double-tapped(string);         // handle
}

// Frequency axis, log scale from 20 Hz to 20 kHz (as plugin_view::freq)
export global FreqAxis {
    // 50, 100, 200, 500, 1k, 2k, 5k, 10k
    out property <[float]> lines: [0.1327, 0.2330, 0.3333, 0.4660, 0.5663, 0.6667, 0.7993, 0.8997];
    out property <[{ x: float, text: string }]> decades: [{ x: 0.2330, text: "100" }, { x: 0.5663, text: "1k" }, { x: 0.8997, text: "10k" }];
}

// A framed plot with a row grid. The `wide` one of a view says when it is
// laid out: paths across it are drawn for its proportions.
export component Plot inherits Rectangle {
    in property <bool> wide: false;
    in property <[float]> rows: [0.2, 0.4, 0.6, 0.8];
    clip: true;
    border-width: 1px;
    border-color: Theme.border;
    init => {
        root.laid-out();
    }
    changed width => {
        root.laid-out();
    }
    changed height => {
        root.laid-out();
    }
    function laid-out() {
        if root.wide {
            PlotEvents.resized(root.width, root.height);
        }
    }

    for f in root.rows: Rectangle {
        y: f * root.height;
        width: root.width;
        height: 1px;
        background: Theme.border;
    }
    @children
}

// Path commands drawn across the plot it is in
export component PlotPath inherits Path {
    // Not laid out yet: no height to divide by
    viewbox-width: 1000 * self.width / max(1px, self.height);
    viewbox-height: 1000;
}

// The sound in (grey) and out (`accent`), as areas
export component InOut inherits Rectangle {
    in property <string> input;
    in property <string> output;
    in property <color> accent;
    in property <float> input-alpha: 0.45;
    PlotPath {
        commands: root.input;
        fill: Theme.text-muted.with-alpha(root.input-alpha);
    }
    PlotPath {
        commands: root.output;
        fill: root.accent.with-alpha(0.38);
    }
}

// Lines at the frequency axis' steps, and its decades named inside
export component FreqGrid inherits Rectangle {
    in property <bool> labels: false;
    for x in FreqAxis.lines: Rectangle {
        x: x * root.width;
        width: 1px;
        height: root.height;
        background: Theme.border;
    }
    if root.labels: Rectangle {
        for d in FreqAxis.decades: Text {
            x: d.x * root.width + 4px;
            y: 4px;
            text: d.text;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
        }
    }
}

// Levels left of a plot `side` high at `top` (the scale is -60 to 0 dB, level_history::FLOOR)
export component DbLabels inherits Rectangle {
    in property <length> top;
    in property <length> side;
    for t in [{ f: 0.0, text: "0" }, { f: 0.4, text: "-24" }, { f: 0.8, text: "-48" }]: Text {
        x: 4px;
        y: root.top + t.f * root.side - (t.f == 0 ? 0px : 7px);
        width: 32px;
        text: t.text;
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
    }
}

// Text on an opaque backdrop, over what a plot draws
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text-muted;
    in property <length> font-size: Theme.font-caption;
    width: label.preferred-width + 12px;
    height: label.preferred-height + 4px;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    label := Text {
        x: 6px;
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
    }
}

// A fill's colour, and what it is
component Swatch inherits HorizontalLayout {
    in property <color> accent;
    in property <string> text;
    padding-left: 6px;
    spacing: 6px;
    Rectangle {
        width: 10px;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: Theme.radius-sm;
            background: root.accent;
        }
    }
    Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        vertical-alignment: center;
    }
}

// What a view shows ("Compressor · 4:1"), and what its fills are when
// `input` is given
export component Caption inherits Rectangle {
    in property <string> text;
    in property <string> input;
    in property <string> output;
    in property <color> accent;
    width: row.preferred-width + 12px;
    height: row.preferred-height + 4px;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    row := HorizontalLayout {
        x: 6px;
        // Not stretched to the backdrop (a layout fills its parent)
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 6px;
        Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        if root.input != "": Swatch {
            accent: Theme.text-muted;
            text: root.input;
        }
        if root.input != "": Swatch {
            accent: root.accent;
            text: root.output;
        }
    }
}

// A handle over a plot (`plot-x`… its box): a dot the finger drags, with
// more room around it than the dot to catch the finger
// Not in a `for` over values that change as it moves (a new handle would be
// made, dropping the finger): one element each, or a model updated in place
export component Handle inherits Rectangle {
    in property <PlotHandle> handle;
    in property <color> accent;
    in property <length> plot-x;
    in property <length> plot-y;
    in property <length> plot-width;
    in property <length> plot-height;
    private property <length> hit: 48px;
    private property <length> size: 26px;
    x: root.plot-x + root.handle.x * root.plot-width - self.hit / 2;
    y: root.plot-y + (1 - root.handle.y) * root.plot-height - self.hit / 2;
    width: self.hit;
    height: self.hit;
    visible: root.handle.shown;

    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: root.handle.on ? (touch.pressed ? root.accent : root.accent.with-alpha(0.85)) : Theme.surface;
        border-width: 2px;
        border-color: root.handle.on ? root.accent : Theme.text-muted;
        Text {
            text: root.handle.label;
            color: root.handle.on ? Theme.surface : Theme.text-muted;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.handle.shown;
        moved => {
            if !self.pressed {
                return;
            }
            let fx = (root.x - root.plot-x + self.mouse-x) / root.plot-width;
            let fy = 1 - (root.y - root.plot-y + self.mouse-y) / root.plot-height;
            PlotEvents.drag(root.handle.name, max(0, min(1, fx)), max(0, min(1, fy)));
        }
        changed pressed => {
            if !self.pressed {
                PlotEvents.released();
            }
        }
        double-clicked => {
            PlotEvents.double-tapped(root.handle.name);
        }
    }
}
