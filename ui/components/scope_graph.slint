import { PlotColors, Theme } from "../theme.slint";
import { Features } from "../features.slint";
import { Spectrum, ScopeView, ScopeLive } from "../types.slint";
import { BlockHandle, BlockPlot, Caption, DbLabels, FreqGrid, InOut, Plot, PlotPath, Tag } from "plot.slint";

// What a delay, reverb, drive, modulation or cabinet block does to the sound:
// a delay's echoes across, which drag (time, feedback), a drive's response
// at its settings, and measured on what goes through, in (grey) and out
// (block colour): its level over the last seconds or its spectrum.
export component ScopeGraph inherits Rectangle {
    in property <ScopeView> scope;
    in property <ScopeLive> live;
    in property <Spectrum> spectrum;
    in property <PlotColors> colors: Theme.plot;
    in property <color> accent: root.colors.accent;
    in property <bool> bypassed: false;

    private property <color> line: !root.bypassed ? root.accent : root.colors.muted;
    private property <bool> has-left: root.scope.left != "";
    private property <length> side: root.height - 34px;

    border-radius: Theme.radius-lg;
    background: root.colors.surface;
    border-width: 1px;
    border-color: root.colors.grid;

    // For the history, left of it
    if root.scope.left == "history" || (!root.has-left && root.scope.right == "history"): DbLabels {
        top: 12px;
        side: root.side;
        colors: root.colors;
    }

    square := Plot {
        x: 40px;
        y: 12px;
        width: root.has-left ? root.side : 0;
        height: root.side;
        visible: root.has-left;
        colors: root.colors;

        if root.scope.left == "history": InOut {
            input: root.live.history-in;
            output: root.live.history-out;
            accent: root.line;
            colors: root.colors;
        }
    }

    wide := BlockPlot {
        x: root.has-left ? square.x + square.width + 12px : 40px;
        y: 12px;
        width: root.width - self.x - 12px;
        height: root.side;
        colors: root.colors;

        if root.scope.right == "spectrum": Rectangle {
            FreqGrid {
                labels: true;
                colors: root.colors;
            }
            InOut {
                input: root.spectrum.input;
                output: root.spectrum.output;
                accent: root.line;
                colors: root.colors;
            }
            PlotPath {
                commands: root.scope.response;
                stroke: root.line;
                stroke-width: 2px;
            }
        }
        if root.scope.right == "history": InOut {
            input: root.live.history-in;
            output: root.live.history-out;
            accent: root.line;
            colors: root.colors;
        }
        if root.scope.right == "echoes": Rectangle {
            // The tempo's beats, bars stronger
            for beat in root.scope.echo-beats: Rectangle {
                x: beat.x * wide.width;
                width: 1px;
                background: beat.bar ? root.colors.grid-strong : root.colors.grid;
            }
            // Each echo's tail, fading until the next one
            // Ping-pong: the left lane above, the right one below
            if root.scope.echo-lanes: Rectangle {
                y: wide.height / 2;
                height: 1px;
                background: root.colors.grid-strong;
            }
            for lane[k] in (root.scope.echo-lanes ? ["L", "R"] : []): Tag {
                x: 4px;
                y: k * wide.height / 2 + 6px;
                text: lane;
                colors: root.colors;
            }
            for tap[i] in root.scope.echo-taps: Rectangle {
                visible: i > 0;
                x: tap.x * wide.width;
                y: (1 - tap.base - tap.height) * wide.height;
                width: (i + 1 < root.scope.echo-taps.length ? root.scope.echo-taps[i + 1].x * wide.width : wide.width)
                    - self.x;
                height: tap.height * wide.height;
                background: Features.flat ? root.line.with-alpha(0.14)
                    : @linear-gradient(90deg, root.line.with-alpha(0.32) 0%, root.line.with-alpha(0) 100%);
            }
            // The dry sound first, grey
            for tap[i] in root.scope.echo-taps: Rectangle {
                x: tap.x * wide.width - 2px;
                y: (1 - tap.base - tap.height) * wide.height;
                width: 4px;
                height: tap.height * wide.height;
                background: i == 0 ? root.colors.muted : root.line;
            }
            if root.scope.echo-span != "": Tag {
                x: wide.width - self.width - 6px;
                y: wide.height - self.height - 6px;
                text: root.scope.echo-span;
                colors: root.colors;
            }
        }
        // The kind, and what the fills are (top right over the echoes,
        // which fade to the right)
        Caption {
            x: root.scope.right == "echoes" ? wide.width - self.width - 6px : 6px;
            y: root.scope.right == "echoes" ? 6px : wide.height - self.height - 6px;
            text: root.scope.kind + (root.scope.summary == "" ? "" : "  ·  " + root.scope.summary);
            input: root.scope.right == "" ? "" : root.scope.right == "echoes" ? "dry" : "in";
            output: root.scope.right == "echoes" ? "echoes" : "out";
            accent: root.line;
            colors: root.colors;
        }
    }

    // A delay's first echo (time, across) and second (feedback, up and down)
    BlockHandle {
        handle: root.scope.echo-feedback;
        accent: root.line;
        colors: root.colors;
        plot-x: wide.x;
        plot-y: wide.y;
        plot-width: wide.width;
        plot-height: wide.height;
    }
    BlockHandle {
        handle: root.scope.echo-time;
        accent: root.line;
        colors: root.colors;
        plot-x: wide.x;
        plot-y: wide.y;
        plot-width: wide.width;
        plot-height: wide.height;
    }
}
