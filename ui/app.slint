import { Theme } from "theme.slint";
import {
    PositionedNode, Connector, ParameterInfo, PluginItem, PresetInfo, SceneInfo, SceneSlotInfo, MenuItem, LooperState, SavedLoopInfo, ResourceStatus,
    T3kTone, T3kModel, ModelChoice, DropSlotView, ColorChoice, WifiNetwork, Levels, LiveTile, RoutingOutput, RoutingBlock, CatalogItem, CatalogFamily, EqView, PlotHandle, Spectrum, DynView, DynLive, ScopeView, ScopeLive, EchoTap, FileSlot, SystemSetting, NetMidiDevice
} from "types.slint";
// Pages
import { PluginRack } from "pages/rack.slint";
import { ChoiceSearch, PluginEditor } from "pages/plugin_editor.slint";
import { PluginBrowser } from "pages/plugin_browser.slint";
import { TunerView } from "pages/tuner_view.slint";
import { PresetManager } from "pages/preset_manager.slint";
import { Rigs, RigFileInfo, RigItem, RigsOnline } from "pages/rigs_view.slint";
import { OnlineRig, OnlineDep } from "pages/rigs_online.slint";
import { SceneManager } from "pages/scene_manager.slint";
import { LooperView } from "pages/looper_view.slint";
import { LiveView } from "pages/live_view.slint";
import { CatalogView } from "pages/catalog_view.slint";
import { SettingsView } from "pages/settings_view.slint";
import { Backup, BackupFile, BackupPart } from "pages/backup_view.slint";
import { Tone3000View } from "pages/tone3000_view.slint";
import { OutputMaster, RoutingView } from "pages/routing_view.slint";
import { HardwareView } from "pages/hardware_view.slint";
import { Features } from "features.slint";
import { RemoteControl } from "remote.slint";
import { Encoder } from "encoder.slint";
import { TextEdit, TextEditing } from "components/virtual_keyboard.slint";
// Components
import { TopBar } from "components/top_bar.slint";
import { ContextMenuOverlay } from "components/context_menu.slint";
import { Button, Icon } from "components/controls.slint";
import { ResourcePanel } from "components/resource_panel.slint";
import { PowerDialog } from "components/power_dialog.slint";
import { UpdateDialog } from "components/update_dialog.slint";
import { NetMidiPrompt } from "components/netmidi_prompt.slint";
import { PlotEvents } from "components/plot.slint";

// Re-export the data types used by the Rust side
export { Backup, BackupFile, BackupPart, ChoiceSearch, Encoder, Features, RemoteControl, PlotEvents, OutputMaster, Rigs, RigFileInfo, RigItem, RigsOnline, OnlineRig, OnlineDep, TextEdit, TextEditing, Theme }
export { PositionedNode, Connector, ParameterInfo, PluginItem, PresetInfo, SceneInfo, SceneSlotInfo, MenuItem, LooperState, SavedLoopInfo, ResourceStatus, T3kTone, T3kModel, ModelChoice, DropSlotView, ColorChoice, CatalogItem, CatalogFamily, EqView, PlotHandle, Spectrum, DynView, DynLive, ScopeView, ScopeLive, EchoTap, FileSlot, SystemSetting }

// A control the encoder stops on: its name, its row in a list
struct EncoderStop {
    what: string,
    index: int,
}

export component App inherits Window {
    title: "OpenRig";
    background: Theme.background;
    default-font-size: Theme.font-body;

    // 7" touchscreen (800x480); fullscreen on the actual hardware
    preferred-width: 800px;
    preferred-height: 480px;
    min-width: 800px;
    min-height: 480px;

    // ---------------------------------------------------------------- state
    // 0 = rack, 1 = editor, 2 = browser, 3 = tuner, 4 = presets, 5 = looper, 6 = setlists,
    // 7 = settings, 8 = TONE3000 library, 9 = live, 10 = routing, 11 = store,
    // 12 = hardware (from the settings)
    // (Rust: TUNER_VIEW and LIVE_VIEW in main.rs)
    in-out property <int> current-view: 0;
    in-out property <int> selected-plugin: 0;       // index into positioned-nodes
    private property <string> selected-split-type: root.selected-plugin >= 0 && root.selected-plugin < root.positioned-nodes.length
        ? root.positioned-nodes[root.selected-plugin].split-type : "";
    private property <int> focused-parameter: 0;
    // The editor's Remove button waits for a second press
    private property <bool> remove-armed: false;
    // Encoder (Left/Right: turn, Return: press, Escape: long press). In the
    // editor the focus goes through the parameters, then On/Off and Remove
    // (and Arrange first, when there is something to arrange)
    private property <int> arrange-slot: root.selected-parameters.length > 1 ? root.selected-parameters.length : -1;
    private property <int> reset-slot: root.arranging ? root.selected-parameters.length + 1 : -1;
    private property <int> bypass-slot: root.selected-parameters.length + (root.arrange-slot >= 0 ? 1 : 0)
        + (root.arranging ? 1 : 0);
    // Arranging the parameters; the encoder stops twice on each: move, strip
    private property <bool> arranging: false;
    private property <int> arrange-stop: 0;
    in-out property <int> selected-strip-count: 0;
    private property <int> remove-slot: root.bypass-slot + 1;
    // The focused parameter follows the encoder; its value before, for a
    // long press
    private property <bool> adjusting: false;
    private property <float> adjust-from: 0;
    // Page switcher, opened by a long press on a main page
    private property <bool> pages-open: false;
    private property <int> pages-index: 0;
    private property <[int]> page-views: [0, 4, 9, 3, 5, 7];
    // The encoder's focus is only highlighted while the encoder is in use
    // (Encoder.active): from its first turn or press, until it rests a
    // while. On the pages where the focus is otherwise hidden, that first
    // turn or press only shows it
    private property <bool> focus-hidden: !Encoder.active && (root.page-slots > 0 || root.current-view == 1);
    function encoder-used() {
        Encoder.active = true;
        encoder-rest.restart();
    }
    encoder-rest := Timer {
        interval: 20s;
        running: Encoder.active && !root.adjusting && !root.arranging && !root.pages-open;
        triggered => {
            Encoder.active = false;
        }
    }
    // Focus on the presets, Live, looper and tuner pages
    private property <int> page-focus: 0;
    private property <int> page-slots: root.current-view == 4 ? root.presets.length
        : root.current-view == 9 ? root.live-tiles.length + 3
        : root.current-view == 5 ? 17
        : root.current-view == 3 ? 2
        : root.current-view == 7 ? root.hardware-start + 1
        : root.current-view == 12 ? root.hw-i2c-start + (Features.gpio ? 1 : 0) + (Features.gpio && root.hardware-i2c ? 3 : 0) : 0;
    // Settings → Audio & system: the list open (row, -1 none) and the
    // choice the encoder is on
    private property <int> system-picker: -1;
    private property <int> system-picker-index: 0;
    // Settings: the encoder stops on every control, card by card from the
    // top; where each card's stops start
    private property <bool> wifi-open-shown: root.wifi-status == "on" && root.wifi-open-index >= 0
        && root.wifi-open-index < root.wifi-networks.length && root.wifi-networks[root.wifi-open-index].ssid == root.wifi-open-ssid;
    private property <int> wifi-lead: root.wifi-status == "on" ? 2 : root.wifi-status == "off" ? 1 : 0;
    private property <int> system-start: root.wifi-lead + (root.wifi-status == "on" ? root.wifi-networks.length : 0)
        + (root.wifi-open-shown ? 2 : 0);
    private property <int> display-start: root.system-start
        + (root.system-available ? root.system-settings.length + (root.system-changed ? 2 : 0) : 0);
    private property <int> midi-start: root.display-start + 1;
    private property <int> netmidi-start: root.midi-start + (root.midi-available ? 2 : 0);
    private property <int> netmidi-session-start: root.netmidi-start + 3;
    private property <int> netmidi-device-start: root.netmidi-session-start
        + (root.netmidi-enabled ? root.netmidi-session-stops.length : 0);
    private property <int> remote-start: root.netmidi-available ? root.netmidi-device-start + root.netmidi-devices.length
        : root.netmidi-start;
    private property <int> remote-lead: RemoteControl.headless ? 0 : 1;
    private property <int> t3k-start: root.remote-start + (!RemoteControl.available ? 0
        : root.remote-lead + (RemoteControl.enabled ? (RemoteControl.hotspot != "" ? 3 : 0) + 2 : 0));
    private property <int> dsp-start: root.t3k-start + (!root.t3k-available ? 0
        : root.t3k-status == "signed-out" || root.t3k-status == "starting" ? 2
        : root.t3k-status == "waiting" ? 1
        : root.t3k-status == "connected" ? (root.t3k-confirm-disconnect ? 2 : 1) : 0);
    private property <int> hardware-start: root.dsp-start + (root.dsp-max-cores > 1 ? 1 : 0);
    // The control the encoder is on
    private property <EncoderStop> settings-stop: root.settings-stop-at(root.page-focus);
    // Settings: shared by the touch and the encoder, the Wi-Fi network
    // showing its actions, the keyboards open with their text, and the
    // TONE3000 disconnection to confirm
    private property <string> wifi-open-ssid: "";
    private property <int> wifi-open-index: -1;
    private property <string> wifi-password-ssid: "";
    private property <bool> netmidi-renaming: false;
    private property <string> netmidi-draft: "";
    private property <bool> t3k-editing-key: false;
    private property <string> t3k-key-draft: "";
    private property <bool> t3k-confirm-disconnect: false;
    // A keyboard of the Settings is open: its text field has the focus
    private property <bool> settings-typing: root.wifi-password-ssid != "" || root.netmidi-renaming
        || root.t3k-editing-key || RemoteControl.editing;
    // Settings → Hardware: where the stops after the footswitches start.
    // The rotary encoder's own settings (on/off, pins, push button, steps)
    // are left to the touch: changed with the encoder, they would cut it
    // off
    private property <int> hw-tap-start: 1 + (Features.gpio ? root.hardware-footswitch-pins.length : 0);
    private property <int> hw-i2c-start: root.hw-tap-start + (root.footswitch-count >= 2 ? 1 : 0);
    private property <EncoderStop> hardware-stop: root.hardware-stop-at(root.page-focus);
    private property <int> browser-selected-index: 0;

    // Split chain insertion mode: 0 = main, 1 = top branch, 2 = bottom branch
    private property <int> split-insertion-mode: 0;
    private property <int> target-split-index: -1;   // split instance-id

    // Tuner
    in-out property <float> tuner-frequency: 0;
    in-out property <string> tuner-note: "A";
    in-out property <int> tuner-octave: 4;
    in-out property <float> tuner-cents: 0.0;
    in-out property <bool> tuner-is-tuned: false;
    in-out property <bool> tuner-mute-enabled: false;
    in-out property <float> tuner-reference-pitch: 440.0;

    // Looper
    in-out property <LooperState> looper-state: LooperState.Stopped;
    in-out property <float> looper-length: 0.0;
    in-out property <float> looper-position: 0.0;
    in-out property <int> looper-layers: 0;
    in-out property <float> looper-level: 1.0;
    // Bar and beat at the playhead (bar 0: counting in; beat 0: off the
    // grid), beats in its bar, bars in the loop (0: not whole bars), and the
    // recording going on to the end of the bar
    in-out property <int> looper-bar: 0;
    in-out property <int> looper-beat: 0;
    in-out property <int> looper-beats: 4;
    in-out property <int> looper-bars: 0;
    in-out property <bool> looper-ending: false;
    // Half speed, room to double the loop, its waveform (peaks 0..1 from
    // its start to its end)
    in-out property <bool> looper-half-speed: false;
    in-out property <bool> looper-can-double: false;
    in-out property <[float]> looper-wave: [];
    // Saved loops, the list shown and the name offered when saving
    in-out property <bool> looper-show-loops: false;
    in-out property <[SavedLoopInfo]> looper-saved: [];
    in-out property <string> looper-default-name: "";
    // Settings: bar, count-in, bar quantization, click, click level
    in-out property <int> looper-beats-per-bar: 4;
    in-out property <bool> looper-count-in: false;
    in-out property <bool> looper-quantize: false;
    in-out property <bool> looper-click: false;
    in-out property <float> looper-click-level: 0.5;

    // Plugins / chain
    in-out property <[PluginItem]> available-plugins: [];
    in-out property <[PositionedNode]> positioned-nodes: [];
    in-out property <[Connector]> connectors: [];
    in-out property <[DropSlotView]> drop-slots: [];
    // Block colours: the palette, and the colour of the selected block
    in-out property <[ColorChoice]> block-colors: [];
    in-out property <string> selected-color: "";
    in-out property <color> selected-color-value;
    in-out property <color> selected-auto-color;   // colour of its family
    in-out property <float> chain-width: 0.0;
    in-out property <float> chain-top: 0.0;
    in-out property <float> chain-bottom: 0.0;

    // Selected node (filled by Rust on select-node)
    in-out property <int> selected-instance-id: -1;
    in-out property <string> selected-plugin-name: "";
    in-out property <string> selected-plugin-category: "";
    in-out property <bool> selected-plugin-bypassed: false;
    in-out property <[ParameterInfo]> selected-parameters: [];
    in property <EqView> selected-eq;
    in property <[PlotHandle]> selected-eq-points;
    in property <DynView> selected-dyn;
    in property <DynLive> selected-dyn-live;
    in property <ScopeView> selected-scope;
    in property <ScopeLive> selected-scope-live;
    in property <Spectrum> selected-spectrum;
    in-out property <bool> selected-uses-file: false;  // block loads a model (NAM)
    in-out property <string> selected-file: "";
    in-out property <string> selected-file-label: "Model";   // "Model", "Impulse response"
    in-out property <string> selected-file-types: "";        // ".nam, .json"
    in-out property <string> selected-file-title: "";  // tone of the current file
    in-out property <string> selected-file-subtitle: "";
    in-out property <bool> selected-file-t3k: false;   // a TONE3000 download
    in-out property <image> selected-file-image;       // its picture, saved with it
    in-out property <[ModelChoice]> selected-presets: [];
    in-out property <[FileSlot]> selected-file-slots: [];  // files of an LV2 plugin
    in-out property <[ModelChoice]> selected-factory-presets: [];  // presets of its bundle
    in-out property <string> selected-preset-name: "";
    // The knob strip's list fields: factory presets, and the model's
    // ("Choose another…", then the loaded tone's presets)
    in-out property <[string]> selected-strip-factory: [];
    in-out property <[string]> selected-strip-models: [];
    in-out property <int> selected-strip-model-current: -1;
    // The block editor opens on its model picker
    in-out property <bool> editor-model-picker: false;
    in-out property <[ModelChoice]> available-packs: [];
    in-out property <bool> available-packs-pictures: false;  // TONE3000 tones among them
    in-out property <string> models-dir: "";

    // Presets / scenes
    in-out property <[PresetInfo]> presets: [];
    in-out property <string> current-preset-name: "Default";
    in-out property <string> current-preset-id: "";  // empty: unsaved
    in-out property <[SceneInfo]> scenes: [];
    in-out property <[SceneSlotInfo]> scene-slots: [];
    in-out property <string> current-scene-name: "No setlist";  // setlist

    // Live: footswitches, scenes of the preset, tempo
    in-out property <string> live-mode: "stomp";
    in-out property <[LiveTile]> live-tiles: [];
    in-out property <string> live-scene-name: "Scene 1";
    in-out property <int> live-scene-index: 0;
    in-out property <float> tempo: 120;
    in-out property <string> tap-switch-label: "";
    in-out property <[MenuItem]> stomp-choices: [];
    in-out property <int> footswitch-count: 4;  // physical switches
    in-out property <bool> tap-switch: true;    // the last one taps the tempo
    in-out property <int> footswitch-down-mask: 0;  // bit n: switch n held
    // Settings → Hardware: GPIOs of the switches and encoder (-1: no button)
    in-out property <[int]> hardware-footswitch-pins: [];
    in-out property <bool> hardware-encoder: false;
    in-out property <int> hardware-encoder-a: 5;
    in-out property <int> hardware-encoder-b: 6;
    in-out property <int> hardware-encoder-button: 13;
    in-out property <int> hardware-encoder-steps: 4;
    in-out property <bool> hardware-i2c: false;
    in-out property <string> hardware-i2c-module: "";
    in-out property <int> hardware-i2c-steps: 1;
    in-out property <bool> hardware-i2c-reverse: false;
    in-out property <string> hardware-i2c-found: "";
    in-out property <string> hardware-message: "";  // error
    // MIDI
    in property <bool> midi-available: false;    // built with MIDI and the system allows it
    in property <string> midi-devices: "";       // devices listened to
    in property <int> midi-channel: 0;           // 0 = omni, 1–16
    in property <bool> midi-clock: true;         // follow an incoming clock
    in property <bool> midi-activity: false;     // LED: a message just came in
    in property <bool> tempo-clock: false;       // the tempo comes from a MIDI clock
    in-out property <bool> midi-learning: false; // block editor: learning a controller
    in property <int> midi-learn-target: -2;     // -2 none, -1 on/off, n parameter n
    in property <int> midi-learn-cc: -1;         // controller moved first
    in property <string> midi-learn-message: "";
    in property <bool> midi-learn-assigned: false; // the touched control has a controller
    in property <int> midi-learn-heel: 0;        // its range, percent: at CC 0…
    in property <int> midi-learn-toe: 100;       // …and at CC 127
    in property <float> selected-cpu: -1;         // share of a core the block uses, -1 unknown
    in property <string> selected-bypass-midi: ""; // "CC n" driving the block's on/off

    // Context menu
    private property <bool> show-context-menu: false;
    private property <[MenuItem]> context-menu-items: [];
    private property <length> context-menu-x: 0px;
    private property <length> context-menu-y: 0px;

    // Audio
    in-out property <bool> stereo-mode: false;
    in-out property <bool> audio-running: false;
    in-out property <Levels> levels;
    in-out property <bool> demo-plugins: false;    // no real LV2 plugins found
    // Resource monitor
    in-out property <ResourceStatus> resources: {
        dsp-load: -1, dsp-peak: -1, jack-load: -1, cpu: -1, cpu-max-core: -1,
        temperature: -1, latency-ms: -1,
    };
    private property <bool> show-resources: false;
    // A dialog over the page (the page switcher aside): the encoder's turns
    // and presses do not reach the page under it, a long press closes it
    private property <bool> dialog-open: root.show-context-menu || root.show-resources || root.power-dialog
        || root.update-dialog || root.netmidi-prompt-address != "";

    // Wi-Fi (Settings)
    in-out property <string> wifi-status: "unsupported"; // "unsupported" | "no-device" | "off" | "on"
    in-out property <[WifiNetwork]> wifi-networks: [];
    in-out property <bool> wifi-scanning: false;
    in-out property <string> wifi-busy-ssid: "";
    in-out property <string> wifi-message: "";
    in-out property <string> wifi-addresses: "";    // "192.168.1.42 (Wi-Fi) · …", "" offline

    // TONE3000 Connect (Settings); Features.tone3000 is set once connected
    in-out property <bool> t3k-available: false;
    in-out property <string> t3k-status: "signed-out";
    in-out property <string> t3k-client-id: "";
    in-out property <string> t3k-username: "";
    in-out property <image> t3k-avatar;                // signed-in account, once loaded
    in-out property <string> t3k-avatar-key: "";
    in-out property <string> t3k-user-code: "";
    in-out property <string> t3k-url: "";
    in-out property <image> t3k-qr;
    in-out property <string> t3k-error: "";

    // Updates (⋮ → Updates, see UpdateDialog). update-current is set
    // without the update feature too: the About dialog shows it
    in-out property <string> update-status: "idle";
    in-out property <string> update-current: "";
    in-out property <string> update-version: "";
    in-out property <string> update-kind: "";
    in-out property <string> update-size: "";
    in-out property <float> update-progress: 0;
    in-out property <string> update-message: "";
    in-out property <bool> update-dialog: false;
    // Dot on ⋮ and on its Updates item: an update to install, or installed
    // and waiting for a restart
    private property <bool> update-pending: Features.update
        && (root.update-status == "ready" || root.update-status == "installed");

    // Routing (view 10, opened from ⋮; back goes where it was opened)
    private property <int> routing-return-view: 0;
    in-out property <bool> routing-available: false;
    in-out property <string> routing-summary: "";
    in-out property <int> routing-inputs: 1;
    in-out property <int> routing-input: 0;
    in-out property <[RoutingOutput]> routing-outputs: [];
    in-out property <[float]> routing-input-levels: [];
    in-out property <[float]> routing-output-levels: [];
    in-out property <[RoutingBlock]> routing-blocks: [];

    // TONE3000 library (view 8)
    in-out property <int> t3k-tab: 0;
    in-out property <string> t3k-gear: "";
    in-out property <[T3kTone]> t3k-tones: [];
    in-out property <bool> t3k-loading: false;
    in-out property <string> t3k-list-error: "";
    in-out property <bool> t3k-has-more: false;
    in-out property <bool> t3k-detail-open: false;
    in-out property <T3kTone> t3k-detail;
    in-out property <string> t3k-detail-url: "";
    in-out property <[T3kModel]> t3k-models: [];
    in-out property <bool> t3k-models-loading: false;
    in-out property <string> t3k-query: "";           // search shown in tab 5
    in-out property <int> t3k-selected-count: 0;      // models ticked for download
    in-out property <int> t3k-model-page: 0;          // page of the tone's models shown
    in-out property <int> t3k-model-pages: 0;
    in-out property <bool> t3k-page-selectable: false; // the page has models to tick
    in-out property <bool> t3k-page-selected: false;   // ...all ticked already
    in-out property <string> t3k-download-status: ""; // "" when no download runs
    in-out property <int> t3k-target-id: -1;         // block to load models in (-1 = none)
    in-out property <string> t3k-target-name: "";
    in-out property <[string]> t3k-gear-ids: [];
    in-out property <[string]> t3k-gear-names: [];
    private property <int> t3k-return-view: 0;
    // Setlists page: 0 = list, 1 = footswitch slots
    private property <int> setlist-view-mode: 0;

    // Plugin store
    in property <[CatalogItem]> catalog-items: [];
    in property <[CatalogFamily]> catalog-families: [];
    in property <string> catalog-query: "";
    in property <string> catalog-family: "All";
    in property <int> catalog-total: 0;
    in property <string> catalog-status: "";
    in property <bool> catalog-busy: false;
    private property <int> catalog-open: -1;

    // Transient toast text set by Rust; empty = hidden
    in-out property <string> status-message: "";
    // Label of the toast's action button (e.g. "Undo"); empty = none
    in-out property <string> status-action: "";
    callback status-action-clicked();

    // ------------------------------------------------------------ callbacks
    callback add-plugin-to-chain(string);
    callback catalog-search(string);
    callback catalog-pick-family(string);
    callback catalog-install(string);
    callback catalog-remove(string);
    callback catalog-refresh();
    callback catalog-opened();                        // the Store page is shown
    pure callback catalog-uri(string) -> string;     // entry id: the plugin to add to the chain
    callback remove-node-by-id(int);                 // instance-id
    callback drag-started(int);                      // instance-id
    callback node-dropped(int, float, float);        // instance-id, layout x, y
    callback set-color(int, string);                 // instance-id, colour name ("" = default)
    callback select-node(int);                       // instance-id
    callback set-parameter(int, int, float);         // instance-id, param index, value
    callback arrange-parameter(int, int, int);       // instance-id, param index, places
    callback toggle-parameter-strip(int, int);       // instance-id, param index
    callback reset-parameter-layout(int);            // instance-id
    callback toggle-node-bypass(int);                // instance-id
    callback refresh-models();
    callback set-model(int, string);                 // instance-id, file ("" = none)
    callback refresh-slot-files(string);             // files a FileSlot can load, into available-packs
    callback set-param-file(int, string, string);    // instance-id, parameter, file ("" = none)
    callback apply-factory-preset(int, int);         // instance-id, position of the preset

    callback add-split(string);                      // "ab", "mix" or "lr"
    callback add-plugin-to-split-top(int, string);   // split instance-id, plugin uri
    callback add-plugin-to-split-bottom(int, string);// split instance-id, plugin uri
    callback toggle-split-ab(int);                   // split instance-id
    callback set-split-mix-ratio(int, float);        // split instance-id, ratio
    callback set-split-type(int, string);            // split instance-id, "ab", "mix" or "lr"
    callback set-split-pan(int, float, float);       // split instance-id, pan A, pan B

    callback load-preset(string);
    callback save-preset(string);   // as a new preset
    callback update-preset();       // over the current one
    callback delete-preset(string);
    callback create-scene(string);
    callback load-scene(string);
    callback delete-scene(string);
    callback scene-slot-assign(int, string);
    callback scene-slot-clear(int);
    callback footswitch-pressed(int);
    // Physical footswitches (GPIO, or keys 1-8 on a computer)
    callback footswitch-down(int);
    callback footswitch-up(int);
    callback live-mode-changed(string);
    callback live-tile-pressed(int);
    callback tap-tempo();
    callback set-tempo(float);
    callback rename-scene(int, string);
    callback assign-stomp(int, string);
    callback tap-switch-changed(bool);
    // what: "footswitches" | "footswitch" (index) | "encoder-a" | "encoder-b"
    // | "encoder-button" | "encoder-steps"; delta: +1 / -1
    callback hardware-step(string, int, int);
    callback hardware-set-i2c(bool);
    // External encoders on the rack's knob strip: encoder, action (0 turn,
    // 1 press, 2 long press), detents
    callback strip-encoder(int, int, int);
    in-out property <int> strip-page: 0;
    in-out property <int> strip-list-row: -1;
    in-out property <int> strip-list-focus: -1;
    callback hardware-set-encoder(bool);
    callback hardware-set-encoder-button(bool);
    callback midi-channel-changed(int);
    callback midi-clock-changed(bool);
    callback light-theme-changed(bool);
    // Network MIDI (Settings → MIDI; on the pedalboard OS)
    in property <bool> netmidi-available: false;
    in property <bool> netmidi-enabled: false;
    in property <bool> netmidi-busy: false;
    in property <string> netmidi-name: "";
    in property <string> netmidi-hostname: "";
    in property <string> netmidi-summary: "";
    in property <[NetMidiDevice]> netmidi-sessions: [];
    in property <[NetMidiDevice]> netmidi-devices: [];
    in property <bool> netmidi-allow-all: false;
    in property <string> netmidi-message: "";
    // The session of each encoder stop on the connected ones: two for a
    // waiting one (Allow, Block), one for an allowed one (Block)
    in property <[int]> netmidi-session-stops: [];
    // A new device asks to play the pedal (address "": none)
    in property <string> netmidi-prompt-name: "";
    in property <string> netmidi-prompt-address: "";
    callback netmidi-set-enabled(bool);
    callback netmidi-rename(string);
    callback netmidi-set-allow-all(bool);
    callback netmidi-allow(string, string);
    callback netmidi-block(string, string);
    callback netmidi-forget(string, string);
    callback netmidi-later();
    in-out property <int> dsp-cores: 0;
    in property <int> dsp-max-cores: 1;
    callback dsp-cores-changed(int);
    in property <bool> system-available: false;
    in property <[SystemSetting]> system-settings: [];
    in property <string> system-summary: "";
    in property <bool> system-changed: false;
    in property <bool> system-busy: false;
    in property <string> system-message: "";
    callback system-step(string, int);
    callback system-pick(string, int);              // key, index in its choices
    callback system-apply();
    callback system-revert();
    callback midi-learn-toggled(bool);
    callback midi-learn-touch(int);             // target touched while learning
    callback midi-learn-clear(int);             // forget the controller of a target
    callback midi-learn-range(int, int);        // heel, toe of the shown target

    // Learning only happens in the block editor

    callback looper-record();
    callback looper-play();
    callback looper-stop();
    callback looper-overdub();
    callback looper-undo();
    callback looper-clear();
    callback looper-level-changed(float);
    callback looper-settings-changed(int, bool, bool, bool, float);
    callback looper-multiply();
    callback looper-half-speed-changed(bool);
    callback looper-loops-opened();
    callback looper-save(string);     // name ("": the date and time)
    callback looper-load(string);     // id
    callback looper-delete(string);   // id

    callback set-stereo-mode(bool);
    callback wifi-refresh(bool);                     // rescan
    callback wifi-set-enabled(bool);
    callback wifi-connect(string, string);           // ssid, password ("" = saved / open)
    callback wifi-disconnect();
    callback wifi-forget(string);
    callback update-check();
    callback update-install();
    callback update-restart();
    callback t3k-connect(string);                    // publishable key
    callback t3k-cancel();
    callback t3k-disconnect();
    callback t3k-open(int);                          // target block (-1 = none)
    callback t3k-load(int, string, bool);            // tab, gear, next page
    callback t3k-open-tone(int);                     // index in t3k-tones
    callback t3k-toggle-model(int);                  // index in t3k-models
    callback t3k-select-page();                      // tick (or untick) the page's models
    callback t3k-model-page-changed(int);
    callback t3k-download-selected();
    callback t3k-cancel-downloads();
    callback t3k-search(string);                     // "" back to the lists
    callback t3k-add-model(string, string);          // block URI, relative path
    callback tuner-mute-toggled(bool);
    callback tuner-reference-pitch-changed(float);
    callback routing-step-input(int);
    callback routing-step-source(int, int);          // first output, delta
    callback routing-set-linked(int, bool);
    callback routing-set-gain(int, float);           // first output, dB
    callback routing-set-pan(int, float);
    callback routing-set-fold(int, int);             // 0 = L+R, 1 = L, 2 = R
    callback routing-toggle(int, string);            // "mute" | "solo" | "invert"
    callback power(string);                          // "poweroff" | "reboot" | "restart" (the app)
    callback quit-app();                             // without the OS image: save the session and quit
    // Items of ⋮ (Rust: menu_ui): tone3000, update, power, update pending
    pure callback main-menu(bool, bool, bool, bool) -> [MenuItem];
    in-out property <bool> power-dialog: false;
    private property <string> power-action: "";       // set once chosen

    // -------------------------------------------------------------- helpers

    // The encoder is on the rack's add button, past the last block
    private property <bool> add-focused: false;
    changed selected-plugin => {
        root.add-focused = false;
    }

    // Select a node of the rack (its parameters are loaded for the quick controls)
    function select-node-at(idx: int) {
        if (idx < 0 || idx >= root.positioned-nodes.length) {
            return;
        }
        root.selected-plugin = idx;
        root.selected-instance-id = root.positioned-nodes[idx].instance-id;
        // Fallback display values; Rust overwrites them in select-node
        root.selected-plugin-name = root.positioned-nodes[idx].name;
        root.selected-plugin-category = "";
        root.selected-plugin-bypassed = root.positioned-nodes[idx].bypassed;
        root.selected-parameters = [];
        root.selected-uses-file = false;
        root.selected-file = "";
        root.selected-presets = [];
        root.selected-file-slots = [];
        root.selected-factory-presets = [];
        root.selected-strip-factory = [];
        root.selected-strip-models = [];
        root.select-node(root.positioned-nodes[idx].instance-id);
    }

    // The strip's list fields, by touch or encoder: a factory preset, and
    // the model (row 0 opens the editor's model picker, the others load a
    // preset of the loaded tone)
    public function strip-factory-picked(preset: int) {
        root.apply-factory-preset(root.selected-instance-id, preset);
    }
    public function strip-model-picked(row: int) {
        if (row == 0) {
            root.open-node(root.selected-plugin);
            root.refresh-models();
            root.editor-model-picker = true;
        } else if (row - 1 < root.selected-presets.length) {
            root.set-model(root.selected-instance-id, root.selected-presets[row - 1].file);
        }
    }

    // Select a node and, for a plugin, open its editor
    function open-node(idx: int) {
        if (idx < 0 || idx >= root.positioned-nodes.length) {
            return;
        }
        root.editor-model-picker = false;
        if (idx != root.selected-plugin || root.positioned-nodes[idx].instance-id != root.selected-instance-id) {
            root.select-node-at(idx);
        }
        if (!root.positioned-nodes[idx].is-split) {
            root.focused-parameter = 0;
            root.adjusting = false;
            root.arranging = false;
            root.current-view = 1;
        }
    }

    function open-browser(mode: int, split-id: int) {
        root.split-insertion-mode = mode;
        root.target-split-index = split-id;
        root.browser-selected-index = 0;
        root.current-view = 2;
    }

    function add-plugin(uri: string) {
        if (root.split-insertion-mode == 1) {
            root.add-plugin-to-split-top(root.target-split-index, uri);
        } else if (root.split-insertion-mode == 2) {
            root.add-plugin-to-split-bottom(root.target-split-index, uri);
        } else {
            root.add-plugin-to-chain(uri);
        }
        root.split-insertion-mode = 0;
        root.target-split-index = -1;
        root.current-view = 0;
    }

    // Open the TONE3000 library; from a block editor (target-id >= 0),
    // only the block's gear is offered and models can be loaded in it
    function open-tone3000(target-id: int) {
        if (root.current-view != 8) {
            root.t3k-return-view = root.current-view;
        }
        root.t3k-detail-open = false;
        root.current-view = 8;
        root.t3k-open(target-id);
    }

    function toggle-bypass(instance-id: int) {
        root.toggle-node-bypass(instance-id);
    }

    forward-focus: keys;

    function adjust(steps: int) {
        if (root.focused-parameter < root.selected-parameters.length) {
            root.set-parameter(root.selected-instance-id, root.selected-parameters[root.focused-parameter].index,
                Encoder.step(root.selected-parameters[root.focused-parameter], steps));
        }
    }

    // The value a page's encoder adjusts: tempo, looper tempo / bar / click
    // level / level, reference pitch
    function page-value() -> float {
        root.current-view == 9 ? root.tempo
            : root.current-view == 5 ? (root.page-focus == 9 ? root.tempo : root.page-focus == 11 ? root.looper-beats-per-bar
                : root.page-focus == 15 ? root.looper-click-level : root.looper-level)
            : root.tuner-reference-pitch
    }

    // Encoder steps per unit of the page value (levels move by 5 %)
    function page-scale() -> float {
        root.current-view == 5 && (root.page-focus == 15 || root.page-focus == 16) ? 20 : 1
    }

    function set-looper-settings(beats: int, count-in: bool, quantize: bool, click: bool, click-level: float) {
        root.looper-beats-per-bar = max(2, min(12, beats));
        root.looper-count-in = count-in;
        root.looper-quantize = quantize;
        root.looper-click = click;
        root.looper-click-level = max(0, min(1, click-level));
        root.looper-settings-changed(root.looper-beats-per-bar, count-in, quantize, click, root.looper-click-level);
    }

    function set-page-value(v: float) {
        if (root.current-view == 9 || (root.current-view == 5 && root.page-focus == 9)) {
            root.set-tempo(max(40, min(240, v)));
        } else if (root.current-view == 5 && root.page-focus == 11) {
            root.set-looper-settings(v, root.looper-count-in, root.looper-quantize, root.looper-click, root.looper-click-level);
        } else if (root.current-view == 5 && root.page-focus == 15) {
            root.set-looper-settings(root.looper-beats-per-bar, root.looper-count-in, root.looper-quantize, root.looper-click, v);
        } else if (root.current-view == 5) {
            root.looper-level = max(0, min(1, v));
            root.looper-level-changed(root.looper-level);
        } else if (root.current-view == 3) {
            root.tuner-reference-pitch = max(430, min(450, v));
            root.tuner-reference-pitch-changed(root.tuner-reference-pitch);
        }
    }

    function page-press() {
        let i = root.page-focus;
        if (root.current-view == 4) {
            if (i < root.presets.length) {
                root.load-preset(root.presets[i].id);
                root.current-view = 0;
            }
        } else if (root.current-view == 9 && i < root.live-tiles.length) {
            root.live-tile-pressed(i);
        } else if (root.current-view == 9 && i == root.live-tiles.length + 1) {
            root.tap-tempo();
        } else if (root.current-view == 9 && i == root.live-tiles.length + 2) {
            root.live-mode-changed(root.live-mode == "scenes" ? "stomp" : root.live-mode == "stomp" ? "setlist" : "scenes");
        } else if (root.current-view == 5 && i < 9) {
            if (i == 0) {
                root.looper-record();
            } else if (i == 1) {
                root.looper-overdub();
            } else if (i == 2) {
                root.looper-play();
            } else if (i == 3) {
                root.looper-stop();
            } else if (i == 4) {
                // Disabled during a count-in, as on the page
                if (root.looper-state != LooperState.CountIn) {
                    root.looper-undo();
                }
            } else if (i == 5) {
                root.looper-clear();
            } else if (i == 6) {
                root.looper-multiply();
            } else if (i == 7) {
                root.looper-half-speed = !root.looper-half-speed;
                root.looper-half-speed-changed(root.looper-half-speed);
            } else {
                root.looper-show-loops = true;
                root.looper-loops-opened();
            }
        } else if (root.current-view == 5 && i == 10) {
            root.tap-tempo();
        } else if (root.current-view == 5 && i == 12) {
            root.set-looper-settings(root.looper-beats-per-bar, !root.looper-count-in, root.looper-quantize, root.looper-click, root.looper-click-level);
        } else if (root.current-view == 5 && i == 13) {
            root.set-looper-settings(root.looper-beats-per-bar, root.looper-count-in, !root.looper-quantize, root.looper-click, root.looper-click-level);
        } else if (root.current-view == 5 && i == 14) {
            root.set-looper-settings(root.looper-beats-per-bar, root.looper-count-in, root.looper-quantize, !root.looper-click, root.looper-click-level);
        } else if (root.current-view == 3 && i == 0) {
            root.tuner-mute-enabled = !root.tuner-mute-enabled;
            root.tuner-mute-toggled(root.tuner-mute-enabled);
        } else {
            // Tempo, looper tempo / bar / click level / level, reference pitch
            root.adjust-from = root.page-value();
            root.adjusting = true;
        }
    }

    // The control of Settings at the encoder's stop i (index: its row in a
    // list); see the starts above
    pure function settings-stop-at(i: int) -> EncoderStop {
        if (i < root.wifi-lead) {
            return { what: root.wifi-lead == 2 && i == 0 ? "wifi-scan" : "wifi-toggle", index: 0 };
        }
        if (i < root.system-start) {
            // The networks, the actions of the one open after it
            let r = i - root.wifi-lead;
            let open = root.wifi-open-shown ? root.wifi-open-index : root.wifi-networks.length;
            if (r <= open) {
                return { what: "wifi-network", index: r };
            }
            if (r <= open + 2) {
                return { what: r == open + 1 ? "wifi-action" : "wifi-forget", index: open };
            }
            return { what: "wifi-network", index: r - 2 };
        }
        if (i < root.display-start) {
            let r = i - root.system-start;
            let n = root.system-settings.length;
            return { what: r < n ? "system" : r == n ? "system-cancel" : "system-apply", index: r };
        }
        if (i < root.midi-start) {
            return { what: "display-light", index: 0 };
        }
        if (i < root.netmidi-start) {
            return { what: i == root.midi-start ? "midi-channel" : "midi-clock", index: 0 };
        }
        if (i < root.remote-start) {
            let r = i - root.netmidi-start;
            if (r < 3) {
                return { what: r == 0 ? "netmidi-toggle" : r == 1 ? "netmidi-name" : "netmidi-new", index: 0 };
            }
            if (i < root.netmidi-device-start) {
                // Allow and Block of a waiting session, Block of an allowed one
                let s = i - root.netmidi-session-start;
                let k = root.netmidi-session-stops[s];
                let second = s > 0 && root.netmidi-session-stops[s - 1] == k;
                return {
                    what: !second && k < root.netmidi-sessions.length && root.netmidi-sessions[k].state == "waiting"
                        ? "netmidi-allow" : "netmidi-block",
                    index: k
                };
            }
            return { what: "netmidi-remove", index: i - root.netmidi-device-start };
        }
        if (i < root.t3k-start) {
            let r = i - root.remote-start - root.remote-lead;
            let hotspot = RemoteControl.hotspot != "" ? 3 : 0;
            if (r < 0) {
                return { what: "remote-toggle", index: 0 };
            }
            if (r < hotspot) {
                return { what: "remote-hotspot", index: r };
            }
            return { what: r == hotspot ? "remote-password" : "remote-sign-out", index: 0 };
        }
        if (i < root.dsp-start) {
            let r = i - root.t3k-start;
            return {
                what: root.t3k-status == "waiting" ? "t3k-cancel"
                    : root.t3k-status == "connected" ? (root.t3k-confirm-disconnect && r == 0 ? "t3k-keep" : "t3k-disconnect")
                    : r == 0 ? "t3k-edit" : "t3k-connect",
                index: 0
            };
        }
        if (i < root.hardware-start) {
            return { what: "dsp-cores", index: 0 };
        }
        return { what: i == root.hardware-start ? "hardware" : "", index: 0 };
    }

    // Closes the Wi-Fi network showing its actions, the encoder on its row
    function close-wifi-network() {
        if (root.wifi-open-shown && root.current-view == 7) {
            root.page-focus = root.wifi-lead + root.wifi-open-index;
        }
        root.wifi-open-ssid = "";
        root.wifi-open-index = -1;
    }

    // Encoder press on Settings: does what a tap does. A toggle or a button
    // acts, a list row opens its list (a press there picks), a stepper or
    // segments are adjusted by the turns until the next press, a text field
    // opens its keyboard, a Wi-Fi network its actions
    function settings-press() {
        let s = root.settings-stop;
        if (root.system-picker >= 0) {
            if (!root.system-busy) {
                root.system-pick(root.system-settings[root.system-picker].key, root.system-picker-index);
                root.system-picker = -1;
            }
        } else if (root.adjusting) {
            root.adjusting = false;
        } else if (s.what == "wifi-scan") {
            if (!root.wifi-scanning) {
                root.wifi-refresh(true);
            }
        } else if (s.what == "wifi-toggle") {
            root.wifi-set-enabled(root.wifi-status != "on");
        } else if (s.what == "wifi-network") {
            if (root.wifi-busy-ssid == "" && s.index < root.wifi-networks.length) {
                let net = root.wifi-networks[s.index];
                if (net.connected || net.saved) {
                    if (root.wifi-open-shown && root.wifi-open-index == s.index) {
                        root.close-wifi-network();
                    } else {
                        root.wifi-open-ssid = net.ssid;
                        root.wifi-open-index = s.index;
                    }
                } else if (net.secured) {
                    root.wifi-password-ssid = net.ssid;
                } else {
                    root.close-wifi-network();
                    root.wifi-connect(net.ssid, "");
                }
            }
        } else if (s.what == "wifi-action" || s.what == "wifi-forget") {
            let net = root.wifi-networks[s.index];
            root.close-wifi-network();
            if (s.what == "wifi-forget") {
                root.wifi-forget(net.ssid);
            } else if (net.connected) {
                root.wifi-disconnect();
            } else {
                root.wifi-connect(net.ssid, "");
            }
        } else if (s.what == "system" || s.what == "system-cancel" || s.what == "system-apply") {
            if (root.system-busy) {
                return;
            }
            if (s.what == "system-cancel") {
                root.system-revert();
            } else if (s.what == "system-apply") {
                root.system-apply();
            } else if (root.system-settings[s.index].kind == "list") {
                root.system-picker-index = max(0, root.system-settings[s.index].selected);
                root.system-picker = s.index;
            } else {
                root.adjusting = true;
            }
        } else if (s.what == "display-light") {
            Theme.light = !Theme.light;
            root.light-theme-changed(Theme.light);
        } else if (s.what == "midi-clock") {
            root.midi-clock-changed(!root.midi-clock);
        } else if (s.what == "netmidi-toggle") {
            root.netmidi-set-enabled(!root.netmidi-enabled);
        } else if (s.what == "netmidi-name") {
            if (!root.netmidi-busy) {
                root.netmidi-draft = root.netmidi-name != "" ? root.netmidi-name : root.netmidi-hostname;
                root.netmidi-renaming = true;
            }
        } else if (s.what == "netmidi-allow" || s.what == "netmidi-block") {
            if (s.index < root.netmidi-sessions.length) {
                let session = root.netmidi-sessions[s.index];
                if (s.what == "netmidi-allow") {
                    root.netmidi-allow(session.name, session.address);
                } else {
                    root.netmidi-block(session.name, session.address);
                }
            }
        } else if (s.what == "netmidi-remove") {
            root.netmidi-forget(root.netmidi-devices[s.index].name, root.netmidi-devices[s.index].address);
        } else if (s.what == "remote-toggle") {
            if (RemoteControl.enabled) {
                RemoteControl.turn-off();
            } else {
                RemoteControl.draft = "";
                RemoteControl.editing = true;
            }
        } else if (s.what == "remote-hotspot") {
            RemoteControl.set-hotspot-mode(s.index == 0 ? "auto" : s.index == 1 ? "on" : "off");
        } else if (s.what == "remote-password") {
            RemoteControl.draft = "";
            RemoteControl.editing = true;
        } else if (s.what == "remote-sign-out") {
            RemoteControl.sign-out-all();
        } else if (s.what == "t3k-edit") {
            root.t3k-key-draft = root.t3k-client-id;
            root.t3k-editing-key = true;
        } else if (s.what == "t3k-connect") {
            if (root.t3k-status == "signed-out") {
                root.t3k-connect(root.t3k-client-id);
            }
        } else if (s.what == "t3k-cancel") {
            root.t3k-cancel();
        } else if (s.what == "t3k-keep") {
            root.t3k-confirm-disconnect = false;
        } else if (s.what == "t3k-disconnect") {
            if (root.t3k-confirm-disconnect) {
                root.t3k-confirm-disconnect = false;
                root.page-focus = root.t3k-start;
                root.t3k-disconnect();
            } else {
                // On Cancel, the confirmation one stop further
                root.t3k-confirm-disconnect = true;
            }
        } else if (s.what == "hardware") {
            root.current-view = 12;
        } else if (s.what != "") {
            // Steppers and segments: sample rate, MIDI channel, new
            // network MIDI devices, DSP cores
            root.adjusting = true;
        }
    }

    // A turn adjusting the control of Settings the encoder is on
    function settings-adjust(d: int) {
        let s = root.settings-stop;
        if (s.what == "system") {
            if (!root.system-busy) {
                root.system-step(root.system-settings[s.index].key, d);
            }
        } else if (s.what == "midi-channel") {
            let channel = max(0, min(16, root.midi-channel + d));
            if (channel != root.midi-channel) {
                root.midi-channel-changed(channel);
            }
        } else if (s.what == "netmidi-new") {
            if (root.netmidi-allow-all != (d > 0)) {
                root.netmidi-set-allow-all(d > 0);
            }
        } else if (s.what == "dsp-cores") {
            let cores = max(0, min(root.dsp-max-cores, root.dsp-cores + d));
            if (cores != root.dsp-cores) {
                root.dsp-cores = cores;
                root.dsp-cores-changed(cores);
            }
        }
    }

    // The control of Settings → Hardware at the encoder's stop i (index:
    // the footswitch); not the encoder's own settings
    pure function hardware-stop-at(i: int) -> EncoderStop {
        if (i == 0) {
            return { what: "footswitches", index: 0 };
        }
        if (i < root.hw-tap-start) {
            return { what: "footswitch", index: i - 1 };
        }
        if (i < root.hw-i2c-start) {
            return { what: "tap", index: 0 };
        }
        let r = i - root.hw-i2c-start;
        return { what: r == 0 ? "i2c" : r == 1 ? "i2c-module" : r == 2 ? "i2c-steps" : "i2c-reverse", index: 0 };
    }

    // Encoder press on Settings → Hardware: a toggle switches, a stepper is
    // adjusted by the turns until the next press. A change applies at once
    function hardware-press() {
        let s = root.hardware-stop;
        if (root.adjusting) {
            root.adjusting = false;
        } else if (s.what == "tap") {
            root.tap-switch-changed(!root.tap-switch);
        } else if (s.what == "i2c") {
            root.hardware-set-i2c(!root.hardware-i2c);
        } else if (s.what == "i2c-reverse") {
            root.hardware-step("i2c-reverse", 0, root.hardware-i2c-reverse ? -1 : 1);
        } else {
            root.adjusting = true;
        }
    }

    function open-pages() {
        root.pages-index = root.current-view == 4 ? 1 : root.current-view == 9 ? 2 : root.current-view == 3 ? 3
            : root.current-view == 5 ? 4 : root.current-view == 7 ? 5 : 0;
        root.pages-open = true;
    }

    function open-routing() {
        if (root.current-view != 10) {
            root.routing-return-view = root.current-view;
        }
        root.current-view = 10;
    }

    // Label of the back button leading to view v
    function view-name(v: int) -> string {
        return v == 1 ? root.selected-plugin-name : v == 2 ? "Effects" : v == 3 ? "Tuner"
            : v == 4 ? "Presets" : v == 5 ? "Looper" : v == 6 ? "Setlists" : v == 7 ? "Settings"
            : v == 8 ? "TONE3000" : v == 9 ? "Live" : v == 11 ? "Store" : v == 12 ? "Hardware" : "Rack";
    }

    function open-page(index: int) {
        root.pages-open = false;
        root.current-view = root.page-views[index];
    }

    changed arranging => {
        root.adjusting = false;
        root.arrange-stop = 0;
    }

    // Text fields (keyboard dialogs) take the focus: give it back to the
    // encoder / shortcut handler when the view changes
    changed current-view => {
        keys.focus();
        root.adjusting = false;
        root.add-focused = false;
        root.arranging = false;
        root.page-focus = 0;
        root.system-picker = -1;
        // What Settings had open goes with it
        root.wifi-open-ssid = "";
        root.wifi-open-index = -1;
        root.wifi-password-ssid = "";
        root.netmidi-renaming = false;
        root.t3k-editing-key = false;
        root.t3k-confirm-disconnect = false;
        // Learning only makes sense in the block editor
        if (root.current-view != 1 && root.midi-learning) {
            root.midi-learn-toggled(false);
        }
    }

    // A keyboard of the Settings closed: its text field had the focus and
    // took it away with it, so turns and presses went nowhere until the
    // page changed; it goes back to the encoder
    changed settings-typing => {
        if (!root.settings-typing) {
            keys.focus();
        }
    }

    // ------------------------------------------------------------------ UI
    VerticalLayout {
        TopBar {
            active-tab: root.current-view <= 2 || root.current-view == 11 ? "rack" :
                root.current-view == 3 ? "tuner" :
                root.current-view == 4 || root.current-view == 6 ? "presets" :
                root.current-view == 5 ? "looper" :
                root.current-view == 9 ? "live" : "";
            current-view-name: root.current-view == 1 ? root.selected-plugin-name :
                root.current-view == 7 ? "Settings" :
                root.current-view == 8 ? "TONE3000" :
                root.current-view == 10 ? "Routing" :
                root.current-view == 12 ? "Hardware" :
                root.current-view == 11 ? (root.catalog-open >= 0 ? "Plugin" : "Store") : "Add effect";
            preset-name: root.current-preset-name;
            scene-name: root.live-scene-name;
            tempo: root.tempo;
            back-label: root.current-view == 10 ? root.view-name(root.routing-return-view)
                : root.current-view == 12 ? "Settings" : root.current-view == 11 ? (root.catalog-open >= 0 ? "Store" : "Effects") : "Rack";
            show-back-button: root.current-view == 1 || root.current-view == 2 || root.current-view == 7 || root.current-view == 8 || root.current-view == 10 || root.current-view == 11 || root.current-view == 12;
            audio-running: root.audio-running;
            resources: root.resources;
            menu-badge: root.update-pending;

            resources-clicked => {
                root.show-resources = true;
            }
            back-clicked => {
                if (root.current-view == 11 && root.catalog-open >= 0) {
                    root.catalog-open = -1;
                } else {
                    root.current-view = root.current-view == 8 ? root.t3k-return-view
                        : root.current-view == 10 ? root.routing-return-view
                        : root.current-view == 12 ? 7 : root.current-view == 11 ? 2 : 0;
                }
            }
            rack-clicked => {
                root.current-view = 0;
            }
            tuner-clicked => {
                root.current-view = 3;
            }
            looper-clicked => {
                root.current-view = 5;
            }
            presets-clicked => {
                root.current-view = 4;
            }
            live-clicked => {
                root.current-view = 9;
            }
            menu-clicked => {
                root.context-menu-items = root.main-menu(Features.tone3000, Features.update, Features.power,
                    root.update-pending);
                root.context-menu-x = root.width - 248px;
                root.context-menu-y = Theme.top-bar-height + 4px;
                root.show-context-menu = true;
            }
        }

        // View content
        Rectangle {
            vertical-stretch: 1;
            background: Theme.background;

            if root.current-view == 0: PluginRack {
                levels: root.levels;
                positioned-nodes: root.positioned-nodes;
                connectors: root.connectors;
                chain-width: root.chain-width;
                chain-top: root.chain-top;
                chain-bottom: root.chain-bottom;
                selected-instance-id: root.selected-instance-id;
                selected-index <=> root.selected-plugin;
                page <=> root.strip-page;
                list-row <=> root.strip-list-row;
                list-focus <=> root.strip-list-focus;
                add-focused: root.add-focused;
                stereo-mode <=> root.stereo-mode;
                drop-slots: root.drop-slots;
                parameters: root.selected-parameters;
                strip-count: root.selected-strip-count;
                uses-file: root.selected-uses-file;
                file-title: root.selected-file-title;
                file-label: root.selected-file-label;
                preset-name: root.selected-preset-name;
                factory-labels: root.selected-strip-factory;
                model-labels: root.selected-strip-models;
                model-current: root.selected-strip-model-current;
                factory-preset-picked(preset) => {
                    root.strip-factory-picked(preset);
                }
                model-picked(row) => {
                    root.strip-model-picked(row);
                }

                drag-started(id) => {
                    root.drag-started(id);
                }
                node-dropped(id, x, y) => {
                    root.node-dropped(id, x, y);
                }

                node-tapped(idx) => {
                    root.select-node-at(idx);
                }
                node-double-tapped(idx) => {
                    root.open-node(idx);
                }
                parameter-changed(index, value) => {
                    root.set-parameter(root.selected-instance-id, index, value);
                }
                node-long-pressed(id) => {
                    root.toggle-bypass(id);
                }
                edit-clicked(id) => {
                    root.open-node(root.selected-plugin);
                }
                toggle-bypass-clicked(id) => {
                    root.toggle-bypass(id);
                }
                remove-node-clicked(id) => {
                    root.remove-node-by-id(id);
                    if (id == root.selected-instance-id) {
                        root.selected-instance-id = -1;
                    }
                }
                add-plugin-clicked => {
                    root.open-browser(0, -1);
                }
                add-split-clicked => {
                    root.context-menu-items = [
                        { id: "split-mix", label: "Parallel mix", icon: "split", enabled: true },
                        { id: "split-ab", label: "A/B switch", icon: "split", enabled: true },
                        { id: "split-lr", label: "Left / right", icon: "stereo", enabled: true },
                    ];
                    // Drops from the split button (top right of the rack)
                    root.context-menu-x = root.width - Theme.space-md - 52px - 240px;
                    root.context-menu-y = Theme.top-bar-height + Theme.space-md + Theme.touch-target + 4px;
                    root.show-context-menu = true;
                }
                add-plugin-to-split-top-clicked(id) => {
                    root.open-browser(1, id);
                }
                add-plugin-to-split-bottom-clicked(id) => {
                    root.open-browser(2, id);
                }
                toggle-ab-clicked(id) => {
                    root.toggle-split-ab(id);
                }
                mix-ratio-changed(id, ratio) => {
                    root.set-split-mix-ratio(id, ratio);
                }
                pan-changed(id, a, b) => {
                    root.set-split-pan(id, a, b);
                }
                split-type-clicked(id) => {
                    root.target-split-index = id;
                    root.context-menu-items = [
                        { id: "type-mix", label: "Parallel mix", icon: "split", enabled: root.selected-split-type != "mix" },
                        { id: "type-ab", label: "A/B switch", icon: "split", enabled: root.selected-split-type != "ab" },
                        { id: "type-lr", label: "Left / right", icon: "stereo", enabled: root.selected-split-type != "lr" },
                    ];
                    root.context-menu-x = 16px;
                    root.context-menu-y = root.height - 72px - 3 * 48px - 24px;
                    root.show-context-menu = true;
                }
                stereo-mode-toggled(stereo) => {
                    root.stereo-mode = stereo;
                    root.set-stereo-mode(stereo);
                }
            }

            if root.current-view == 1: PluginEditor {
                instance-id: root.selected-instance-id;
                plugin-name: root.selected-plugin-name;
                category: root.selected-plugin-category;
                bypassed: root.selected-plugin-bypassed;
                parameters: root.selected-parameters;
                eq: root.selected-eq;
                eq-points: root.selected-eq-points;
                dyn: root.selected-dyn;
                dyn-live: root.selected-dyn-live;
                scope: root.selected-scope;
                scope-live: root.selected-scope-live;
                spectrum: root.selected-spectrum;
                focused-param: root.focused-parameter;
                remove-armed <=> root.remove-armed;
                remove-focused: root.focused-parameter == root.remove-slot;
                bypass-focused: root.focused-parameter == root.bypass-slot;
                adjusting: root.adjusting;
                arrange-focused: root.focused-parameter == root.arrange-slot;
                reset-focused: root.focused-parameter == root.reset-slot;
                arranging <=> root.arranging;
                arrange-stop: root.arrange-stop;
                arrange-moved(index, places) => {
                    root.arrange-parameter(root.selected-instance-id, index, places);
                }
                strip-toggled(index) => {
                    root.toggle-parameter-strip(root.selected-instance-id, index);
                }
                arrange-reset => {
                    root.reset-parameter-layout(root.selected-instance-id);
                }
                remove-confirmed => {
                    root.remove-node-by-id(root.selected-instance-id);
                    root.selected-instance-id = -1;
                    root.current-view = 0;
                }
                uses-file: root.selected-uses-file;
                file: root.selected-file;
                file-label: root.selected-file-label;
                file-types: root.selected-file-types;
                file-title: root.selected-file-title;
                file-subtitle: root.selected-file-subtitle;
                file-t3k: root.selected-file-t3k;
                file-image: root.selected-file-image;
                presets: root.selected-presets;
                preset-name: root.selected-preset-name;
                packs: root.available-packs;
                packs-pictures: root.available-packs-pictures;
                models-dir: root.models-dir;
                file-slots: root.selected-file-slots;
                model-picker-open <=> root.editor-model-picker;
                factory-presets: root.selected-factory-presets;
                factory-preset-chosen(preset) => {
                    root.apply-factory-preset(root.selected-instance-id, preset);
                }
                colors: root.block-colors;
                color: root.selected-color;
                color-value: root.selected-color-value;
                auto-color: root.selected-auto-color;
                midi-available: root.midi-available;
                midi-learning: root.midi-learning;
                midi-learn-target: root.midi-learn-target;
                midi-learn-cc: root.midi-learn-cc;
                midi-learn-message: root.midi-learn-message;
                midi-learn-assigned: root.midi-learn-assigned;
                midi-learn-heel: root.midi-learn-heel;
                midi-learn-toe: root.midi-learn-toe;
                midi-learn-range(heel, toe) => {
                    root.midi-learn-range(heel, toe);
                }
                bypass-midi: root.selected-bypass-midi;
                cpu: root.selected-cpu;
                midi-learn-toggled(on) => {
                    root.midi-learn-toggled(on);
                }
                midi-learn-touch(target) => {
                    root.midi-learn-touch(target);
                }
                midi-learn-clear(target) => {
                    root.midi-learn-clear(target);
                }

                parameter-changed(index, value) => {
                    root.set-parameter(root.selected-instance-id, index, value);
                }
                bypass-toggled => {
                    root.toggle-bypass(root.selected-instance-id);
                }
                color-chosen(name) => {
                    root.set-color(root.selected-instance-id, name);
                }
                models-requested => {
                    root.refresh-models();
                }
                model-chosen(file) => {
                    root.set-model(root.selected-instance-id, file);
                }
                slot-files-requested(param) => {
                    root.refresh-slot-files(param);
                }
                slot-file-chosen(param, file) => {
                    root.set-param-file(root.selected-instance-id, param, file);
                }
                browse-tone3000 => {
                    root.open-tone3000(root.selected-instance-id);
                }
            }

            if root.current-view == 2: PluginBrowser {
                plugins: root.available-plugins;
                selected-index: root.browser-selected-index;
                demo-plugins: root.demo-plugins;
                target-label: root.split-insertion-mode == 1 ? "Top branch of the split" :
                    root.split-insertion-mode == 2 ? "Bottom branch of the split" : "End of the main chain";

                plugin-selected(idx, uri) => {
                    root.add-plugin(uri);
                }
                open-store => {
                    root.catalog-open = -1;
                    root.current-view = 11;
                    root.catalog-opened();
                }
            }

            if root.current-view == 11: CatalogView {
                items: root.catalog-items;
                families: root.catalog-families;
                query: root.catalog-query;
                family: root.catalog-family;
                total: root.catalog-total;
                status: root.catalog-status;
                busy: root.catalog-busy;
                open <=> root.catalog-open;
                search(q) => {
                    root.catalog-search(q);
                }
                pick-family(f) => {
                    root.catalog-pick-family(f);
                }
                install(id) => {
                    root.catalog-install(id);
                }
                remove(id) => {
                    root.catalog-remove(id);
                }
                refresh => {
                    root.catalog-refresh();
                }
                add-to-chain(id) => {
                    root.catalog-open = -1;
                    root.add-plugin(root.catalog-uri(id));
                }
            }

            if root.current-view == 3: TunerView {
                focused: root.page-focus;
                adjusting: root.adjusting;
                frequency: root.tuner-frequency;
                note-name: root.tuner-note;
                octave: root.tuner-octave;
                cents: root.tuner-cents;
                is-tuned: root.tuner-is-tuned;
                mute-enabled <=> root.tuner-mute-enabled;
                reference-pitch <=> root.tuner-reference-pitch;

                mute-toggled(enabled) => {
                    root.tuner-mute-toggled(enabled);
                }
                reference-pitch-changed(freq) => {
                    root.tuner-reference-pitch-changed(freq);
                }
            }

            if root.current-view == 4: PresetManager {
                focused: root.page-focus;
                presets: root.presets;
                current-preset-name: root.current-preset-name;
                current-preset-id: root.current-preset-id;

                show-setlists(mode) => {
                    root.setlist-view-mode = mode;
                    root.current-view = 6;
                }
                preset-selected(id) => {
                    root.load-preset(id);
                    root.current-view = 0;
                }
                save-preset(name) => {
                    root.save-preset(name);
                }
                update-preset => {
                    root.update-preset();
                }
                delete-preset(id) => {
                    root.delete-preset(id);
                }
                close => {
                    root.current-view = 0;
                }
            }

            if root.current-view == 5: LooperView {
                focused: root.page-focus;
                adjusting: root.adjusting;
                state: root.looper-state;
                loop-length: root.looper-length;
                current-position: root.looper-position;
                layer-count: root.looper-layers;
                level: root.looper-level;
                bar: root.looper-bar;
                beat: root.looper-beat;
                beats: root.looper-beats;
                loop-bars: root.looper-bars;
                ending: root.looper-ending;
                tempo: root.tempo;
                tempo-clock: root.tempo-clock;
                beats-per-bar: root.looper-beats-per-bar;
                count-in: root.looper-count-in;
                quantize: root.looper-quantize;
                click: root.looper-click;
                click-level: root.looper-click-level;
                half-speed: root.looper-half-speed;
                can-double: root.looper-can-double;
                wave: root.looper-wave;
                show-loops <=> root.looper-show-loops;
                saved: root.looper-saved;
                default-name: root.looper-default-name;

                tempo-changed(bpm) => {
                    root.set-tempo(max(40, min(240, bpm)));
                }
                tap => {
                    root.tap-tempo();
                }
                settings-changed(beats, count-in, quantize, click, click-level) => {
                    root.set-looper-settings(beats, count-in, quantize, click, click-level);
                }
                multiply-clicked => {
                    root.looper-multiply();
                }
                half-speed-toggled => {
                    root.looper-half-speed = !root.looper-half-speed;
                    root.looper-half-speed-changed(root.looper-half-speed);
                }
                loops-opened => {
                    root.looper-loops-opened();
                }
                save-loop(name) => {
                    root.looper-save(name);
                }
                load-loop(id) => {
                    root.looper-load(id);
                }
                delete-loop(id) => {
                    root.looper-delete(id);
                }
                record-clicked => {
                    root.looper-record();
                }
                play-clicked => {
                    root.looper-play();
                }
                stop-clicked => {
                    root.looper-stop();
                }
                overdub-clicked => {
                    root.looper-overdub();
                }
                undo-clicked => {
                    root.looper-undo();
                }
                clear-clicked => {
                    root.looper-clear();
                }
                level-changed(lvl) => {
                    root.looper-level = lvl;
                    root.looper-level-changed(lvl);
                }
            }

            if root.current-view == 6: SceneManager {
                view-mode <=> root.setlist-view-mode;
                show-presets => {
                    root.current-view = 4;
                }
                scenes: root.scenes;
                scene-slots: root.scene-slots;
                presets: root.presets;
                current-scene-name: root.current-scene-name;

                scene-selected(id) => {
                    root.load-scene(id);
                }
                create-scene(name) => {
                    root.create-scene(name);
                }
                delete-scene(id) => {
                    root.delete-scene(id);
                }
                slot-assign(slot, preset-id) => {
                    root.scene-slot-assign(slot, preset-id);
                }
                slot-clear(slot) => {
                    root.scene-slot-clear(slot);
                }
                footswitch-pressed(slot) => {
                    root.footswitch-pressed(slot);
                }
                close => {
                    root.current-view = 0;
                }
            }

            if root.current-view == 8: Tone3000View {
                tab: root.t3k-tab;
                gear: root.t3k-gear;
                tones: root.t3k-tones;
                loading: root.t3k-loading;
                error: root.t3k-list-error;
                has-more: root.t3k-has-more;
                detail-open <=> root.t3k-detail-open;
                detail: root.t3k-detail;
                detail-url: root.t3k-detail-url;
                models: root.t3k-models;
                models-loading: root.t3k-models-loading;
                query: root.t3k-query;
                selected-count: root.t3k-selected-count;
                model-page: root.t3k-model-page;
                model-pages: root.t3k-model-pages;
                page-selectable: root.t3k-page-selectable;
                page-selected: root.t3k-page-selected;
                download-status: root.t3k-download-status;
                target-name: root.t3k-target-name;
                gear-ids: root.t3k-gear-ids;
                gear-names: root.t3k-gear-names;
                username: root.t3k-username;
                avatar: root.t3k-avatar;

                load(tab, gear) => {
                    root.t3k-load(tab, gear, false);
                }
                load-more => {
                    root.t3k-load(root.t3k-tab, root.t3k-gear, true);
                }
                open-tone(i) => {
                    root.t3k-open-tone(i);
                }
                toggle-model(i) => {
                    root.t3k-toggle-model(i);
                }
                select-page => {
                    root.t3k-select-page();
                }
                model-page-changed(page) => {
                    root.t3k-model-page-changed(page);
                }
                download-selected => {
                    root.t3k-download-selected();
                }
                cancel-downloads => {
                    root.t3k-cancel-downloads();
                }
                search(q) => {
                    root.t3k-search(q);
                }
                use-model(path) => {
                    root.set-model(root.t3k-target-id, path);
                    root.t3k-detail-open = false;
                    root.current-view = 1;
                }
                add-model(uri, path) => {
                    // The backend selects the new block
                    root.t3k-add-model(uri, path);
                    root.t3k-detail-open = false;
                    root.current-view = 1;
                }
            }

            if root.current-view == 9: LiveView {
                focused: root.page-focus;
                adjusting: root.adjusting;
                mode: root.live-mode;
                tiles: root.live-tiles;
                preset-name: root.current-preset-name;
                scene-name: root.live-scene-name;
                scene-index: root.live-scene-index;
                setlist-name: root.current-scene-name == "No setlist" ? "" : root.current-scene-name;
                tempo: root.tempo;
                tempo-clock: root.tempo-clock;
                tap-switch-label: root.tap-switch-label;
                stomp-choices: root.stomp-choices;

                mode-changed(mode) => {
                    root.live-mode-changed(mode);
                }
                tile-pressed(i) => {
                    root.live-tile-pressed(i);
                }
                tap => {
                    root.tap-tempo();
                }
                tempo-changed(bpm) => {
                    root.set-tempo(bpm);
                }
                rename-scene(slot, name) => {
                    root.rename-scene(slot, name);
                }
                assign-stomp(slot, id) => {
                    root.assign-stomp(slot, id);
                }
                open-setlists => {
                    root.setlist-view-mode = 1;
                    root.current-view = 6;
                }
            }

            if root.current-view == 10: RoutingView {
                available: root.routing-available;
                summary: root.routing-summary;
                inputs: root.routing-inputs;
                input: root.routing-input;
                outputs: root.routing-outputs;
                input-levels: root.routing-input-levels;
                output-levels: root.routing-output-levels;
                preset-name: root.current-preset-name;
                blocks: root.routing-blocks;
                step-input(delta) => {
                    root.routing-step-input(delta);
                }
                step-source(port, delta) => {
                    root.routing-step-source(port, delta);
                }
                set-linked(port, on) => {
                    root.routing-set-linked(port, on);
                }
                set-gain(port, db) => {
                    root.routing-set-gain(port, db);
                }
                set-pan(port, pan) => {
                    root.routing-set-pan(port, pan);
                }
                set-fold(port, fold) => {
                    root.routing-set-fold(port, fold);
                }
                toggle(port, what) => {
                    root.routing-toggle(port, what);
                }
            }

            if root.current-view == 12: HardwareView {
                footswitch-count: root.footswitch-count;
                tap-switch: root.tap-switch;
                tap-switch-changed(on) => {
                    root.tap-switch-changed(on);
                }
                footswitch-down-mask: root.footswitch-down-mask;
                hardware-footswitch-pins: root.hardware-footswitch-pins;
                hardware-encoder: root.hardware-encoder;
                hardware-encoder-a: root.hardware-encoder-a;
                hardware-encoder-b: root.hardware-encoder-b;
                hardware-encoder-button: root.hardware-encoder-button;
                hardware-encoder-steps: root.hardware-encoder-steps;
                hardware-message: root.hardware-message;
                hardware-i2c: root.hardware-i2c;
                hardware-i2c-module: root.hardware-i2c-module;
                hardware-i2c-steps: root.hardware-i2c-steps;
                hardware-i2c-reverse: root.hardware-i2c-reverse;
                hardware-i2c-found: root.hardware-i2c-found;
                hardware-set-i2c(on) => {
                    root.hardware-set-i2c(on);
                }
                hardware-step(what, index, delta) => {
                    root.hardware-step(what, index, delta);
                }
                hardware-set-encoder(on) => {
                    root.hardware-set-encoder(on);
                }
                hardware-set-encoder-button(on) => {
                    root.hardware-set-encoder-button(on);
                }
                encoder-what: root.hardware-stop.what;
                encoder-index: root.hardware-stop.index;
                encoder-adjusting: root.adjusting;
            }

            if root.current-view == 7: SettingsView {
                open-hardware => {
                    root.current-view = 12;
                }
                midi-available: root.midi-available;
                midi-devices: root.midi-devices;
                midi-channel: root.midi-channel;
                midi-clock: root.midi-clock;
                midi-activity: root.midi-activity;
                midi-channel-changed(channel) => {
                    root.midi-channel-changed(channel);
                }
                midi-clock-changed(on) => {
                    root.midi-clock-changed(on);
                }
                light-theme-changed(on) => {
                    root.light-theme-changed(on);
                }
                netmidi-available: root.netmidi-available;
                netmidi-enabled: root.netmidi-enabled;
                netmidi-busy: root.netmidi-busy;
                netmidi-name: root.netmidi-name;
                netmidi-hostname: root.netmidi-hostname;
                netmidi-summary: root.netmidi-summary;
                netmidi-sessions: root.netmidi-sessions;
                netmidi-devices: root.netmidi-devices;
                netmidi-allow-all: root.netmidi-allow-all;
                netmidi-message: root.netmidi-message;
                netmidi-set-enabled(on) => {
                    root.netmidi-set-enabled(on);
                }
                netmidi-rename(name) => {
                    root.netmidi-rename(name);
                }
                netmidi-set-allow-all(on) => {
                    root.netmidi-set-allow-all(on);
                }
                netmidi-allow(name, address) => {
                    root.netmidi-allow(name, address);
                }
                netmidi-block(name, address) => {
                    root.netmidi-block(name, address);
                }
                netmidi-forget(name, address) => {
                    root.netmidi-forget(name, address);
                }
                dsp-cores: root.dsp-cores;
                dsp-max-cores: root.dsp-max-cores;
                dsp-cores-changed(cores) => {
                    root.dsp-cores = cores;
                    root.dsp-cores-changed(cores);
                }
                system-available: root.system-available;
                system-settings: root.system-settings;
                system-summary: root.system-summary;
                system-changed: root.system-changed;
                system-busy: root.system-busy;
                system-message: root.system-message;
                system-step(key, delta) => {
                    root.system-step(key, delta);
                }
                system-pick(key, index) => {
                    root.system-pick(key, index);
                }
                encoder-what: root.settings-stop.what;
                encoder-index: root.settings-stop.index;
                encoder-adjusting: root.adjusting;
                wifi-open-ssid <=> root.wifi-open-ssid;
                wifi-open-index <=> root.wifi-open-index;
                wifi-password-ssid <=> root.wifi-password-ssid;
                netmidi-renaming <=> root.netmidi-renaming;
                netmidi-draft <=> root.netmidi-draft;
                editing-key <=> root.t3k-editing-key;
                key-draft <=> root.t3k-key-draft;
                confirm-disconnect <=> root.t3k-confirm-disconnect;
                system-picker <=> root.system-picker;
                system-picker-index <=> root.system-picker-index;
                system-apply => {
                    root.system-apply();
                }
                system-revert => {
                    root.system-revert();
                }
                wifi-status: root.wifi-status;
                wifi-networks: root.wifi-networks;
                wifi-scanning: root.wifi-scanning;
                wifi-busy-ssid: root.wifi-busy-ssid;
                wifi-message: root.wifi-message;
                wifi-addresses: root.wifi-addresses;
                wifi-refresh(rescan) => {
                    root.wifi-refresh(rescan);
                }
                wifi-set-enabled(on) => {
                    root.wifi-set-enabled(on);
                }
                wifi-connect(ssid, password) => {
                    root.wifi-connect(ssid, password);
                }
                wifi-disconnect => {
                    root.wifi-disconnect();
                }
                wifi-forget(ssid) => {
                    root.wifi-forget(ssid);
                }
                t3k-available: root.t3k-available;
                t3k-status: root.t3k-status;
                t3k-client-id: root.t3k-client-id;
                t3k-username: root.t3k-username;
                t3k-user-code: root.t3k-user-code;
                t3k-url: root.t3k-url;
                t3k-qr: root.t3k-qr;
                t3k-error: root.t3k-error;

                t3k-connect(key) => {
                    root.t3k-connect(key);
                }
                t3k-cancel => {
                    root.t3k-cancel();
                }
                t3k-disconnect => {
                    root.t3k-disconnect();
                }
            }
        }
    }

    // Toast (status message from the backend, which hides it after a while)
    if root.status-message != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 88px;
        width: min(parent.width - 2 * Theme.space-lg, toast-row.preferred-width);
        height: 44px;
        border-radius: Theme.radius-md;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-strong;

        // A tap hides it (the action button above keeps its own taps)
        TouchArea {
            clicked => {
                root.status-message = "";
            }
        }

        toast-row := HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-lg;
            spacing: Theme.space-sm;
            VerticalLayout {
                alignment: center;
                Icon {
                    name: "info";
                    size: 18px;
                    color: Theme.accent;
                }
            }
            Text {
                text: root.status-message;
                color: Theme.text-primary;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.status-action != "": Rectangle {
                width: Theme.space-sm;
            }
            if root.status-action != "": VerticalLayout {
                alignment: center;
                Button {
                    height: 32px;
                    text: root.status-action;
                    font-size: Theme.font-small;
                    variant: "primary";
                    clicked => {
                        root.status-action-clicked();
                    }
                }
            }
        }

    }

    ContextMenuOverlay {
        show-menu: root.show-context-menu;
        menu-items: root.context-menu-items;
        menu-x: root.context-menu-x;
        menu-y: root.context-menu-y;

        menu-item-clicked(id) => {
            root.show-context-menu = false;
            if (id == "split-mix") {
                root.add-split("mix");
            } else if (id == "split-ab") {
                root.add-split("ab");
            } else if (id == "split-lr") {
                root.add-split("lr");
            } else if (id == "type-mix" || id == "type-ab" || id == "type-lr") {
                root.set-split-type(root.target-split-index, id == "type-mix" ? "mix" : id == "type-ab" ? "ab" : "lr");
                root.target-split-index = -1;
            } else if (id == "tone3000") {
                root.open-tone3000(-1);
            } else if (id == "routing") {
                root.open-routing();
            } else if (id == "updates" || id == "about") {
                root.update-dialog = true;
            } else if (id == "settings") {
                root.current-view = 7;
            } else if (id == "power") {
                root.power-action = "";
                root.power-dialog = true;
            } else if (id == "quit") {
                root.quit-app();
            }
        }
        close-menu => {
            root.show-context-menu = false;
        }
    }

    // Page switcher (long press on a main page): turn, then press
    if root.pages-open: Rectangle {
        background: #000000a0;
        TouchArea {
            clicked => {
                root.pages-open = false;
            }
        }
        Rectangle {
            width: min(parent.width - 2 * Theme.space-lg, 6 * 112px + 7 * Theme.space-sm);
            height: 136px;
            border-radius: Theme.radius-lg;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border-strong;
            TouchArea { }
            HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;
                for page[i] in [
                    { icon: "rack", label: "Rack" },
                    { icon: "presets", label: "Presets" },
                    { icon: "live", label: "Live" },
                    { icon: "tuner", label: "Tuner" },
                    { icon: "looper", label: "Looper" },
                    { icon: "settings", label: "Settings" },
                ]: Rectangle {
                    border-radius: Theme.radius-md;
                    background: i == root.pages-index ? Theme.accent.with-alpha(0.18) : transparent;
                    border-width: i == root.pages-index ? 2px : 0px;
                    border-color: Theme.accent;
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-sm;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                name: page.icon;
                                size: 32px;
                                color: i == root.pages-index ? Theme.accent : Theme.text-secondary;
                            }
                        }
                        Text {
                            text: page.label;
                            horizontal-alignment: center;
                            color: i == root.pages-index ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.open-page(i);
                        }
                    }
                }
            }
        }
    }

    NetMidiPrompt {
        name: root.netmidi-prompt-name;
        address: root.netmidi-prompt-address;
        allow => {
            root.netmidi-allow(root.netmidi-prompt-name, root.netmidi-prompt-address);
        }
        block => {
            root.netmidi-block(root.netmidi-prompt-name, root.netmidi-prompt-address);
        }
        later => {
            root.netmidi-later();
        }
    }

    PowerDialog {
        show <=> root.power-dialog;
        action <=> root.power-action;
        power(action) => {
            root.power(action);
        }
    }

    UpdateDialog {
        show <=> root.update-dialog;
        status: root.update-status;
        current: root.update-current;
        version: root.update-version;
        kind: root.update-kind;
        size: root.update-size;
        progress: root.update-progress;
        message: root.update-message;
        check => {
            root.update-check();
        }
        install => {
            root.update-install();
        }
        restart => {
            root.update-restart();
        }
    }

    ResourcePanel {
        show: root.show-resources;
        status: root.resources;
        audio-running: root.audio-running;
        close => {
            root.show-resources = false;
        }
    }

    // Keyboard shortcuts simulating the rotary encoder
    keys := FocusScope {
        width: 0px;
        height: 0px;

        // Which of the six keys `key` is, -1 if none
        pure function strip-key(key: string, k0: string, k1: string, k2: string,
                k3: string, k4: string, k5: string) -> int {
            return key == k0 ? 0 : key == k1 ? 1 : key == k2 ? 2
                : key == k3 ? 3 : key == k4 ? 4 : key == k5 ? 5 : -1;
        }

        key-pressed(event) => {
            // Turn (and the arrows of a keyboard)
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                let d = event.text == Key.LeftArrow || event.text == Key.UpArrow ? -1 : 1;
                if (root.pages-open) {
                    root.pages-index = max(0, min(root.page-views.length - 1, root.pages-index + d));
                } else if (root.dialog-open) {
                    // Not behind it
                } else if (root.focus-hidden) {
                    // Shows where the focus is
                } else if (root.current-view == 1 && root.adjusting && root.arranging) {
                    // Moves the picked parameter, the focus with it
                    root.arrange-parameter(root.selected-instance-id,
                        root.selected-parameters[root.focused-parameter].index, d);
                    root.focused-parameter = max(0, min(root.selected-parameters.length - 1, root.focused-parameter + d));
                } else if (root.current-view == 1 && root.adjusting) {
                    root.adjust(d);
                } else if (root.current-view == 1 && root.arranging && root.focused-parameter < root.selected-parameters.length) {
                    let stop = max(0, root.focused-parameter * 2 + root.arrange-stop + d);
                    if (stop >= root.selected-parameters.length * 2) {
                        root.focused-parameter = root.arrange-slot;
                        root.arrange-stop = 0;
                    } else {
                        root.focused-parameter = floor(stop / 2);
                        root.arrange-stop = mod(stop, 2);
                    }
                } else if (root.current-view == 7 && root.system-picker >= 0) {
                    root.system-picker-index = max(0, min(root.system-settings[root.system-picker].choices.length - 1,
                        root.system-picker-index + d));
                } else if (root.current-view == 7 && root.adjusting) {
                    root.settings-adjust(d);
                } else if (root.current-view == 12 && root.adjusting) {
                    let s = root.hardware-stop;
                    root.hardware-step(s.what, s.index, d);
                } else if (root.adjusting) {
                    root.set-page-value(round(root.page-value() * root.page-scale() + d) / root.page-scale());
                } else if (root.page-slots > 0) {
                    root.page-focus = max(0, min(root.page-slots - 1, root.page-focus + d));
                } else if (root.current-view == 1) {
                    root.focused-parameter = max(0, min(root.remove-slot, root.focused-parameter + d));
                    // Back into the parameters while arranging: on the last one's strip
                    root.arrange-stop = root.arranging && root.focused-parameter < root.selected-parameters.length ? 1 : 0;
                    root.remove-armed = false;
                } else if (root.current-view == 0) {
                    // The blocks, then the add button
                    let n = root.positioned-nodes.length;
                    let next = max(0, min(n, (root.add-focused ? n : root.selected-plugin) + d));
                    if (next < n) {
                        root.select-node-at(next);
                    }
                    root.add-focused = next == n;
                } else if (root.current-view == 2) {
                    root.browser-selected-index = max(0, min(root.available-plugins.length - 1, root.browser-selected-index + d));
                }
                root.encoder-used();
                return accept;
            }
            // Press
            if (event.text == Key.Return) {
                if (root.pages-open) {
                    root.open-page(root.pages-index);
                } else if (root.dialog-open) {
                    // Not behind it
                } else if (root.focus-hidden) {
                    // Shows the focus before acting on it
                } else if (root.current-view == 0 && root.add-focused) {
                    root.open-browser(0, -1);
                } else if (root.current-view == 0) {
                    root.open-node(root.selected-plugin);
                } else if (root.current-view == 1) {
                    if (root.adjusting) {
                        root.adjusting = false;
                    } else if (root.arranging && root.focused-parameter < root.selected-parameters.length) {
                        if (root.arrange-stop == 0) {
                            // Picked: the turns move it
                            root.adjusting = true;
                        } else {
                            root.toggle-parameter-strip(root.selected-instance-id,
                                root.selected-parameters[root.focused-parameter].index);
                        }
                    } else if (root.focused-parameter == root.arrange-slot) {
                        root.arranging = !root.arranging;
                        root.arrange-stop = 0;
                    } else if (root.focused-parameter == root.reset-slot) {
                        root.reset-parameter-layout(root.selected-instance-id);
                    } else if (root.focused-parameter < root.selected-parameters.length) {
                        if (root.selected-parameters[root.focused-parameter].kind == "toggle") {
                            root.adjust(1);
                        } else {
                            root.adjust-from = root.selected-parameters[root.focused-parameter].value;
                            root.adjusting = true;
                        }
                    } else if (root.focused-parameter == root.bypass-slot) {
                        root.toggle-bypass(root.selected-instance-id);
                    } else if (root.remove-armed) {
                        root.remove-armed = false;
                        root.remove-node-by-id(root.selected-instance-id);
                        root.selected-instance-id = -1;
                        root.current-view = 0;
                    } else {
                        root.remove-armed = true;
                    }
                } else if (root.current-view == 7) {
                    root.settings-press();
                } else if (root.current-view == 12) {
                    root.hardware-press();
                } else if (root.adjusting) {
                    root.adjusting = false;
                } else if (root.page-slots > 0) {
                    root.page-press();
                } else if (root.current-view == 2) {
                    if (root.browser-selected-index >= 0 && root.browser-selected-index < root.available-plugins.length) {
                        root.add-plugin(root.available-plugins[root.browser-selected-index].uri);
                    }
                }
                root.encoder-used();
                return accept;
            }
            // Footswitches 1-8 and tap tempo, from a computer keyboard
            if (event.text >= "1" && event.text <= "8" && event.text.character-count == 1) {
                root.footswitch-down(event.text.to-float() - 1);
                return accept;
            }
            if (event.text == "t") {
                root.tap-tempo();
                return accept;
            }
            // External encoders 1-6 on the knob strip, from a computer
            // keyboard: a s d f g h turn right (shifted: left), z x c v b n
            // press (shifted: long press)
            if (root.current-view == 0) {
                let lower = event.text.to-lowercase();
                let turn = self.strip-key(lower, "a", "s", "d", "f", "g", "h");
                let press = self.strip-key(lower, "z", "x", "c", "v", "b", "n");
                let shifted = event.text != lower;
                if (turn >= 0) {
                    root.strip-encoder(turn, 0, shifted ? -1 : 1);
                    return accept;
                }
                if (press >= 0) {
                    root.strip-encoder(press, shifted ? 2 : 1, 0);
                    return accept;
                }
            }
            // Long press: back one level; on a main page, the page switcher
            if (event.text == Key.Escape) {
                if (root.pages-open) {
                    root.pages-open = false;
                } else if (root.show-resources) {
                    root.show-resources = false;
                } else if (root.show-context-menu) {
                    root.show-context-menu = false;
                } else if (root.netmidi-prompt-address != "") {
                    root.netmidi-later();
                } else if (root.power-dialog) {
                    root.power-dialog = false;
                } else if (root.update-dialog) {
                    root.update-dialog = false;
                } else if (root.current-view == 1 && root.arranging) {
                    // Drops the picked parameter, else leaves Arrange
                    if (root.adjusting) {
                        root.adjusting = false;
                    } else {
                        root.arranging = false;
                    }
                } else if (root.current-view == 1 && root.adjusting) {
                    // Back to the value before
                    root.set-parameter(root.selected-instance-id,
                        root.selected-parameters[root.focused-parameter].index, root.adjust-from);
                    root.adjusting = false;
                } else if (root.current-view == 7 && root.system-picker >= 0) {
                    root.system-picker = -1;
                } else if ((root.current-view == 7 || root.current-view == 12) && root.adjusting) {
                    // Audio & system: the steps stay pending, Cancel takes
                    // them back; elsewhere they are applied as they come
                    root.adjusting = false;
                } else if (root.current-view == 7 && root.wifi-open-shown && (root.settings-stop.what == "wifi-action"
                        || root.settings-stop.what == "wifi-forget"
                        || (root.settings-stop.what == "wifi-network" && root.settings-stop.index == root.wifi-open-index))) {
                    // Closes the network's actions
                    root.close-wifi-network();
                } else if (root.current-view == 7 && root.t3k-confirm-disconnect
                        && (root.settings-stop.what == "t3k-keep" || root.settings-stop.what == "t3k-disconnect")) {
                    root.t3k-confirm-disconnect = false;
                    root.page-focus = root.t3k-start;
                } else if (root.adjusting) {
                    root.set-page-value(root.adjust-from);
                    root.adjusting = false;
                } else if (root.current-view == 8) {
                    root.current-view = root.t3k-return-view;
                } else if (root.current-view == 10) {
                    root.current-view = root.routing-return-view;
                } else if (root.current-view == 12) {
                    root.current-view = 7;
                } else if (root.current-view == 11) {
                    if (root.catalog-open >= 0) {
                        root.catalog-open = -1;
                    } else {
                        root.current-view = 2;
                    }
                } else if (root.current-view == 6) {
                    root.current-view = 4;
                } else if (root.current-view == 1 || root.current-view == 2) {
                    root.current-view = 0;
                } else {
                    root.open-pages();
                }
                root.encoder-used();
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text >= "1" && event.text <= "8" && event.text.character-count == 1) {
                root.footswitch-up(event.text.to-float() - 1);
                return accept;
            }
            return reject;
        }
    }
}
