import { Theme } from "../theme.slint";
import { Button, Card, EmptyState, Icon, Knob, Segmented, Stepper, Toggle } from "../components/controls.slint";
import { LedBar } from "../components/level_meter.slint";
import { EqGraph } from "../components/eq_graph.slint";
import { EqView, PlotHandle, RoutingBlock, RoutingMaster, RoutingOutput } from "../types.slint";

// The global EQ and limiter of each output (src/routing_ui.rs answers)
export global OutputMaster {
    in-out property <RoutingMaster> edit;
    in-out property <EqView> eq;                 // curve of the output edited
    in-out property <[PlotHandle]> points;       // its band points, updated in place
    in-out property <[float]> reductions: [];    // limiter gain reduction per first output, dB (0 or below)
    callback open(int, int);                     // first output, 0 = EQ / 1 = limiter
    callback close();
    callback set-tab(int);
    callback select-band(int);
    callback set-eq(string, float);              // "on" | "band-on" | "freq" | "gain" | "q" | "flat"
    callback set-limiter(string, float);         // "on" | "ceiling" | "release"
    callback drag(int, float, float);            // band point dragged to x, y (0..1)
    callback toggle-band(int);                   // band point double-tapped
    callback resized(length, length);            // the curve's plot was laid out
}

// Gain reduction of a limiter: a bar hanging from the right, and its value
component ReductionMeter inherits HorizontalLayout {
    in property <float> db;                      // 0 or below
    in property <bool> on;
    in property <length> bar-height: 8px;
    spacing: Theme.space-xs;
    Text {
        text: "GR";
        color: root.on && root.db < -0.05 ? Theme.accent : Theme.text-muted;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: 0.8px;
        vertical-alignment: center;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle {
            height: root.bar-height + 4px;
            border-radius: Theme.radius-sm;
            background: Theme.display;
            border-width: 1px;
            border-color: Theme.edge-dark;
            // 12 dB across
            Rectangle {
                private property <float> f: root.on ? max(0, min(1, -root.db / 12)) : 0;
                x: parent.width - 2px - self.width;
                y: 2px;
                width: (parent.width - 4px) * self.f;
                height: root.bar-height;
                background: -root.db > 6 ? Theme.danger : Theme.accent;
            }
        }
    }
    Text {
        width: 34px;
        text: !root.on ? "OFF" : root.db > -0.05 ? "0.0" : round(root.db * 10) / 10;
        color: Theme.text-secondary;
        font-size: Theme.font-caption;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Title and explanation of a card
component CardTitle inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    spacing: Theme.space-md;
    VerticalLayout {
        alignment: center;
        Icon {
            name: root.icon;
            color: Theme.accent;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-title;
            font-weight: Theme.weight-semibold;
        }
        Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}

// Knob with its name and value under it
component LabeledKnob inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> default-value: 0;     // 0 dB, centre
    in property <length> knob-size: 60px;
    callback changed(float);
    spacing: 2px;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        Knob {
            size: root.knob-size;
            value: root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            default-value: root.default-value;
            changed(v) => {
                root.changed(v);
            }
        }
    }
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-bold;
        horizontal-alignment: center;
    }
    Text {
        text: root.value-text;
        color: Theme.text-primary;
        font-size: Theme.font-small;
        horizontal-alignment: center;
    }
}

// One output, or a stereo pair: source, meter, level, balance, mute / solo / polarity
component OutputStrip inherits Rectangle {
    in property <RoutingOutput> output;
    in property <float> level-a;     // meter of the first output (0..1)
    in property <float> level-b;     // and of the second one of a pair
    in property <float> reduction;   // limiter gain reduction, dB
    callback step-source(int, int);
    callback set-linked(int, bool);
    callback set-gain(int, float);
    callback set-pan(int, float);
    callback set-fold(int, int);
    callback toggle(int, string);

    width: 176px;
    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    border-width: Theme.border-width;
    border-color: root.output.solo ? Theme.warning.with-alpha(0.6) : Theme.border;

    VerticalLayout {
        alignment: start;
        padding: Theme.space-sm;
        spacing: Theme.space-sm;

        HorizontalLayout {
            height: Theme.touch-target;
            spacing: Theme.space-sm;
            Text {
                horizontal-stretch: 1;
                text: "OUT " + root.output.label;
                color: root.output.assigned ? Theme.text-primary : Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: Theme.weight-bold;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
            if root.output.assigned && (root.output.stereo || root.output.can-link): Button {
                icon: root.output.stereo ? "stereo" : "mono";
                active: root.output.stereo;
                clicked => {
                    root.set-linked(root.output.port, !root.output.stereo);
                }
            }
        }

        Stepper {
            text: root.output.source;
            can-decrement: root.output.assigned;
            decrement => {
                root.step-source(root.output.port, -1);
            }
            increment => {
                root.step-source(root.output.port, 1);
            }
        }

        if root.output.assigned: VerticalLayout {
            spacing: Theme.space-sm;

            // Meter: one bar, or one per side of a pair
            Rectangle {
                height: 16px;
                border-radius: Theme.radius-sm;
                background: Theme.display;
                border-width: 1px;
                border-color: Theme.edge-dark;
                if !root.output.stereo: LedBar {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: 8px;
                    level: root.level-a;
                }
                if root.output.stereo: LedBar {
                    x: 4px;
                    y: 3px;
                    width: parent.width - 8px;
                    height: 4px;
                    level: root.level-a;
                }
                if root.output.stereo: LedBar {
                    x: 4px;
                    y: 9px;
                    width: parent.width - 8px;
                    height: 4px;
                    level: root.level-b;
                }
            }

            HorizontalLayout {
                alignment: space-around;
                LabeledKnob {
                    label: "LEVEL";
                    value-text: (root.output.gain-db > 0 ? "+" : "") + round(root.output.gain-db * 10) / 10 + " dB";
                    value: root.output.gain-db;
                    // GAIN_RANGE_DB in src/audio/routing.rs
                    minimum: -60;
                    maximum: 12;
                    changed(v) => {
                        root.set-gain(root.output.port, v);
                    }
                }
                if root.output.stereo: LabeledKnob {
                    label: "BALANCE";
                    value-text: abs(root.output.pan) < 0.01 ? "C"
                        : (root.output.pan < 0 ? "L " : "R ") + round(abs(root.output.pan) * 100);
                    value: root.output.pan;
                    minimum: -1;
                    maximum: 1;
                    changed(v) => {
                        root.set-pan(root.output.port, v);
                    }
                }
            }

            // A stereo source on a single output
            if !root.output.stereo && root.output.bus: Segmented {
                options: ["L+R", "L", "R"];
                current-index: root.output.fold;
                activated(i) => {
                    root.set-fold(root.output.port, i);
                }
            }

            HorizontalLayout {
                spacing: Theme.space-xs;
                Button {
                    horizontal-stretch: 1;
                    text: "M";
                    variant: root.output.mute ? "solid-danger" : "secondary";
                    clicked => {
                        root.toggle(root.output.port, "mute");
                    }
                }
                Button {
                    horizontal-stretch: 1;
                    text: "S";
                    variant: root.output.solo ? "warning" : "secondary";
                    clicked => {
                        root.toggle(root.output.port, "solo");
                    }
                }
                Button {
                    horizontal-stretch: 1;
                    text: "Ø";
                    active: root.output.invert;
                    clicked => {
                        root.toggle(root.output.port, "invert");
                    }
                }
            }

            // Global EQ and limiter: lit when on, open their editor
            HorizontalLayout {
                spacing: Theme.space-xs;
                Button {
                    horizontal-stretch: 1;
                    text: "EQ";
                    font-size: Theme.font-small;
                    active: root.output.eq-on;
                    clicked => {
                        OutputMaster.open(root.output.port, 0);
                    }
                }
                Button {
                    horizontal-stretch: 1;
                    text: "LIMIT";
                    font-size: Theme.font-small;
                    active: root.output.limiter-on;
                    clicked => {
                        OutputMaster.open(root.output.port, 1);
                    }
                }
            }
            ReductionMeter {
                db: root.reduction;
                on: root.output.limiter-on;
            }
        }

        if !root.output.assigned: Text {
            text: "Silent";
            color: Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
        }
    }
}

// A send or return block of the preset, and where it is
component BlockRow inherits HorizontalLayout {
    in property <RoutingBlock> block;
    spacing: Theme.space-sm;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.block.name;
            color: root.block.bypassed ? Theme.text-secondary : Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        Text {
            text: root.block.place;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            overflow: elide;
        }
    }
    if root.block.bypassed: VerticalLayout {
        alignment: center;
        Text {
            text: "Bypassed";
            color: Theme.text-muted;
            font-size: Theme.font-small;
        }
    }
}

// Small-caps name over a control
component Caption inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
    font-weight: Theme.weight-bold;
    letter-spacing: 0.8px;
    horizontal-alignment: center;
}

// EQ and limiter of one output or pair, over the Routing view
component MasterPanel inherits Rectangle {
    private property <RoutingMaster> edit: OutputMaster.edit;
    background: Theme.background;

    // Taps on the backdrop do not reach the view under it
    TouchArea { }

    Card {
        x: Theme.space-sm;
        y: Theme.space-sm;
        width: parent.width - 2 * Theme.space-sm;
        height: parent.height - 2 * Theme.space-sm;

        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;

            HorizontalLayout {
                height: Theme.touch-target;
                spacing: Theme.space-md;
                Text {
                    text: root.edit.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-bold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
                Segmented {
                    width: 220px;
                    options: ["EQ", "LIMITER"];
                    current-index: root.edit.tab;
                    activated(i) => {
                        OutputMaster.set-tab(i);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: (root.edit.tab == 0 ? root.edit.eq-on : root.edit.limiter-on) ? "ON" : "OFF";
                    color: (root.edit.tab == 0 ? root.edit.eq-on : root.edit.limiter-on) ? Theme.accent : Theme.text-muted;
                    font-size: Theme.font-caption;
                    font-weight: Theme.weight-bold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
                Toggle {
                    checked: root.edit.tab == 0 ? root.edit.eq-on : root.edit.limiter-on;
                    toggled(on) => {
                        if root.edit.tab == 0 {
                            OutputMaster.set-eq("on", on ? 1 : 0);
                        } else {
                            OutputMaster.set-limiter("on", on ? 1 : 0);
                        }
                    }
                }
                Button {
                    width: 56px;
                    icon: "close";
                    clicked => {
                        OutputMaster.close();
                    }
                }
            }

            if root.edit.tab == 0: VerticalLayout {
                spacing: Theme.space-sm;

                EqGraph {
                    min-height: 90px;
                    vertical-stretch: 1;
                    wide: false;
                    eq: OutputMaster.eq;
                    points: OutputMaster.points;
                    plot-sized(w, h) => {
                        OutputMaster.resized(w, h);
                    }
                }

                Segmented {
                    options: ["LOW CUT", "LOW", "MID 1", "MID 2", "HIGH", "HIGH CUT"];
                    current-index: root.edit.band;
                    activated(i) => {
                        OutputMaster.select-band(i);
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-lg;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: center;
                            Toggle {
                                checked: root.edit.band-on;
                                toggled(on) => {
                                    OutputMaster.set-eq("band-on", on ? 1 : 0);
                                }
                            }
                        }
                        Caption {
                            text: "BAND";
                        }
                    }
                    LabeledKnob {
                        label: "FREQ";
                        knob-size: 48px;
                        value-text: root.edit.freq-text;
                        value: root.edit.freq;
                        minimum: 0;
                        maximum: 1;
                        default-value: 0.5663;
                        changed(v) => {
                            OutputMaster.set-eq("freq", v);
                        }
                    }
                    if root.edit.has-gain: LabeledKnob {
                        label: "GAIN";
                        knob-size: 48px;
                        value-text: root.edit.gain-text;
                        value: root.edit.gain;
                        // EQ_GAIN_RANGE_DB in src/audio/master.rs
                        minimum: -12;
                        maximum: 12;
                        changed(v) => {
                            OutputMaster.set-eq("gain", v);
                        }
                    }
                    if root.edit.has-q: LabeledKnob {
                        label: "Q";
                        knob-size: 48px;
                        value-text: root.edit.q-text;
                        value: root.edit.q;
                        // Q_RANGE
                        minimum: 0.3;
                        maximum: 8;
                        default-value: 1;
                        changed(v) => {
                            OutputMaster.set-eq("q", v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "FLAT";
                            font-size: Theme.font-small;
                            clicked => {
                                OutputMaster.set-eq("flat", 0);
                            }
                        }
                    }
                }
            }

            if root.edit.tab == 1: VerticalLayout {
                alignment: start;
                spacing: Theme.space-lg;
                Text {
                    text: "Keeps every sample of this output under the ceiling, whatever the preset plays. It looks "
                        + root.edit.latency-text + " ahead, so it adds that much delay while on. Set the ceiling a little under where the next device clips.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.space-xl;
                    LabeledKnob {
                        horizontal-stretch: 0;
                        label: "CEILING";
                        value-text: root.edit.ceiling-text;
                        value: root.edit.ceiling;
                        // CEILING_RANGE_DB in src/audio/master.rs
                        minimum: -12;
                        maximum: 0;
                        default-value: -1;
                        changed(v) => {
                            OutputMaster.set-limiter("ceiling", v);
                        }
                    }
                    LabeledKnob {
                        horizontal-stretch: 0;
                        label: "RELEASE";
                        value-text: root.edit.release-text;
                        value: root.edit.release;
                        minimum: 0;
                        maximum: 1;
                        default-value: 0.5;
                        changed(v) => {
                            OutputMaster.set-limiter("release", v);
                        }
                    }
                    // What it takes off right now
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-md;
                        background: Theme.display;
                        border-width: 1px;
                        border-color: Theme.edge-dark;
                        VerticalLayout {
                            padding: Theme.space-md;
                            spacing: Theme.space-xs;
                            alignment: center;
                            Caption {
                                text: "GAIN REDUCTION";
                                horizontal-alignment: left;
                            }
                            Text {
                                private property <float> db: OutputMaster.reductions[root.edit.port];
                                text: !root.edit.limiter-on ? "OFF" : (self.db > -0.05 ? "0.0" : round(self.db * 10) / 10) + " dB";
                                color: root.edit.limiter-on && self.db < -0.05 ? Theme.accent : Theme.text-muted;
                                font-size: Theme.font-headline;
                                font-weight: Theme.weight-semibold;
                            }
                            ReductionMeter {
                                bar-height: 12px;
                                db: OutputMaster.reductions[root.edit.port];
                                on: root.edit.limiter-on;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Routing: the input feeding the effects, what each output of the interface plays, and
// the send and return blocks of the preset.
// Kept apart from the rack: with a 2 x 2 interface there is nothing to change here. Sends
// and returns are blocks of the rack, listed here to see what feeds each send.
export component RoutingView inherits Rectangle {
    in property <bool> available: false;     // audio running
    in property <string> summary: "";         // one line: inputs, outputs, main mix
    in property <int> inputs: 1;
    in property <int> input: 0;              // feeding the effects (0 = input 1)
    in property <[RoutingOutput]> outputs: [];
    in property <[float]> input-levels: [];  // meter positions, per input
    in property <[float]> output-levels: []; // and per output
    in property <string> preset-name;
    in property <[RoutingBlock]> blocks: [];  // send and return blocks of the preset, in signal order

    callback step-input(int);
    callback step-source(int, int);          // first output, delta
    callback set-linked(int, bool);
    callback set-gain(int, float);
    callback set-pan(int, float);
    callback set-fold(int, int);
    callback toggle(int, string);            // "mute" | "solo" | "invert"

    width: 100%;
    height: 100%;

    if !root.available: EmptyState {
        icon: "routing";
        title: "Audio is off";
        message: "Inputs and outputs can be set once the audio interface is running.";
    }

    if root.available: Flickable {
        content-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            if root.summary != "": Text {
                text: root.summary;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    CardTitle {
                        icon: "routing";
                        title: "Inputs";
                        text: root.inputs > 1
                            ? "The input that feeds the effects and the tuner. The others can be played straight on an output, without effects."
                            : "The interface has a single input: it feeds the effects and the tuner.";
                    }

                    HorizontalLayout {
                        spacing: Theme.space-lg;
                        if root.inputs > 1: VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-xs;
                            Text {
                                text: "EFFECTS INPUT";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                            Stepper {
                                width: 180px;
                                text: "Input " + (root.input + 1);
                                can-decrement: root.input > 0;
                                can-increment: root.input < root.inputs - 1;
                                decrement => {
                                    root.step-input(-1);
                                }
                                increment => {
                                    root.step-input(1);
                                }
                            }
                        }
                        // A meter per input, to find which one is plugged
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-xs;
                            for level[i] in root.input-levels: HorizontalLayout {
                                spacing: Theme.space-sm;
                                Text {
                                    width: 44px;
                                    text: "IN " + (i + 1);
                                    color: i == root.input ? Theme.accent : Theme.text-muted;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-bold;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 14px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.display;
                                    LedBar {
                                        x: 3px;
                                        y: 3px;
                                        width: parent.width - 6px;
                                        height: 8px;
                                        level: level;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    CardTitle {
                        icon: "volume";
                        title: "Outputs";
                        text: "What each output of the interface plays: the main mix of the effects, a send, or an input as it comes in. Kept for the whole pedalboard, whatever the preset.";
                    }

                    Flickable {
                        height: strips.preferred-height;
                        content-width: strips.preferred-width;
                        strips := HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-sm;
                            for output in root.outputs: OutputStrip {
                                output: output;
                                level-a: root.output-levels[output.port];
                                level-b: root.output-levels[output.port + 1];
                                reduction: OutputMaster.reductions[output.port];
                                step-source(port, delta) => {
                                    root.step-source(port, delta);
                                }
                                set-linked(port, on) => {
                                    root.set-linked(port, on);
                                }
                                set-gain(port, v) => {
                                    root.set-gain(port, v);
                                }
                                set-pan(port, v) => {
                                    root.set-pan(port, v);
                                }
                                set-fold(port, i) => {
                                    root.set-fold(port, i);
                                }
                                toggle(port, what) => {
                                    root.toggle(port, what);
                                }
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    CardTitle {
                        icon: "split";
                        title: "Sends and returns" + (root.preset-name != "" ? " · " + root.preset-name : "");
                        text: "Add a Send or a Return to the rack from +, in the Routing family. A send copies the signal at its place to an output above (a dry signal before the amp, a 100% wet reverb); a return brings an input in (a bass DI before a cabinet).";
                    }

                    if root.blocks.length == 0: Text {
                        text: "The preset has no send or return.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }

                    for block in root.blocks: BlockRow {
                        block: block;
                    }
                }
            }
        }
    }

    if root.available && OutputMaster.edit.shown: MasterPanel {
        width: root.width;
        height: root.height;
    }
}
