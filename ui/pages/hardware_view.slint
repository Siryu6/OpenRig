import { Theme } from "../theme.slint";
import { Card, Icon, Stepper, Toggle } from "../components/controls.slint";
import { Features } from "../features.slint";
import { SettingRow } from "settings_view.slint";

// Settings → Hardware: what is wired to the pedal (footswitches and their GPIOs, tap tempo,
// rotary encoder, external I2C encoders). Set up once, so on its own page rather than in
// the middle of the settings used every day.
export component HardwareView inherits Rectangle {
    in property <int> footswitch-count: 4;
    in property <bool> tap-switch: true;
    in property <int> footswitch-down-mask: 0;
    in property <[int]> hardware-footswitch-pins: [];
    in property <bool> hardware-encoder: false;
    in property <int> hardware-encoder-a: 5;
    in property <int> hardware-encoder-b: 6;
    in property <int> hardware-encoder-button: 13;  // -1: none
    in property <int> hardware-encoder-steps: 4;
    in property <bool> hardware-i2c: false;
    in property <string> hardware-i2c-module: "";
    in property <int> hardware-i2c-steps: 1;
    in property <bool> hardware-i2c-reverse: false;
    in property <string> hardware-i2c-found: "";   // boards found, or why not
    in property <string> hardware-message: "";
    callback tap-switch-changed(bool);
    callback hardware-set-i2c(bool);
    callback hardware-step(string, int, int);
    callback hardware-set-encoder(bool);
    callback hardware-set-encoder-button(bool);
    // The control the rotary encoder is on (see App.hardware-stop-at): the
    // `what` of hardware-step, or "tap", "i2c"; the footswitch; whether
    // the turns adjust it. Not the encoder's own settings: left to the
    // touch, they would cut it off
    in property <string> encoder-what: "";
    in property <int> encoder-index: 0;
    in property <bool> encoder-adjusting: false;

    width: 100%;
    height: 100%;

    // Scrolls the page so that a row (y in the page, height h) is in sight
    function reveal(y: length, h: length) {
        if (y < -list.content-y) {
            list.content-y = -y + Theme.space-md;
        } else if (y + h > list.height - list.content-y) {
            list.content-y = list.height - y - h - Theme.space-md;
        }
    }

    list := Flickable {
        content-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "footswitch";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            // The top bar names the page: only what it is about
                            Text {
                                text: Features.gpio ? "What is wired to the GPIO header: each input between its GPIO (BCM number) and ground. Changes apply at once."
                                    : "Footswitches played from the keys 1–8 of a keyboard. MIDI footswitches work whatever the number.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    SettingRow {
                        property <bool> focused: root.encoder-what == "footswitches";
                        changed focused => {
                            if (self.focused) {
                                root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                            }
                        }
                        label: "FOOTSWITCHES";
                        Stepper {
                            width: 180px;
                            text: root.footswitch-count == 0 ? "None" : root.footswitch-count;
                            focused: root.encoder-what == "footswitches";
                            adjusting: root.encoder-adjusting;
                            can-decrement: root.footswitch-count > 0;
                            can-increment: root.footswitch-count < 8;
                            decrement => {
                                root.hardware-step("footswitches", 0, -1);
                            }
                            increment => {
                                root.hardware-step("footswitches", 0, 1);
                            }
                        }
                    }

                    // One row per switch, its LED lit while it is pressed
                    if Features.gpio: VerticalLayout {
                        spacing: Theme.space-sm;
                        for pin[i] in root.hardware-footswitch-pins: SettingRow {
                            property <bool> focused: root.encoder-what == "footswitch" && root.encoder-index == i;
                            changed focused => {
                                if (self.focused) {
                                    root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                                }
                            }
                            label: "FS " + (i + 1);
                            label-color: Theme.text-primary;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    property <bool> down: Math.mod(Math.floor(root.footswitch-down-mask / Math.pow(2, i)), 2) == 1;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: self.down ? Theme.accent : Theme.display;
                                    border-width: 1px;
                                    border-color: self.down ? Theme.accent : Theme.border-strong;
                                }
                            }
                            Stepper {
                                width: 180px;
                                text: "GPIO " + pin;
                                focused: root.encoder-what == "footswitch" && root.encoder-index == i;
                                adjusting: root.encoder-adjusting;
                                decrement => {
                                    root.hardware-step("footswitch", i, -1);
                                }
                                increment => {
                                    root.hardware-step("footswitch", i, 1);
                                }
                            }
                        }
                    }

                    if root.footswitch-count >= 2: SettingRow {
                        property <bool> focused: root.encoder-what == "tap";
                        changed focused => {
                            if (self.focused) {
                                root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                            }
                        }
                        label: "TAP TEMPO ON FS " + root.footswitch-count;
                        Toggle {
                            checked: root.tap-switch;
                            focused: root.encoder-what == "tap";
                            toggled(on) => {
                                root.tap-switch-changed(on);
                            }
                        }
                    }
                    if root.footswitch-count >= 2: Text {
                        text: "The last footswitch taps the tempo; hold it to open the tuner, press any switch to close it.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if Features.gpio: SettingRow {
                        label: "ROTARY ENCODER";
                        Toggle {
                            checked: root.hardware-encoder;
                            toggled(on) => {
                                root.hardware-set-encoder(on);
                            }
                        }
                    }
                    if Features.gpio && root.hardware-encoder: VerticalLayout {
                        spacing: Theme.space-sm;
                        SettingRow {
                            label: "A";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-a;
                                decrement => {
                                    root.hardware-step("encoder-a", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-a", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "B";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-b;
                                decrement => {
                                    root.hardware-step("encoder-b", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-b", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "PUSH BUTTON";
                            label-color: Theme.text-primary;
                            Toggle {
                                checked: root.hardware-encoder-button >= 0;
                                toggled(on) => {
                                    root.hardware-set-encoder-button(on);
                                }
                            }
                            if root.hardware-encoder-button >= 0: Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-button;
                                decrement => {
                                    root.hardware-step("encoder-button", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-button", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "STEPS PER DETENT";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: root.hardware-encoder-steps;
                                can-decrement: root.hardware-encoder-steps > 1;
                                can-increment: root.hardware-encoder-steps < 4;
                                decrement => {
                                    root.hardware-step("encoder-steps", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-steps", 0, 1);
                                }
                            }
                        }
                        Text {
                            text: "Turning moves the focus like the arrow keys, the button confirms like Return. Lower the steps per detent if it takes several clicks to move.";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }

                    if Features.gpio: SettingRow {
                        property <bool> focused: root.encoder-what == "i2c";
                        changed focused => {
                            if (self.focused) {
                                root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                            }
                        }
                        label: "EXTERNAL ENCODERS (I2C)";
                        Toggle {
                            checked: root.hardware-i2c;
                            focused: root.encoder-what == "i2c";
                            toggled(on) => {
                                root.hardware-set-i2c(on);
                            }
                        }
                    }
                    if Features.gpio && root.hardware-i2c: VerticalLayout {
                        spacing: Theme.space-sm;
                        SettingRow {
                            property <bool> focused: root.encoder-what == "i2c-module";
                            changed focused => {
                                if (self.focused) {
                                    root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                                }
                            }
                            label: "BOARD";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 220px;
                                text: root.hardware-i2c-module;
                                focused: root.encoder-what == "i2c-module";
                                adjusting: root.encoder-adjusting;
                                decrement => {
                                    root.hardware-step("i2c-module", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("i2c-module", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            property <bool> focused: root.encoder-what == "i2c-steps";
                            changed focused => {
                                if (self.focused) {
                                    root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                                }
                            }
                            label: "STEPS PER DETENT";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: root.hardware-i2c-steps;
                                focused: root.encoder-what == "i2c-steps";
                                adjusting: root.encoder-adjusting;
                                can-decrement: root.hardware-i2c-steps > 1;
                                can-increment: root.hardware-i2c-steps < 4;
                                decrement => {
                                    root.hardware-step("i2c-steps", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("i2c-steps", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            property <bool> focused: root.encoder-what == "i2c-reverse";
                            changed focused => {
                                if (self.focused) {
                                    root.reveal(self.absolute-position.y - list.absolute-position.y - list.content-y, self.height);
                                }
                            }
                            label: "REVERSE";
                            label-color: Theme.text-primary;
                            Toggle {
                                checked: root.hardware-i2c-reverse;
                                focused: root.encoder-what == "i2c-reverse";
                                toggled(on) => {
                                    root.hardware-step("i2c-reverse", 0, on ? 1 : -1);
                                }
                            }
                        }
                        if root.hardware-i2c-found != "": Text {
                            text: root.hardware-i2c-found;
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "On SDA/SCL (GPIO 2 and 3). Encoders 1-5 turn the knobs of the rack's strip: press swaps with the value before turning, hold goes back to the default; on a list, press opens it and picks. A 6th encoder turns the strip's pages. Chain several boards with different addresses.";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }

                    if root.hardware-message != "": Text {
                        text: root.hardware-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
