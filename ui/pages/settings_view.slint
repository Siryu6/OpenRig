import { Theme } from "../theme.slint";
import { Button, Card, Icon, SectionHeader, Segmented, Stepper, Toggle } from "../components/controls.slint";
import { VirtualKeyboard } from "../components/virtual_keyboard.slint";
import { LogoMark, LogoText } from "../components/logo.slint";
import { NetMidiDevice, SystemSetting, WifiNetwork } from "../types.slint";
import { Tone3000Logo } from "../components/tone3000_brand.slint";
import { Features } from "../features.slint";

// Signal strength as four bars
component SignalBars inherits Rectangle {
    in property <int> signal;
    in property <color> bar-color: Theme.text-primary;
    width: 22px;
    height: 18px;
    for i in 4: Rectangle {
        x: i * 6px;
        y: parent.height - self.height;
        width: 4px;
        height: 6px + i * 4px;
        border-radius: 1px;
        background: root.signal >= 15 + i * 22 ? root.bar-color : Theme.led-off;
    }
}

// A setting: its label on the left, its control on the right
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <color> label-color: Theme.text-secondary;
    spacing: Theme.space-md;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: root.label-color;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            letter-spacing: 0.8px;
        }
    }
    @children
}

// Settings page: hardware, MIDI, Wi-Fi, and TONE3000 Connect, which links a tone3000.com
// account with the OAuth device flow (code + QR on screen, approval on a phone).
export component SettingsView inherits Rectangle {
    // Wi-Fi
    in property <string> wifi-status: "unsupported"; // "unsupported" | "no-device" | "off" | "on"
    in property <[WifiNetwork]> wifi-networks: [];
    in property <bool> wifi-scanning: false;
    in property <string> wifi-busy-ssid: "";        // being joined
    in property <string> wifi-message: "";          // last error
    in property <string> wifi-addresses: "";        // IPv4 of Ethernet / Wi-Fi, "" offline

    callback wifi-refresh(bool);                     // rescan
    callback wifi-set-enabled(bool);
    callback wifi-connect(string, string);           // ssid, password ("" = saved / open)
    callback wifi-disconnect();
    callback wifi-forget(string);

    // Hardware: footswitches (and their GPIOs), encoder
    in property <int> footswitch-count: 4;
    in property <bool> tap-switch: true;
    in property <int> footswitch-down-mask: 0;
    in property <[int]> hardware-footswitch-pins: [];
    in property <bool> hardware-encoder: false;
    in property <int> hardware-encoder-a: 5;
    in property <int> hardware-encoder-b: 6;
    in property <int> hardware-encoder-button: 13;  // -1: none
    in property <int> hardware-encoder-steps: 4;
    in property <bool> hardware-i2c: false;
    in property <string> hardware-i2c-module: "";
    in property <int> hardware-i2c-steps: 1;
    in property <bool> hardware-i2c-reverse: false;
    in property <string> hardware-i2c-found: "";   // boards found, or why not
    in property <string> hardware-message: "";
    callback tap-switch-changed(bool);
    callback hardware-set-i2c(bool);
    callback hardware-step(string, int, int);
    callback hardware-set-encoder(bool);
    callback hardware-set-encoder-button(bool);

    // MIDI
    in property <bool> midi-available: false;
    in property <string> midi-devices: "";           // devices listened to, or why not
    in property <int> midi-channel: 0;               // 0 = omni
    in property <bool> midi-clock: true;
    in property <bool> midi-activity: false;
    callback midi-channel-changed(int);
    callback midi-clock-changed(bool);
    callback light-theme-changed(bool);

    // Network MIDI (RTP-MIDI, on the pedalboard OS only)
    in property <bool> netmidi-available: false;
    in property <bool> netmidi-enabled: false;
    in property <bool> netmidi-busy: false;          // switching
    in property <string> netmidi-name: "";           // session name set ("" = host name)
    in property <string> netmidi-hostname: "";
    in property <string> netmidi-summary: "";        // what rtpmidid announces
    in property <[NetMidiDevice]> netmidi-sessions: [];
    in property <[NetMidiDevice]> netmidi-devices: []; // allowed or blocked
    in property <bool> netmidi-allow-all: false;
    in property <string> netmidi-message: "";
    callback netmidi-set-enabled(bool);
    callback netmidi-rename(string);
    callback netmidi-set-allow-all(bool);
    callback netmidi-allow(string, string);          // name, address
    callback netmidi-block(string, string);
    callback netmidi-forget(string, string);

    // Audio processing
    in property <int> dsp-cores: 0;                  // 0 = Auto
    in property <int> dsp-max-cores: 1;              // cores the effect chain can use
    callback dsp-cores-changed(int);

    // Audio & system (pedalboard.txt, on the pedalboard OS only)
    in property <bool> system-available: false;
    in property <[SystemSetting]> system-settings: [];
    in property <string> system-summary: "";        // latency of the buffer
    in property <bool> system-changed: false;       // differs from what runs
    in property <bool> system-busy: false;
    in property <string> system-message: "";
    callback system-step(string, int);
    callback system-apply();
    callback system-revert();

    // TONE3000 Connect
    in property <bool> t3k-available: true;          // built with the tone3000 feature
    in property <string> t3k-status: "signed-out";   // "signed-out" | "starting" | "waiting" | "connected"
    in property <string> t3k-client-id: "";
    in property <string> t3k-username: "";
    in property <string> t3k-user-code: "";
    in property <string> t3k-url: "";                // verification URL to type
    in property <image> t3k-qr;
    in property <string> t3k-error: "";

    callback t3k-connect(string);                    // publishable key
    callback t3k-cancel();
    callback t3k-disconnect();

    // Updates (Features.update: built with the update feature)
    // "idle" | "checking" | "up-to-date" | "available" (not installable here)
    // | "preparing" (files still building) | "ready" | "downloading"
    // | "installing" | "installed" | "error"
    in property <string> update-status: "idle";
    in property <string> update-current: "";         // running versions
    in property <string> update-version: "";         // latest release
    in property <string> update-kind: "";            // "app" | "system"
    in property <string> update-size: "";            // "15 MB"
    in property <float> update-progress: 0;          // download, 0..1
    in property <string> update-message: "";         // error
    callback update-check();
    callback update-install();
    callback update-restart();

    // Inputs and outputs (the routing itself has its own view)
    in property <string> routing-summary: "";
    callback open-routing();


    private property <bool> editing-key: false;
    private property <string> key-draft: "";
    private property <bool> confirm-disconnect: false;
    private property <string> wifi-open-ssid: "";    // row showing its actions
    private property <bool> netmidi-renaming: false;
    private property <string> netmidi-draft: "";
    private property <string> wifi-password-ssid: "";
    private property <string> wifi-password: "";

    init => {
        root.wifi-refresh(true);
    }

    width: 100%;
    height: 100%;

    Flickable {
        content-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            SectionHeader {
                text: "SETTINGS";
            }

            // ------------------------------------------------- Hardware
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "footswitch";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Hardware";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: Features.gpio ? "What is wired to the GPIO header: each input between its GPIO (BCM number) and ground. Changes apply at once."
                                    : "Footswitches played from the keys 1–8 of a keyboard. MIDI footswitches work whatever the number.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    SettingRow {
                        label: "FOOTSWITCHES";
                        Stepper {
                            width: 180px;
                            text: root.footswitch-count == 0 ? "None" : root.footswitch-count;
                            can-decrement: root.footswitch-count > 0;
                            can-increment: root.footswitch-count < 8;
                            decrement => {
                                root.hardware-step("footswitches", 0, -1);
                            }
                            increment => {
                                root.hardware-step("footswitches", 0, 1);
                            }
                        }
                    }

                    // One row per switch, its LED lit while it is pressed
                    if Features.gpio: VerticalLayout {
                        spacing: Theme.space-sm;
                        for pin[i] in root.hardware-footswitch-pins: SettingRow {
                            label: "FS " + (i + 1);
                            label-color: Theme.text-primary;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    property <bool> down: Math.mod(Math.floor(root.footswitch-down-mask / Math.pow(2, i)), 2) == 1;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: self.down ? Theme.accent : Theme.display;
                                    border-width: 1px;
                                    border-color: self.down ? Theme.accent : Theme.border-strong;
                                }
                            }
                            Stepper {
                                width: 180px;
                                text: "GPIO " + pin;
                                decrement => {
                                    root.hardware-step("footswitch", i, -1);
                                }
                                increment => {
                                    root.hardware-step("footswitch", i, 1);
                                }
                            }
                        }
                    }

                    if root.footswitch-count >= 2: SettingRow {
                        label: "TAP TEMPO ON FS " + root.footswitch-count;
                        Toggle {
                            checked: root.tap-switch;
                            toggled(on) => {
                                root.tap-switch-changed(on);
                            }
                        }
                    }
                    if root.footswitch-count >= 2: Text {
                        text: "The last footswitch taps the tempo; hold it to open the tuner, press any switch to close it.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if Features.gpio: SettingRow {
                        label: "ROTARY ENCODER";
                        Toggle {
                            checked: root.hardware-encoder;
                            toggled(on) => {
                                root.hardware-set-encoder(on);
                            }
                        }
                    }
                    if Features.gpio && root.hardware-encoder: VerticalLayout {
                        spacing: Theme.space-sm;
                        SettingRow {
                            label: "A";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-a;
                                decrement => {
                                    root.hardware-step("encoder-a", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-a", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "B";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-b;
                                decrement => {
                                    root.hardware-step("encoder-b", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-b", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "PUSH BUTTON";
                            label-color: Theme.text-primary;
                            Toggle {
                                checked: root.hardware-encoder-button >= 0;
                                toggled(on) => {
                                    root.hardware-set-encoder-button(on);
                                }
                            }
                            if root.hardware-encoder-button >= 0: Stepper {
                                width: 180px;
                                text: "GPIO " + root.hardware-encoder-button;
                                decrement => {
                                    root.hardware-step("encoder-button", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-button", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "STEPS PER DETENT";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: root.hardware-encoder-steps;
                                can-decrement: root.hardware-encoder-steps > 1;
                                can-increment: root.hardware-encoder-steps < 4;
                                decrement => {
                                    root.hardware-step("encoder-steps", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("encoder-steps", 0, 1);
                                }
                            }
                        }
                        Text {
                            text: "Turning moves the focus like the arrow keys, the button confirms like Return. Lower the steps per detent if it takes several clicks to move.";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }

                    if Features.gpio: SettingRow {
                        label: "EXTERNAL ENCODERS (I2C)";
                        Toggle {
                            checked: root.hardware-i2c;
                            toggled(on) => {
                                root.hardware-set-i2c(on);
                            }
                        }
                    }
                    if Features.gpio && root.hardware-i2c: VerticalLayout {
                        spacing: Theme.space-sm;
                        SettingRow {
                            label: "BOARD";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 220px;
                                text: root.hardware-i2c-module;
                                decrement => {
                                    root.hardware-step("i2c-module", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("i2c-module", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "STEPS PER DETENT";
                            label-color: Theme.text-primary;
                            Stepper {
                                width: 180px;
                                text: root.hardware-i2c-steps;
                                can-decrement: root.hardware-i2c-steps > 1;
                                can-increment: root.hardware-i2c-steps < 4;
                                decrement => {
                                    root.hardware-step("i2c-steps", 0, -1);
                                }
                                increment => {
                                    root.hardware-step("i2c-steps", 0, 1);
                                }
                            }
                        }
                        SettingRow {
                            label: "REVERSE";
                            label-color: Theme.text-primary;
                            Toggle {
                                checked: root.hardware-i2c-reverse;
                                toggled(on) => {
                                    root.hardware-step("i2c-reverse", 0, on ? 1 : -1);
                                }
                            }
                        }
                        if root.hardware-i2c-found != "": Text {
                            text: root.hardware-i2c-found;
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "On SDA/SCL (GPIO 2 and 3). Encoders 1-5 turn the knobs of the rack's strip: press swaps with the value before turning, hold goes back to the default; on a list, press opens it and picks. A 6th encoder turns the strip's pages. Chain several boards with different addresses.";
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }

                    if root.hardware-message != "": Text {
                        text: root.hardware-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ----------------------------------------- Inputs and outputs
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "routing";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Inputs and outputs";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: root.routing-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                width: 160px;
                                text: "Routing";
                                icon: "routing";
                                clicked => {
                                    root.open-routing();
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------- Audio & system
            if root.system-available: Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "settings";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Audio & system";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: root.system-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    for setting in root.system-settings: SettingRow {
                        label: setting.label;
                        Stepper {
                            width: 220px;
                            text: setting.value;
                            can-decrement: setting.can-decrement && !root.system-busy;
                            can-increment: setting.can-increment && !root.system-busy;
                            decrement => {
                                root.system-step(setting.key, -1);
                            }
                            increment => {
                                root.system-step(setting.key, 1);
                            }
                        }
                    }

                    if root.system-message != "": Text {
                        text: root.system-message;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.system-changed: HorizontalLayout {
                        spacing: Theme.space-md;
                        alignment: end;
                        Button {
                            width: 140px;
                            text: "Cancel";
                            enabled: !root.system-busy;
                            clicked => {
                                root.system-revert();
                            }
                        }
                        Button {
                            width: 140px;
                            text: "Apply";
                            variant: "primary";
                            enabled: !root.system-busy;
                            clicked => {
                                root.system-apply();
                            }
                        }
                    }
                }
            }

            // ----------------------------------------------- Processing
            if root.dsp-max-cores > 1: Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "rack";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Processing";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "Heavy rigs share the effects across the cores, without added latency";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "DSP CORES";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Stepper {
                            width: 180px;
                            text: root.dsp-cores == 0 ? "Auto (" + root.dsp-max-cores + ")"
                                : root.dsp-cores == 1 ? "1 core" : root.dsp-cores + " cores";
                            can-decrement: root.dsp-cores > 0;
                            can-increment: root.dsp-cores < root.dsp-max-cores;
                            decrement => {
                                root.dsp-cores-changed(root.dsp-cores - 1);
                            }
                            increment => {
                                root.dsp-cores-changed(root.dsp-cores + 1);
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------- Display
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "sun";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Display";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "A light theme reads better in daylight";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "LIGHT THEME";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Toggle {
                            checked: Theme.light;
                            toggled(on) => {
                                Theme.light = on;
                                root.light-theme-changed(on);
                            }
                        }
                    }
                }
            }

            // ----------------------------------------------------- MIDI
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "midi";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "MIDI";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: !root.midi-available ? (root.midi-devices != "" ? root.midi-devices : "Not available in this build")
                                    : root.midi-devices != "" ? root.midi-devices : "No MIDI device";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        // Activity LED
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.midi-activity ? Theme.accent : Theme.display;
                                border-width: 1px;
                                border-color: root.midi-activity ? Theme.accent : Theme.border-strong;
                            }
                        }
                    }

                    if root.midi-available: HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "CHANNEL";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Stepper {
                            width: 180px;
                            text: root.midi-channel == 0 ? "Omni" : "Ch " + root.midi-channel;
                            can-decrement: root.midi-channel > 0;
                            can-increment: root.midi-channel < 16;
                            decrement => {
                                root.midi-channel-changed(root.midi-channel - 1);
                            }
                            increment => {
                                root.midi-channel-changed(root.midi-channel + 1);
                            }
                        }
                    }

                    if root.midi-available: HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "FOLLOW MIDI CLOCK";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Toggle {
                            checked: root.midi-clock;
                            toggled(on) => {
                                root.midi-clock-changed(on);
                            }
                        }
                    }

                    if root.midi-available: Text {
                        text: "Helix-style map: PC selects presets (CC0 bank of 128), CC69 scenes, CC64 tap, CC68 tuner, CC49–56 footswitches. Other CCs are learned in the block editor.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ------------------------------------------- Network MIDI
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "midi";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Network MIDI";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: !root.netmidi-available ? "Network MIDI is handled by the system on this computer."
                                    : root.netmidi-busy ? "Switching…"
                                    : !root.netmidi-enabled ? "Off: nothing listens on the network. On, computers on the local network (RTP-MIDI) can play the pedal."
                                    : root.netmidi-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        if root.netmidi-available: VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked: root.netmidi-enabled;
                                toggled(on) => {
                                    root.netmidi-set-enabled(on);
                                }
                            }
                        }
                    }

                    if root.netmidi-available: HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "SESSION NAME";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Button {
                            width: 240px;
                            text: root.netmidi-name != "" ? root.netmidi-name : root.netmidi-hostname;
                            enabled: !root.netmidi-busy;
                            clicked => {
                                root.netmidi-draft = root.netmidi-name != "" ? root.netmidi-name : root.netmidi-hostname;
                                root.netmidi-renaming = true;
                            }
                        }
                    }

                    if root.netmidi-available: VerticalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: "NEW DEVICES";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: 0.8px;
                        }
                        Segmented {
                            options: ["Ask for new devices", "Allow anyone on the network"];
                            current-index: root.netmidi-allow-all ? 1 : 0;
                            activated(i) => {
                                root.netmidi-set-allow-all(i == 1);
                            }
                        }
                    }

                    if root.netmidi-available && root.netmidi-enabled: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.netmidi-sessions.length == 0 ? "No computer connected." : "CONNECTED";
                            color: root.netmidi-sessions.length == 0 ? Theme.text-muted : Theme.text-secondary;
                            font-size: root.netmidi-sessions.length == 0 ? Theme.font-small : Theme.font-caption;
                            font-weight: root.netmidi-sessions.length == 0 ? Theme.weight-medium : Theme.weight-bold;
                        }
                        for session in root.netmidi-sessions: Rectangle {
                            height: Theme.touch-target + 8px;
                            border-radius: Theme.radius-md;
                            background: session.state == "allowed" ? Theme.accent-soft : Theme.surface-raised;
                            border-width: 1px;
                            border-color: session.state == "allowed" ? Theme.accent : Theme.border;
                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                spacing: Theme.space-md;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: session.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-body;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: session.address + " · " + (session.state == "allowed" ? "listened to"
                                            : session.state == "waiting" ? "waiting for your answer"
                                            : session.state == "outside" ? "ignored: not on the local network" : "blocked");
                                        color: Theme.text-muted;
                                        font-size: Theme.font-small;
                                        overflow: elide;
                                    }
                                }
                                if session.state == "waiting": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Allow";
                                        variant: "primary";
                                        clicked => {
                                            root.netmidi-allow(session.name, session.address);
                                        }
                                    }
                                }
                                if session.state == "waiting" || session.state == "allowed": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Block";
                                        variant: "danger";
                                        clicked => {
                                            root.netmidi-block(session.name, session.address);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.netmidi-available && root.netmidi-devices.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "ALLOWED AND BLOCKED DEVICES";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: 0.8px;
                        }
                        for device in root.netmidi-devices: HorizontalLayout {
                            spacing: Theme.space-md;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: device.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                                Text {
                                    text: device.address + " · " + (device.state == "allowed" ? "allowed" : "blocked");
                                    color: device.state == "allowed" ? Theme.text-muted : Theme.danger;
                                    font-size: Theme.font-caption;
                                }
                            }
                            Button {
                                text: "Remove";
                                variant: "ghost";
                                clicked => {
                                    root.netmidi-forget(device.name, device.address);
                                }
                            }
                        }
                    }

                    if root.netmidi-available: Text {
                        text: "macOS: Audio MIDI Setup → MIDI Network Setup. Windows: rtpMIDI. Linux: rtpmidid. The MIDI map and learned controls apply as for a cable. Only the local network is listened to.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.netmidi-message != "": Text {
                        text: root.netmidi-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ---------------------------------------------------- Wi-Fi
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "wifi";
                                color: Theme.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Wi-Fi";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                        if root.wifi-status == "on": Button {
                            icon: "refresh";
                            horizontal-stretch: 0;
                            text: root.wifi-scanning ? "Scanning…" : "Scan";
                            variant: "ghost";
                            enabled: !root.wifi-scanning;
                            clicked => {
                                root.wifi-refresh(true);
                            }
                        }
                        if root.wifi-status == "on" || root.wifi-status == "off": VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked: root.wifi-status == "on";
                                toggled(on) => {
                                    root.wifi-set-enabled(on);
                                }
                            }
                        }
                    }

                    // To reach the pedal over SSH (issue #20)
                    if root.wifi-addresses != "": HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            horizontal-stretch: 0;
                            text: "IP address";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.wifi-addresses;
                            color: Theme.text-primary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.wifi-status == "unsupported": Text {
                        text: "Wi-Fi is managed by the system on this computer.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    if root.wifi-status == "no-device": Text {
                        text: "No Wi-Fi adapter found.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                    if root.wifi-status == "off": Text {
                        text: "Wi-Fi is off. Turn it on to get models and plugins.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                    if root.wifi-status == "on" && root.wifi-networks.length == 0: Text {
                        text: root.wifi-scanning ? "Looking for networks…" : "No network found.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }

                    if root.wifi-status == "on": VerticalLayout {
                        spacing: 4px;
                        for net in root.wifi-networks: Rectangle {
                            private property <bool> busy: root.wifi-busy-ssid == net.ssid;
                            private property <bool> open: root.wifi-open-ssid == net.ssid;
                            height: Theme.touch-target + 8px;
                            border-radius: Theme.radius-md;
                            background: row-ta.pressed ? Theme.surface-hover : net.connected ? Theme.accent-soft : Theme.surface-raised;
                            border-width: 1px;
                            border-color: net.connected ? Theme.accent : Theme.border;

                            row-ta := TouchArea {
                                enabled: root.wifi-busy-ssid == "";
                                clicked => {
                                    if (net.connected || net.saved) {
                                        root.wifi-open-ssid = open ? "" : net.ssid;
                                    } else if (net.secured) {
                                        root.wifi-password = "";
                                        root.wifi-password-ssid = net.ssid;
                                    } else {
                                        root.wifi-open-ssid = "";
                                        root.wifi-connect(net.ssid, "");
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                spacing: Theme.space-md;
                                VerticalLayout {
                                    alignment: center;
                                    SignalBars {
                                        signal: net.signal;
                                        bar-color: net.connected ? Theme.accent : Theme.text-primary;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: net.ssid;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    font-weight: net.connected ? Theme.weight-semibold : Theme.weight-medium;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if net.secured: VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: "lock";
                                        size: 16px;
                                        color: Theme.text-muted;
                                    }
                                }
                                if !open: Text {
                                    text: busy ? "Connecting…" : net.connected ? "Connected" : net.saved ? "Saved" : "";
                                    color: net.connected || busy ? Theme.accent : Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                if open && !net.connected: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Connect";
                                        variant: "primary";
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-connect(net.ssid, "");
                                        }
                                    }
                                }
                                if open && net.connected: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Disconnect";
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-disconnect();
                                        }
                                    }
                                }
                                if open: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Forget";
                                        variant: "danger";
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-forget(net.ssid);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.wifi-message != "": Text {
                        text: root.wifi-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    // Title row
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        // Entry point: the full logo (TONE3000 design requirements)
                        VerticalLayout {
                            alignment: center;
                            Tone3000Logo {
                                height: 22px;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Connect";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                        if root.t3k-status == "connected": Rectangle {
                            width: badge-text.preferred-width + 2 * Theme.space-md;
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            background: Theme.success-soft;
                            badge-text := Text {
                                text: "Connected";
                                color: Theme.success;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                            }
                        }
                    }

                    if !root.t3k-available: Text {
                        text: "Not available in this build (compiled without the \"tone3000\" feature).";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    // --- Signed out: Connect, with the OpenRig key unless another is set
                    if root.t3k-available && (root.t3k-status == "signed-out" || root.t3k-status == "starting"): VerticalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: "Link your TONE3000 account to download your favorite amps, pedals, cabs and spaces right on the pedalboard.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: Theme.touch-target;
                                border-radius: Theme.radius-md;
                                background: Theme.background;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                HorizontalLayout {
                                    padding-left: Theme.space-md;
                                    padding-right: Theme.space-md;
                                    spacing: Theme.space-sm;
                                    Text {
                                        text: "Application";
                                        color: Theme.text-muted;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.t3k-client-id == "" ? "OpenRig" : root.t3k-client-id;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }
                            Button {
                                icon: "edit";
                                horizontal-stretch: 0;
                                text: "Edit";
                                clicked => {
                                    root.key-draft = root.t3k-client-id;
                                    root.editing-key = true;
                                }
                            }
                            Button {
                                text: root.t3k-status == "starting" ? "Connecting…" : "Connect";
                                horizontal-stretch: 0;
                                variant: "primary";
                                enabled: root.t3k-status == "signed-out";
                                clicked => {
                                    root.t3k-connect(root.t3k-client-id);
                                }
                            }
                        }
                        Text {
                            text: "Developers can sign in through their own TONE3000 application: Edit, then its publishable key (t3k_pub_…); an empty key goes back to OpenRig. Never enter a secret key on a device.";
                            color: Theme.text-muted;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }
                    }

                    // --- Waiting for approval: QR + code
                    if root.t3k-available && root.t3k-status == "waiting": HorizontalLayout {
                        spacing: Theme.space-xl;
                        Rectangle {
                            width: 152px;
                            height: 152px;
                            border-radius: Theme.radius-md;
                            background: white;
                            Image {
                                width: 140px;
                                height: 140px;
                                source: root.t3k-qr;
                                image-rendering: pixelated;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-xs;
                            Text {
                                text: "Scan the QR code with your phone, or open";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: root.t3k-url;
                                color: Theme.accent;
                                font-size: Theme.font-body;
                                overflow: elide;
                            }
                            Text {
                                text: "and enter the code";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: root.t3k-user-code;
                                color: Theme.text-primary;
                                font-size: Theme.font-display;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 3px;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-md;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Waiting for approval…";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Cancel";
                                    variant: "ghost";
                                    clicked => {
                                        root.t3k-cancel();
                                    }
                                }
                            }
                        }
                    }

                    // --- Connected
                    if root.t3k-available && root.t3k-status == "connected": HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Signed in as @" + root.t3k-username;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "Your TONE3000 tones are available on this pedalboard.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                        }
                        if !root.confirm-disconnect: Button {
                            text: "Disconnect";
                            variant: "danger";
                            clicked => {
                                root.confirm-disconnect = true;
                            }
                        }
                        if root.confirm-disconnect: Button {
                            text: "Cancel";
                            clicked => {
                                root.confirm-disconnect = false;
                            }
                        }
                        if root.confirm-disconnect: Button {
                            text: "Disconnect";
                            variant: "solid-danger";
                            clicked => {
                                root.confirm-disconnect = false;
                                root.t3k-disconnect();
                            }
                        }
                    }

                    if root.t3k-error != "": Text {
                        text: root.t3k-error;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    // Attribution required by the TONE3000 API terms
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-sm;
                        Text {
                            text: "Powered by TONE3000";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                        }
                        Text {
                            text: "tone3000.com";
                            color: Theme.accent;
                            font-size: Theme.font-caption;
                        }
                    }
                }
            }

            // -------------------------------------------- Updates
            if Features.update: Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "refresh";
                                color: Theme.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Updates";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                        Button {
                            horizontal-stretch: 0;
                            text: root.update-status == "checking" ? "Checking…" : "Check for updates";
                            variant: "ghost";
                            enabled: root.update-status != "checking" && root.update-status != "downloading"
                                && root.update-status != "installing" && root.update-status != "installed";
                            clicked => {
                                root.update-check();
                            }
                        }
                    }

                    Text {
                        text: root.update-current;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }

                    if root.update-status == "up-to-date": Text {
                        text: "OpenRig is up to date.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                    if root.update-status == "available": Text {
                        text: "OpenRig " + root.update-version + " is available: github.com/Siryu6/OpenRig/releases";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    if root.update-status == "preparing": Text {
                        text: "OpenRig " + root.update-version + " is out; its update for this pedalboard is still being built. Check again later.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.update-status == "ready": HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-xs;
                            Text {
                                text: "OpenRig " + root.update-version + " is available";
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: Theme.weight-medium;
                            }
                            Text {
                                text: root.update-kind == "app"
                                    ? "App update, " + root.update-size + ": it runs when you restart OpenRig; the system stays as it is."
                                    : "System update, " + root.update-size + ": this version needs a new system. It runs when you restart the pedalboard, which goes back to the current one if it does not start.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Install";
                                variant: "primary";
                                clicked => {
                                    root.update-install();
                                }
                            }
                        }
                    }

                    if root.update-status == "downloading": VerticalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: "Downloading OpenRig " + root.update-version + "… " + round(root.update-progress * 100) + " %";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                        }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.surface-raised;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(root.update-progress, 0, 1);
                                border-radius: 3px;
                                background: Theme.accent;
                            }
                        }
                    }
                    if root.update-status == "installing": Text {
                        text: root.update-kind == "app"
                            ? "Installing OpenRig " + root.update-version + "…"
                            : "Writing the new system. This takes a few minutes; keep the pedalboard on.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.update-status == "installed": HorizontalLayout {
                        spacing: Theme.space-md;
                        Text {
                            horizontal-stretch: 1;
                            text: root.update-kind == "app"
                                ? "OpenRig " + root.update-version + " is installed. Restart OpenRig to use it."
                                : "OpenRig " + root.update-version + " is installed. Restart the pedalboard to use it.";
                            color: Theme.text-primary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.update-kind == "app" ? "Restart OpenRig" : "Restart now";
                                variant: "primary";
                                clicked => {
                                    root.update-restart();
                                }
                            }
                        }
                    }

                    if root.update-status == "error": Text {
                        text: root.update-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ---------------------------------------------- About
            Card {
                HorizontalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-lg;
                    LogoMark {
                        size: 64px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-xs;
                        HorizontalLayout {
                            alignment: start;
                            LogoText {
                                font-size: 28px;
                            }
                        }
                        Text {
                            text: "Open source guitar rig: LV2 effects, neural amps and impulse responses on a Raspberry Pi. Free software under the GPL 3.0 or later.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // Key editor
    if root.editing-key: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                VerticalLayout {
                    alignment: center;
                    padding-left: Theme.space-lg;
                    spacing: 2px;
                    Text {
                        text: "TONE3000 publishable key";
                        color: Theme.text-primary;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-bold;
                    }
                    Text {
                        text: "Optional: empty for OpenRig's. Starts with t3k_pub_. A USB keyboard works too (paste with Ctrl+V).";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                }
            }
            VirtualKeyboard {
                current-text: root.key-draft;
                placeholder: "t3k_pub_…";
                code: true;
                submit-label: "Connect";
                text-changed(t) => {
                    root.key-draft = t;
                }
                submit => {
                    root.editing-key = false;
                    root.t3k-connect(root.key-draft);
                }
                cancel => {
                    root.editing-key = false;
                }
            }
        }
    }

    // Network MIDI session name
    if root.netmidi-renaming: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                VerticalLayout {
                    alignment: center;
                    padding-left: Theme.space-lg;
                    spacing: 2px;
                    Text {
                        text: "Network MIDI session name";
                        color: Theme.text-primary;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-bold;
                    }
                    Text {
                        text: "Up to 32 letters, digits, spaces, dots, dashes or underscores. Empty: " + root.netmidi-hostname + ".";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                }
            }
            VirtualKeyboard {
                current-text: root.netmidi-draft;
                placeholder: root.netmidi-hostname;
                submit-label: "Save";
                text-changed(t) => {
                    root.netmidi-draft = t;
                }
                submit => {
                    root.netmidi-renaming = false;
                    root.netmidi-rename(root.netmidi-draft);
                }
                cancel => {
                    root.netmidi-renaming = false;
                }
            }
        }
    }

    // Wi-Fi password
    if root.wifi-password-ssid != "": Rectangle {
        background: Theme.scrim;
        TouchArea { }

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                VerticalLayout {
                    alignment: center;
                    padding-left: Theme.space-lg;
                    spacing: 2px;
                    Text {
                        text: "Password for " + root.wifi-password-ssid;
                        color: Theme.text-primary;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-bold;
                        overflow: elide;
                    }
                    Text {
                        text: "Tap #+= for symbols. A USB keyboard works too.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                }
            }
            VirtualKeyboard {
                current-text: root.wifi-password;
                placeholder: "Password";
                submit-label: "Join";
                secret: true;
                text-changed(t) => {
                    root.wifi-password = t;
                }
                submit => {
                    root.wifi-connect(root.wifi-password-ssid, root.wifi-password);
                    root.wifi-password = "";
                    root.wifi-password-ssid = "";
                }
                cancel => {
                    root.wifi-password = "";
                    root.wifi-password-ssid = "";
                }
            }
        }
    }
}
