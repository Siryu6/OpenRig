import { Theme } from "../theme.slint";
import { Button, Card, FocusHighlight, Icon, SectionHeader, Segmented, Stepper, Toggle } from "../components/controls.slint";
import { VirtualKeyboard } from "../components/virtual_keyboard.slint";
import { NetMidiDevice, SystemSetting, WifiNetwork } from "../types.slint";
import { Tone3000Logo } from "../components/tone3000_brand.slint";
import { Features } from "../features.slint";
import { RemoteCard, RemoteControl } from "../remote.slint";
import { Backup, BackupCard, BackupPanel } from "backup_view.slint";

// Signal strength as four bars
component SignalBars inherits Rectangle {
    in property <int> signal;
    in property <color> bar-color: Theme.text-primary;
    width: 22px;
    height: 18px;
    for i in 4: Rectangle {
        x: i * 6px;
        y: parent.height - self.height;
        width: 4px;
        height: 6px + i * 4px;
        border-radius: 1px;
        background: root.signal >= 15 + i * 22 ? root.bar-color : Theme.led-off;
    }
}

// A setting: its label on the left, its control on the right
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <color> label-color: Theme.text-secondary;
    spacing: Theme.space-md;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: root.label-color;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            letter-spacing: 0.8px;
        }
    }
    @children
}

// Settings page, the settings used most first: Wi-Fi, audio, display, MIDI, remote control,
// TONE3000 Connect (links a tone3000.com account with the OAuth device flow: code + QR on
// screen, approval on a phone), processing, and last the entry of the Hardware page.
// Routing and Updates / About have their own place in the ⋮ menu.
export component SettingsView inherits Rectangle {
    // Wi-Fi
    in property <string> wifi-status: "unsupported"; // "unsupported" | "no-device" | "off" | "on"
    in property <[WifiNetwork]> wifi-networks: [];
    in property <bool> wifi-scanning: false;
    in property <string> wifi-busy-ssid: "";        // being joined
    in property <string> wifi-message: "";          // last error
    in property <string> wifi-addresses: "";        // IPv4 of Ethernet / Wi-Fi, "" offline

    callback wifi-refresh(bool);                     // rescan
    callback wifi-set-enabled(bool);
    callback wifi-connect(string, string);           // ssid, password ("" = saved / open)
    callback wifi-disconnect();
    callback wifi-forget(string);

    // Hardware has its own page (HardwareView), opened from the last card
    callback open-hardware();

    // MIDI
    in property <bool> midi-available: false;
    in property <string> midi-devices: "";           // devices listened to, or why not
    in property <int> midi-channel: 0;               // 0 = omni
    in property <bool> midi-clock: true;
    in property <bool> midi-activity: false;
    callback midi-channel-changed(int);
    callback midi-clock-changed(bool);
    callback light-theme-changed(bool);

    // Network MIDI (RTP-MIDI, on the pedalboard OS only)
    in property <bool> netmidi-available: false;
    in property <bool> netmidi-enabled: false;
    in property <bool> netmidi-busy: false;          // switching
    in property <string> netmidi-name: "";           // session name set ("" = host name)
    in property <string> netmidi-hostname: "";
    in property <string> netmidi-summary: "";        // what rtpmidid announces
    in property <[NetMidiDevice]> netmidi-sessions: [];
    in property <[NetMidiDevice]> netmidi-devices: []; // allowed or blocked
    in property <bool> netmidi-allow-all: false;
    in property <string> netmidi-message: "";
    callback netmidi-set-enabled(bool);
    callback netmidi-rename(string);
    callback netmidi-set-allow-all(bool);
    callback netmidi-allow(string, string);          // name, address
    callback netmidi-block(string, string);
    callback netmidi-forget(string, string);

    // Audio processing
    in property <int> dsp-cores: 0;                  // 0 = Auto
    in property <int> dsp-max-cores: 1;              // cores the effect chain can use
    callback dsp-cores-changed(int);

    // Audio & system (pedalboard.txt, on the pedalboard OS only)
    in property <bool> system-available: false;
    in property <[SystemSetting]> system-settings: [];
    in property <string> system-summary: "";        // latency of the buffer
    in property <bool> system-changed: false;       // differs from what runs
    in property <bool> system-busy: false;
    in property <string> system-message: "";
    callback system-step(string, int);
    callback system-pick(string, int);              // key, index in its choices
    callback system-apply();
    callback system-revert();
    // The list of an Audio & system row open (row index, -1 none) with the
    // choice the encoder is on
    in-out property <int> system-picker: -1;
    in-out property <int> system-picker-index: 0;

    // TONE3000 Connect
    in property <bool> t3k-available: true;          // built with the tone3000 feature
    in property <string> t3k-status: "signed-out";   // "signed-out" | "starting" | "waiting" | "connected"
    in property <string> t3k-client-id: "";
    in property <string> t3k-username: "";
    in property <string> t3k-user-code: "";
    in property <string> t3k-url: "";                // verification URL to type
    in property <image> t3k-qr;
    in property <string> t3k-error: "";

    callback t3k-connect(string);                    // publishable key
    callback t3k-cancel();
    callback t3k-disconnect();

    // The control the rotary encoder is on (see App.settings-stop-at): its
    // name, its row in a list, and whether the turns adjust it
    in property <string> encoder-what: "";
    in property <int> encoder-index: 0;
    in property <bool> encoder-adjusting: false;

    // Opened by a tap or by the encoder
    in-out property <bool> editing-key: false;
    in-out property <string> key-draft: "";
    in-out property <bool> confirm-disconnect: false;
    in-out property <string> wifi-open-ssid: "";     // row showing its actions
    in-out property <int> wifi-open-index: -1;       // its index
    in-out property <bool> netmidi-renaming: false;
    in-out property <string> netmidi-draft: "";
    in-out property <string> wifi-password-ssid: "";
    private property <string> wifi-password: "";

    init => {
        root.wifi-refresh(true);
    }

    width: 100%;
    height: 100%;

    // Scrolls the page so that a row (y in the page, height h) is in sight
    function reveal(y: length, h: length) {
        if (y < -settings-list.content-y) {
            settings-list.content-y = -y + Theme.space-md;
        } else if (y + h > settings-list.height - settings-list.content-y) {
            settings-list.content-y = settings-list.height - y - h - Theme.space-md;
        }
    }

    // The same for a row at y in the window: the encoder's, kept in sight
    function reveal-at(y: length, h: length) {
        root.reveal(y - settings-list.absolute-position.y - settings-list.content-y, h);
    }

    settings-list := Flickable {
        content-height: content.preferred-height;

        content := VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            SectionHeader {
                text: "SETTINGS";
            }

            // ---------------------------------------------------- Wi-Fi
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        property <bool> focused: root.encoder-what == "wifi-scan" || root.encoder-what == "wifi-toggle";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-sm;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "wifi";
                                color: Theme.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Wi-Fi";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                        if root.wifi-status == "on": Button {
                            icon: "refresh";
                            horizontal-stretch: 0;
                            text: root.wifi-scanning ? "Scanning…" : "Scan";
                            variant: "ghost";
                            enabled: !root.wifi-scanning;
                            focused: root.encoder-what == "wifi-scan";
                            clicked => {
                                root.wifi-refresh(true);
                            }
                        }
                        if root.wifi-status == "on" || root.wifi-status == "off": VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked: root.wifi-status == "on";
                                focused: root.encoder-what == "wifi-toggle";
                                toggled(on) => {
                                    root.wifi-set-enabled(on);
                                }
                            }
                        }
                    }

                    // To reach the pedal over SSH (issue #20)
                    if root.wifi-addresses != "": HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            horizontal-stretch: 0;
                            text: "IP address";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.wifi-addresses;
                            color: Theme.text-primary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.wifi-status == "unsupported": Text {
                        text: "Wi-Fi is managed by the system on this computer.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    if root.wifi-status == "no-device": Text {
                        text: "No Wi-Fi adapter found.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                    if root.wifi-status == "off": Text {
                        text: "Wi-Fi is off. Turn it on to get models and plugins.";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                    }
                    if root.wifi-status == "on" && root.wifi-networks.length == 0: Text {
                        text: root.wifi-scanning ? "Looking for networks…" : "No network found.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                    }

                    if root.wifi-status == "on": VerticalLayout {
                        spacing: 4px;
                        for net[i] in root.wifi-networks: Rectangle {
                            private property <bool> busy: root.wifi-busy-ssid == net.ssid;
                            private property <bool> open: root.wifi-open-ssid == net.ssid && root.wifi-open-index == i;
                            // The row or its actions
                            property <bool> focused: (root.encoder-what == "wifi-network" || root.encoder-what == "wifi-action"
                                || root.encoder-what == "wifi-forget") && root.encoder-index == i;
                            changed focused => {
                                if (self.focused) {
                                    root.reveal-at(self.absolute-position.y, self.height);
                                }
                            }
                            height: Theme.touch-target + 8px;
                            border-radius: Theme.radius-md;
                            background: row-ta.pressed ? Theme.surface-hover : net.connected ? Theme.accent-soft : Theme.surface-raised;
                            border-width: 1px;
                            border-color: net.connected ? Theme.accent : Theme.border;

                            row-ta := TouchArea {
                                enabled: root.wifi-busy-ssid == "";
                                clicked => {
                                    if (net.connected || net.saved) {
                                        root.wifi-open-ssid = open ? "" : net.ssid;
                                        root.wifi-open-index = open ? -1 : i;
                                    } else if (net.secured) {
                                        root.wifi-password = "";
                                        root.wifi-password-ssid = net.ssid;
                                    } else {
                                        root.wifi-open-ssid = "";
                                        root.wifi-connect(net.ssid, "");
                                    }
                                }
                            }

                            if root.encoder-what == "wifi-network" && root.encoder-index == i: FocusHighlight { }

                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                spacing: Theme.space-md;
                                VerticalLayout {
                                    alignment: center;
                                    SignalBars {
                                        signal: net.signal;
                                        bar-color: net.connected ? Theme.accent : Theme.text-primary;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: net.ssid;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    font-weight: net.connected ? Theme.weight-semibold : Theme.weight-medium;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if net.secured: VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: "lock";
                                        size: 16px;
                                        color: Theme.text-muted;
                                    }
                                }
                                if !open: Text {
                                    text: busy ? "Connecting…" : net.connected ? "Connected" : net.saved ? "Saved" : "";
                                    color: net.connected || busy ? Theme.accent : Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                if open && !net.connected: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Connect";
                                        variant: "primary";
                                        focused: root.encoder-what == "wifi-action" && root.encoder-index == i;
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-connect(net.ssid, "");
                                        }
                                    }
                                }
                                if open && net.connected: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Disconnect";
                                        focused: root.encoder-what == "wifi-action" && root.encoder-index == i;
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-disconnect();
                                        }
                                    }
                                }
                                if open: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Forget";
                                        variant: "danger";
                                        focused: root.encoder-what == "wifi-forget" && root.encoder-index == i;
                                        clicked => {
                                            root.wifi-open-ssid = "";
                                            root.wifi-forget(net.ssid);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.wifi-message != "": Text {
                        text: root.wifi-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ------------------------------------------- Audio & system
            if root.system-available: Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "volume";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Audio & system";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: root.system-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    for setting[i] in root.system-settings: SettingRow {
                        label: setting.label;
                        // Keeps the encoder's row in sight
                        property <bool> focused: root.encoder-what == "system" && root.encoder-index == i;
                        changed focused => {
                            if (self.focused) {
                                root.reveal(self.absolute-position.y - settings-list.absolute-position.y - settings-list.content-y, self.height);
                            }
                        }
                        if setting.kind == "list": Rectangle {
                            width: 220px;
                            min-height: Theme.touch-target;
                            border-radius: Theme.radius-md;
                            background: list-ta.pressed ? Theme.surface-hover : Theme.surface-raised;
                            border-width: Theme.border-width;
                            border-color: Theme.border;
                            opacity: root.system-busy ? 0.4 : 1.0;
                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                spacing: Theme.space-sm;
                                Text {
                                    horizontal-stretch: 1;
                                    text: setting.value;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: "chevron-right";
                                        size: 16px;
                                        color: Theme.text-secondary;
                                    }
                                }
                            }
                            list-ta := TouchArea {
                                enabled: !root.system-busy;
                                clicked => {
                                    root.system-picker-index = max(0, setting.selected);
                                    root.system-picker = i;
                                }
                            }
                            if root.encoder-what == "system" && root.encoder-index == i: FocusHighlight { }
                        }
                        if setting.kind == "segmented": Segmented {
                            width: 220px;
                            options: setting.choices;
                            current-index: setting.selected;
                            focused: root.encoder-what == "system" && root.encoder-index == i;
                            adjusting: root.encoder-adjusting;
                            activated(k) => {
                                if (!root.system-busy) {
                                    root.system-pick(setting.key, k);
                                }
                            }
                        }
                        if setting.kind == "stepper": Stepper {
                            width: 220px;
                            text: setting.value;
                            focused: root.encoder-what == "system" && root.encoder-index == i;
                            adjusting: root.encoder-adjusting;
                            can-decrement: setting.can-decrement && !root.system-busy;
                            can-increment: setting.can-increment && !root.system-busy;
                            decrement => {
                                root.system-step(setting.key, -1);
                            }
                            increment => {
                                root.system-step(setting.key, 1);
                            }
                        }
                    }

                    if root.system-message != "": Text {
                        text: root.system-message;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.system-changed: HorizontalLayout {
                        property <bool> focused: root.encoder-what == "system-cancel" || root.encoder-what == "system-apply";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        alignment: end;
                        Button {
                            width: 140px;
                            text: "Cancel";
                            focused: root.encoder-what == "system-cancel";
                            enabled: !root.system-busy;
                            clicked => {
                                root.system-revert();
                            }
                        }
                        Button {
                            width: 140px;
                            text: "Apply";
                            variant: "primary";
                            focused: root.encoder-what == "system-apply";
                            enabled: !root.system-busy;
                            clicked => {
                                root.system-apply();
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------- Display
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "sun";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Display";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "A light theme reads better in daylight";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        property <bool> focused: root.encoder-what == "display-light";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "LIGHT THEME";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Toggle {
                            checked: Theme.light;
                            focused: root.encoder-what == "display-light";
                            toggled(on) => {
                                Theme.light = on;
                                root.light-theme-changed(on);
                            }
                        }
                    }
                }
            }

            // ----------------------------------------------------- MIDI
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "midi";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "MIDI";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: !root.midi-available ? (root.midi-devices != "" ? root.midi-devices : "Not available in this build")
                                    : root.midi-devices != "" ? root.midi-devices : "No MIDI device";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        // Activity LED
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.midi-activity ? Theme.accent : Theme.display;
                                border-width: 1px;
                                border-color: root.midi-activity ? Theme.accent : Theme.border-strong;
                            }
                        }
                    }

                    if root.midi-available: HorizontalLayout {
                        property <bool> focused: root.encoder-what == "midi-channel";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "CHANNEL";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Stepper {
                            width: 180px;
                            text: root.midi-channel == 0 ? "Omni" : "Ch " + root.midi-channel;
                            focused: root.encoder-what == "midi-channel";
                            adjusting: root.encoder-adjusting;
                            can-decrement: root.midi-channel > 0;
                            can-increment: root.midi-channel < 16;
                            decrement => {
                                root.midi-channel-changed(root.midi-channel - 1);
                            }
                            increment => {
                                root.midi-channel-changed(root.midi-channel + 1);
                            }
                        }
                    }

                    if root.midi-available: HorizontalLayout {
                        property <bool> focused: root.encoder-what == "midi-clock";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "FOLLOW MIDI CLOCK";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Toggle {
                            checked: root.midi-clock;
                            focused: root.encoder-what == "midi-clock";
                            toggled(on) => {
                                root.midi-clock-changed(on);
                            }
                        }
                    }

                    if root.midi-available: Text {
                        text: "Helix-style map: PC selects presets (CC0 bank of 128), CC69 scenes, CC64 tap, CC68 tuner, CC49–56 footswitches. Other CCs are learned in the block editor.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ------------------------------------------- Network MIDI
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        property <bool> focused: root.encoder-what == "netmidi-toggle";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "plug";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Network MIDI";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: !root.netmidi-available ? "Network MIDI is handled by the system on this computer."
                                    : root.netmidi-busy ? "Switching…"
                                    : !root.netmidi-enabled ? "Off: nothing listens on the network. On, computers on the local network (RTP-MIDI) can play the pedal."
                                    : root.netmidi-summary;
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        if root.netmidi-available: VerticalLayout {
                            alignment: center;
                            Toggle {
                                checked: root.netmidi-enabled;
                                focused: root.encoder-what == "netmidi-toggle";
                                toggled(on) => {
                                    root.netmidi-set-enabled(on);
                                }
                            }
                        }
                    }

                    if root.netmidi-available: HorizontalLayout {
                        property <bool> focused: root.encoder-what == "netmidi-name";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "SESSION NAME";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Button {
                            width: 240px;
                            text: root.netmidi-name != "" ? root.netmidi-name : root.netmidi-hostname;
                            enabled: !root.netmidi-busy;
                            focused: root.encoder-what == "netmidi-name";
                            clicked => {
                                root.netmidi-draft = root.netmidi-name != "" ? root.netmidi-name : root.netmidi-hostname;
                                root.netmidi-renaming = true;
                            }
                        }
                    }

                    if root.netmidi-available: VerticalLayout {
                        property <bool> focused: root.encoder-what == "netmidi-new";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-sm;
                        Text {
                            text: "NEW DEVICES";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: 0.8px;
                        }
                        Segmented {
                            options: ["Ask for new devices", "Allow anyone on the network"];
                            current-index: root.netmidi-allow-all ? 1 : 0;
                            focused: root.encoder-what == "netmidi-new";
                            adjusting: root.encoder-adjusting;
                            activated(i) => {
                                root.netmidi-set-allow-all(i == 1);
                            }
                        }
                    }

                    if root.netmidi-available && root.netmidi-enabled: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.netmidi-sessions.length == 0 ? "No computer connected." : "CONNECTED";
                            color: root.netmidi-sessions.length == 0 ? Theme.text-muted : Theme.text-secondary;
                            font-size: root.netmidi-sessions.length == 0 ? Theme.font-small : Theme.font-caption;
                            font-weight: root.netmidi-sessions.length == 0 ? Theme.weight-medium : Theme.weight-bold;
                        }
                        for session[k] in root.netmidi-sessions: Rectangle {
                            property <bool> focused: (root.encoder-what == "netmidi-allow" || root.encoder-what == "netmidi-block") && root.encoder-index == k;
                            changed focused => {
                                if (self.focused) {
                                    root.reveal-at(self.absolute-position.y, self.height);
                                }
                            }

                            height: Theme.touch-target + 8px;
                            border-radius: Theme.radius-md;
                            background: session.state == "allowed" ? Theme.accent-soft : Theme.surface-raised;
                            border-width: 1px;
                            border-color: session.state == "allowed" ? Theme.accent : Theme.border;
                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-sm;
                                spacing: Theme.space-md;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: session.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-body;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: session.address + " · " + (session.state == "allowed" ? "listened to"
                                            : session.state == "waiting" ? "waiting for your answer"
                                            : session.state == "outside" ? "ignored: not on the local network" : "blocked");
                                        color: Theme.text-muted;
                                        font-size: Theme.font-small;
                                        overflow: elide;
                                    }
                                }
                                if session.state == "waiting": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Allow";
                                        variant: "primary";
                                        focused: root.encoder-what == "netmidi-allow" && root.encoder-index == k;
                                        clicked => {
                                            root.netmidi-allow(session.name, session.address);
                                        }
                                    }
                                }
                                if session.state == "waiting" || session.state == "allowed": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Block";
                                        variant: "danger";
                                        focused: root.encoder-what == "netmidi-block" && root.encoder-index == k;
                                        clicked => {
                                            root.netmidi-block(session.name, session.address);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.netmidi-available && root.netmidi-devices.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "ALLOWED AND BLOCKED DEVICES";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: 0.8px;
                        }
                        for device[k] in root.netmidi-devices: HorizontalLayout {
                            property <bool> focused: root.encoder-what == "netmidi-remove" && root.encoder-index == k;
                            changed focused => {
                                if (self.focused) {
                                    root.reveal-at(self.absolute-position.y, self.height);
                                }
                            }

                            spacing: Theme.space-md;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: device.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                                Text {
                                    text: device.address + " · " + (device.state == "allowed" ? "allowed" : "blocked");
                                    color: device.state == "allowed" ? Theme.text-muted : Theme.danger;
                                    font-size: Theme.font-caption;
                                }
                            }
                            Button {
                                text: "Remove";
                                variant: "ghost";
                                focused: root.encoder-what == "netmidi-remove" && root.encoder-index == k;
                                clicked => {
                                    root.netmidi-forget(device.name, device.address);
                                }
                            }
                        }
                    }

                    if root.netmidi-available: Text {
                        text: "macOS: Audio MIDI Setup → MIDI Network Setup. Windows: rtpMIDI. Linux: rtpmidid. The MIDI map and learned controls apply as for a cable. Only the local network is listened to.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    if root.netmidi-message != "": Text {
                        text: root.netmidi-message;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
            }

            // ---------------------------------------------------- Remote control
            if RemoteControl.available: RemoteCard {
                encoder-what: root.encoder-what;
                encoder-index: root.encoder-index;
                reveal(y, h) => {
                    root.reveal-at(y, h);
                }
            }

            // ---------------------------------------------- TONE3000 Connect
            Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    // Title row
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        // Entry point: the full logo (TONE3000 design requirements)
                        VerticalLayout {
                            alignment: center;
                            Tone3000Logo {
                                height: 22px;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Connect";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }
                        if root.t3k-status == "connected": Rectangle {
                            width: badge-text.preferred-width + 2 * Theme.space-md;
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            background: Theme.success-soft;
                            badge-text := Text {
                                text: "Connected";
                                color: Theme.success;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                            }
                        }
                    }

                    if !root.t3k-available: Text {
                        text: "Not available in this build (compiled without the \"tone3000\" feature).";
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    // --- Signed out: Connect, with the OpenRig key unless another is set
                    if root.t3k-available && (root.t3k-status == "signed-out" || root.t3k-status == "starting"): VerticalLayout {
                        spacing: Theme.space-md;
                        Text {
                            text: "Link your TONE3000 account to download your favorite amps, pedals, cabs and spaces right on the pedalboard.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            property <bool> focused: root.encoder-what == "t3k-edit" || root.encoder-what == "t3k-connect";
                            changed focused => {
                                if (self.focused) {
                                    root.reveal-at(self.absolute-position.y, self.height);
                                }
                            }
                            spacing: Theme.space-md;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: Theme.touch-target;
                                border-radius: Theme.radius-md;
                                background: Theme.background;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                HorizontalLayout {
                                    padding-left: Theme.space-md;
                                    padding-right: Theme.space-md;
                                    spacing: Theme.space-sm;
                                    Text {
                                        text: "Application";
                                        color: Theme.text-muted;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.t3k-client-id == "" ? "OpenRig" : root.t3k-client-id;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }
                            Button {
                                icon: "edit";
                                horizontal-stretch: 0;
                                text: "Edit";
                                focused: root.encoder-what == "t3k-edit";
                                clicked => {
                                    root.key-draft = root.t3k-client-id;
                                    root.editing-key = true;
                                }
                            }
                            Button {
                                text: root.t3k-status == "starting" ? "Connecting…" : "Connect";
                                horizontal-stretch: 0;
                                variant: "primary";
                                enabled: root.t3k-status == "signed-out";
                                focused: root.encoder-what == "t3k-connect";
                                clicked => {
                                    root.t3k-connect(root.t3k-client-id);
                                }
                            }
                        }
                        Text {
                            text: "Developers can sign in through their own TONE3000 application: Edit, then its publishable key (t3k_pub_…); an empty key goes back to OpenRig. Never enter a secret key on a device.";
                            color: Theme.text-muted;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }
                    }

                    // --- Waiting for approval: QR + code
                    if root.t3k-available && root.t3k-status == "waiting": HorizontalLayout {
                        spacing: Theme.space-xl;
                        Rectangle {
                            width: 152px;
                            height: 152px;
                            border-radius: Theme.radius-md;
                            background: white;
                            Image {
                                width: 140px;
                                height: 140px;
                                source: root.t3k-qr;
                                image-rendering: pixelated;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-xs;
                            Text {
                                text: "Scan the QR code with your phone, or open";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: root.t3k-url;
                                color: Theme.accent;
                                font-size: Theme.font-body;
                                overflow: elide;
                            }
                            Text {
                                text: "and enter the code";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                            Text {
                                text: root.t3k-user-code;
                                color: Theme.text-primary;
                                font-size: Theme.font-display;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 3px;
                            }
                            HorizontalLayout {
                                property <bool> focused: root.encoder-what == "t3k-cancel";
                                changed focused => {
                                    if (self.focused) {
                                        root.reveal-at(self.absolute-position.y, self.height);
                                    }
                                }
                                spacing: Theme.space-md;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Waiting for approval…";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Cancel";
                                    variant: "ghost";
                                    focused: root.encoder-what == "t3k-cancel";
                                    clicked => {
                                        root.t3k-cancel();
                                    }
                                }
                            }
                        }
                    }

                    // --- Connected
                    if root.t3k-available && root.t3k-status == "connected": HorizontalLayout {
                        property <bool> focused: root.encoder-what == "t3k-keep" || root.encoder-what == "t3k-disconnect";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Signed in as @" + root.t3k-username;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "Your TONE3000 tones are available on this pedalboard.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                            }
                        }
                        if !root.confirm-disconnect: Button {
                            text: "Disconnect";
                            variant: "danger";
                            focused: root.encoder-what == "t3k-disconnect";
                            clicked => {
                                root.confirm-disconnect = true;
                            }
                        }
                        if root.confirm-disconnect: Button {
                            text: "Cancel";
                            focused: root.encoder-what == "t3k-keep";
                            clicked => {
                                root.confirm-disconnect = false;
                            }
                        }
                        if root.confirm-disconnect: Button {
                            text: "Disconnect";
                            variant: "solid-danger";
                            focused: root.encoder-what == "t3k-disconnect";
                            clicked => {
                                root.confirm-disconnect = false;
                                root.t3k-disconnect();
                            }
                        }
                    }

                    if root.t3k-error != "": Text {
                        text: root.t3k-error;
                        color: Theme.danger;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }

                    // Attribution required by the TONE3000 API terms
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-sm;
                        Text {
                            text: "Powered by TONE3000";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-bold;
                        }
                        Text {
                            text: "tone3000.com";
                            color: Theme.accent;
                            font-size: Theme.font-caption;
                        }
                    }
                }
            }

            // ----------------------------------------------- Processing
            if root.dsp-max-cores > 1: Card {
                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "rack";
                                color: Theme.accent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Processing";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                            }
                            Text {
                                text: "Heavy rigs share the effects across the cores, without added latency";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        property <bool> focused: root.encoder-what == "dsp-cores";
                        changed focused => {
                            if (self.focused) {
                                root.reveal-at(self.absolute-position.y, self.height);
                            }
                        }
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "DSP CORES";
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: 0.8px;
                            }
                        }
                        Stepper {
                            width: 180px;
                            text: root.dsp-cores == 0 ? "Auto (" + root.dsp-max-cores + ")"
                                : root.dsp-cores == 1 ? "1 core" : root.dsp-cores + " cores";
                            focused: root.encoder-what == "dsp-cores";
                            adjusting: root.encoder-adjusting;
                            can-decrement: root.dsp-cores > 0;
                            can-increment: root.dsp-cores < root.dsp-max-cores;
                            decrement => {
                                root.dsp-cores-changed(root.dsp-cores - 1);
                            }
                            increment => {
                                root.dsp-cores-changed(root.dsp-cores + 1);
                            }
                        }
                    }
                }
            }

            // --------------------------------------------- Hardware (own page)
            // Set up once, so last; its own page keeps this one short
            Card {
                property <bool> focused: root.encoder-what == "hardware";
                changed focused => {
                    if (self.focused) {
                        root.reveal-at(self.absolute-position.y, self.height);
                    }
                }
                hw-ta := TouchArea {
                    clicked => {
                        root.open-hardware();
                    }
                }
                HorizontalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "footswitch";
                            color: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Hardware";
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                        }
                        Text {
                            text: Features.gpio ? "Footswitches, tap tempo, rotary encoder and external encoders"
                                : "Footswitches and tap tempo";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "chevron-right";
                            color: hw-ta.pressed ? Theme.accent : Theme.text-secondary;
                        }
                    }
                }
                if root.encoder-what == "hardware": FocusHighlight {
                    radius: Theme.radius-lg;
                }
            }

            // ---------------------------------------------------- Backup
            BackupCard { }
        }
    }

    // Key editor
    if root.editing-key: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        // Its text field has the focus: a long press of the encoder
        // (Escape) reaches here and cancels
        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.editing-key = false;
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    VerticalLayout {
                        alignment: center;
                        padding-left: Theme.space-lg;
                        spacing: 2px;
                        Text {
                            text: "TONE3000 publishable key";
                            color: Theme.text-primary;
                            font-size: Theme.font-headline;
                            font-weight: Theme.weight-bold;
                        }
                        Text {
                            text: "Optional: empty for OpenRig's. Starts with t3k_pub_. A USB keyboard works too (paste with Ctrl+V).";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                        }
                    }
                }
                VirtualKeyboard {
                    current-text: root.key-draft;
                    placeholder: "t3k_pub_…";
                    code: true;
                    submit-label: "Connect";
                    text-changed(t) => {
                        root.key-draft = t;
                    }
                    submit => {
                        root.editing-key = false;
                        root.t3k-connect(root.key-draft);
                    }
                    cancel => {
                        root.editing-key = false;
                    }
                }
            }
        }
    }

    // Network MIDI session name
    if root.netmidi-renaming: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        // Its text field has the focus: a long press of the encoder
        // (Escape) reaches here and cancels
        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.netmidi-renaming = false;
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    VerticalLayout {
                        alignment: center;
                        padding-left: Theme.space-lg;
                        spacing: 2px;
                        Text {
                            text: "Network MIDI session name";
                            color: Theme.text-primary;
                            font-size: Theme.font-headline;
                            font-weight: Theme.weight-bold;
                        }
                        Text {
                            text: "Up to 32 letters, digits, spaces, dots, dashes or underscores. Empty: " + root.netmidi-hostname + ".";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                        }
                    }
                }
                VirtualKeyboard {
                    current-text: root.netmidi-draft;
                    placeholder: root.netmidi-hostname;
                    submit-label: "Save";
                    text-changed(t) => {
                        root.netmidi-draft = t;
                    }
                    submit => {
                        root.netmidi-renaming = false;
                        root.netmidi-rename(root.netmidi-draft);
                    }
                    cancel => {
                        root.netmidi-renaming = false;
                    }
                }
            }
        }
    }

    // Wi-Fi password
    if root.wifi-password-ssid != "": Rectangle {
        background: Theme.scrim;
        TouchArea { }

        // Its text field has the focus: a long press of the encoder
        // (Escape) reaches here and cancels
        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.wifi-password = "";
                    root.wifi-password-ssid = "";
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    VerticalLayout {
                        alignment: center;
                        padding-left: Theme.space-lg;
                        spacing: 2px;
                        Text {
                            text: "Password for " + root.wifi-password-ssid;
                            color: Theme.text-primary;
                            font-size: Theme.font-headline;
                            font-weight: Theme.weight-bold;
                            overflow: elide;
                        }
                        Text {
                            text: "Tap #+= for symbols. A USB keyboard works too.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                        }
                    }
                }
                VirtualKeyboard {
                    current-text: root.wifi-password;
                    placeholder: "Password";
                    submit-label: "Join";
                    secret: true;
                    text-changed(t) => {
                        root.wifi-password = t;
                    }
                    submit => {
                        root.wifi-connect(root.wifi-password-ssid, root.wifi-password);
                        root.wifi-password = "";
                        root.wifi-password-ssid = "";
                    }
                    cancel => {
                        root.wifi-password = "";
                        root.wifi-password-ssid = "";
                    }
                }
            }
        }
    }

    // Remote control password
    if RemoteControl.editing: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        // Its text field has the focus: a long press of the encoder
        // (Escape) reaches here and cancels
        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    RemoteControl.draft = "";
                    RemoteControl.editing = false;
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    VerticalLayout {
                        alignment: center;
                        padding-left: Theme.space-lg;
                        spacing: 2px;
                        Text {
                            text: "Remote control password";
                            color: Theme.text-primary;
                            font-size: Theme.font-headline;
                            font-weight: Theme.weight-bold;
                            overflow: elide;
                        }
                        Text {
                            text: "8 to 63 characters, also the password of the pedal's hotspot. Devices signed in sign in again.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            overflow: elide;
                        }
                    }
                }
                VirtualKeyboard {
                    current-text: RemoteControl.draft;
                    placeholder: "Password";
                    submit-label: "Save";
                    secret: true;
                    text-changed(t) => {
                        RemoteControl.draft = t;
                    }
                    submit => {
                        RemoteControl.set-password(RemoteControl.draft);
                        RemoteControl.draft = "";
                        RemoteControl.editing = false;
                    }
                    cancel => {
                        RemoteControl.draft = "";
                        RemoteControl.editing = false;
                    }
                }
            }
        }
    }

    // ---------------- List of an Audio & system choice ----------------
    // Like the block editor's list of options; the encoder turns through it
    if root.system-picker >= 0 && root.system-picker < root.system-settings.length: sheet := Rectangle {
        property <SystemSetting> setting: root.system-settings[root.system-picker];
        background: Theme.scrim;

        TouchArea {
            clicked => {
                root.system-picker = -1;
            }
        }

        Card {
            x: (parent.width - self.width) / 2;
            y: Theme.space-lg;
            width: 400px;
            height: parent.height - 2 * Theme.space-lg;
            background: Theme.surface-raised;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-md;

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: sheet.setting.label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        icon: "close";
                        variant: "ghost";
                        clicked => {
                            root.system-picker = -1;
                        }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: sheet.setting.choices.length * 52px;
                    interactive: self.content-height > self.height;
                    // Keeps the encoder's choice in sight, the current one when opening
                    property <int> at: root.system-picker-index;
                    function reveal() {
                        let y = self.at * 52px;
                        if (y < -self.content-y) {
                            self.content-y = -y;
                        } else if (y + 48px > self.height - self.content-y) {
                            self.content-y = self.height - y - 48px;
                        }
                    }
                    changed at => {
                        self.reveal();
                    }
                    changed height => {
                        self.reveal();
                    }

                    for label[k] in sheet.setting.choices: opt-row := Rectangle {
                        property <bool> current: k == sheet.setting.selected;
                        y: k * 52px;
                        height: 48px;
                        border-radius: Theme.radius-md;
                        background: opt-ta.pressed ? Theme.surface-hover : self.current ? Theme.accent-soft : transparent;
                        border-width: k == root.system-picker-index ? 2px : 0px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: Theme.space-md;
                            padding-right: Theme.space-md;
                            Text {
                                horizontal-stretch: 1;
                                text: label;
                                color: opt-row.current ? Theme.accent : Theme.text-primary;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if opt-row.current: VerticalLayout {
                                alignment: center;
                                Icon {
                                    name: "check";
                                    color: Theme.accent;
                                }
                            }
                        }

                        opt-ta := TouchArea {
                            clicked => {
                                root.system-pick(sheet.setting.key, k);
                                root.system-picker = -1;
                            }
                        }
                    }
                }
            }
        }
    }

    // Backup and restore, over the settings
    if Backup.open: BackupPanel { }
}
