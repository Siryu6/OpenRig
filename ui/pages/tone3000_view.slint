import { Theme } from "../theme.slint";
import { T3kTone, T3kModel } from "../types.slint";
import { Badge, Button, Card, Chip, EmptyState, Icon, Segmented } from "../components/controls.slint";
import { Tone3000Logo, T3kPicture } from "../components/tone3000_brand.slint";
import { VirtualKeyboard } from "../components/virtual_keyboard.slint";

export { T3kTone, T3kModel }

// TONE3000 library: the user's favorites / own / downloaded tones and the
// trending / latest lists, and a search sent when submitted, filtered by gear.
// Opening a tone lists its models: the user ticks the ones to download, then
// they are usable in a NAM or IR block.
// Laid out after the TONE3000 design requirements: full logo and the
// signed-in account in the header, each tone with its picture, gear, format
// and creator (avatar and username).
export component Tone3000View inherits Rectangle {
    in property <int> tab: 0;                        // index in tab-names, 5 = search results
    in property <string> query: "";
    in property <string> gear: "";                   // API value, "" = all
    in property <[T3kTone]> tones: [];
    in property <bool> loading: false;
    in property <string> error: "";
    in property <bool> has-more: false;
    // Open tone
    in-out property <bool> detail-open: false;
    in property <T3kTone> detail;
    in property <[T3kModel]> models: [];
    in property <bool> models-loading: false;
    in property <string> detail-url: "";
    in property <int> selected-count: 0;
    // Models are shown and ticked a page (25) at a time
    in property <int> model-page: 0;
    in property <int> model-pages: 0;
    in property <bool> page-selectable: false;
    in property <bool> page-selected: false;
    in property <string> download-status: "";       // "" when no download runs
    // Block the library was opened from ("" = none): downloaded models can be loaded in it
    in property <string> target-name: "";
    private property <bool> can-use: root.target-name != "" && root.detail.usable;
    // Gear filters ("" = all); only the block's gears when opened from a block
    in property <[string]> gear-ids: [];
    in property <[string]> gear-names: [];
    // Signed-in account
    in property <string> username: "";
    in property <image> avatar;

    callback load(int, string);                      // tab, gear
    callback load-more();
    callback open-tone(int);                         // index in tones
    callback toggle-model(int);                      // index in models
    callback select-page();                          // tick (or untick) every model shown
    callback model-page-changed(int);
    callback download-selected();
    callback cancel-downloads();
    callback search(string);                         // "" back to the lists
    callback use-model(string);                      // relative path
    callback add-model(string, string);              // block URI, relative path

    private property <[string]> tab-names: ["Favorites", "My tones", "Downloaded", "Trending", "Latest"];
    private property <length> row-height: 64px;
    private property <bool> searching: false;
    private property <string> draft: "";

    width: 100%;
    height: 100%;

    VerticalLayout {
        padding: Theme.space-md;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-sm;
            VerticalLayout {
                alignment: center;
                Tone3000Logo {
                    height: 20px;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                border-radius: Theme.radius-md;
                background: Theme.display;
                border-width: 1px;
                border-color: root.searching || root.query != "" ? Theme.accent : Theme.border;
                TouchArea {
                    clicked => {
                        root.draft = root.query;
                        root.searching = true;
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-right: Theme.space-xs;
                    spacing: Theme.space-sm;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "search";
                            size: 16px;
                            color: Theme.text-muted;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.query != "" ? root.query : "Search TONE3000";
                        color: root.query != "" ? Theme.text-primary : Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.query != "": Rectangle {
                        width: 36px;
                        Icon {
                            name: "close";
                            size: 14px;
                            color: Theme.text-secondary;
                        }
                        TouchArea {
                            clicked => {
                                root.search("");
                            }
                        }
                    }
                }
            }
            if root.username != "": VerticalLayout {
                alignment: center;
                T3kPicture {
                    width: 26px;
                    round: true;
                    source: root.avatar;
                    placeholder: "@";
                }
            }
            if root.username != "": Text {
                text: "@" + root.username;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }

        Segmented {
            options: root.tab-names;
            current-index: root.tab;
            activated(i) => {
                root.load(i, root.gear);
            }
        }

        HorizontalLayout {
            spacing: 6px;
            for name[i] in root.gear-names: Chip {
                text: name;
                selected: root.gear-ids[i] == root.gear;
                clicked => {
                    root.load(root.tab, root.gear-ids[i]);
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.tones.length == 0 && root.loading: Text {
                text: "Loading…";
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.tones.length == 0 && !root.loading && root.error == "": EmptyState {
                icon: root.tab == 0 ? "check" : "info";
                title: root.tab == 0 ? "No favorites yet" : root.tab == 1 ? "No tones published yet" :
                    root.tab == 2 ? "Nothing downloaded yet" : root.tab == 5 ? "No tone found" : "Nothing here";
                message: root.tab == 0 ? "Favorite tones on tone3000.com from your phone or computer: they show up here."
                    : root.tab == 5 ? (root.gear != "" ? "Try other words or another gear filter." : "Try other words.")
                    : root.gear != "" ? "Try another gear filter." : "";
            }

            if root.error != "": EmptyState {
                icon: "info";
                title: "TONE3000 is not reachable";
                message: root.error;
            }

            if root.tones.length > 0: Flickable {
                content-height: (root.tones.length + (root.has-more ? 1 : 0)) * (root.row-height + 4px);
                interactive: self.content-height > self.height;

                for tone[i] in root.tones: Rectangle {
                    y: i * (root.row-height + 4px);
                    height: root.row-height;
                    border-radius: Theme.radius-md;
                    background: row-ta.pressed ? Theme.surface-hover : Theme.surface;
                    opacity: tone.supported ? 1.0 : 0.55;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: Theme.space-md;
                        spacing: Theme.space-md;
                        VerticalLayout {
                            alignment: center;
                            T3kPicture {
                                width: 48px;
                                source: tone.image;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: tone.title;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: Theme.weight-semibold;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                T3kPicture {
                                    width: 16px;
                                    round: true;
                                    source: tone.avatar;
                                    placeholder: "@";
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "@" + tone.creator + " · " + tone.detail
                                        + (tone.license != "" ? " · " + tone.license : "");
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge {
                                text: tone.gear;
                                tone: tone.supported ? "accent" : "neutral";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Badge {
                                text: tone.format.to-uppercase();
                                tone: "neutral";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            width: 20px;
                            if tone.on-board: Icon {
                                name: "check";
                                color: Theme.success;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "chevron-right";
                                color: Theme.text-muted;
                            }
                        }
                    }

                    row-ta := TouchArea {
                        clicked => {
                            root.open-tone(i);
                        }
                    }
                }

                if root.has-more: Button {
                    x: (parent.width - self.width) / 2;
                    y: root.tones.length * (root.row-height + 4px) + 8px;
                    width: 200px;
                    text: root.loading ? "Loading…" : "Load more";
                    enabled: !root.loading;
                    clicked => {
                        root.load-more();
                    }
                }
            }
        }
    }

    // ---------------- Tone sheet ----------------
    if root.detail-open: Rectangle {
        background: Theme.scrim;

        TouchArea {
            clicked => {
                root.detail-open = false;
            }
        }

        Card {
            x: (parent.width - self.width) / 2;
            y: Theme.space-md;
            width: parent.width - 2 * Theme.space-xl;
            height: parent.height - 2 * Theme.space-md;
            background: Theme.surface-raised;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;

                HorizontalLayout {
                    spacing: Theme.space-md;
                    T3kPicture {
                        width: 88px;
                        source: root.detail.image;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.detail.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            T3kPicture {
                                width: 20px;
                                round: true;
                                source: root.detail.avatar;
                                placeholder: "@";
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "@" + root.detail.creator;
                                color: Theme.text-primary;
                                font-size: Theme.font-small;
                                font-weight: Theme.weight-semibold;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: root.detail.gear + " · " + root.detail.format.to-uppercase() + " · " + root.detail.detail
                                + (root.detail.license != "" ? " · License: " + root.detail.license : "");
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            overflow: elide;
                        }
                        Text {
                            text: root.detail-url;
                            color: Theme.accent;
                            font-size: Theme.font-caption;
                            overflow: elide;
                        }
                    }
                    Button {
                        horizontal-stretch: 0;
                        icon: "close";
                        variant: "ghost";
                        clicked => {
                            root.detail-open = false;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    vertical-stretch: 1;

                    if !root.detail.supported: EmptyState {
                        icon: "info";
                        title: "Format not supported yet";
                        message: "The pedalboard loads NAM captures and IRs (.wav).";
                    }

                    if root.detail.supported && root.models-loading: Text {
                        text: "Loading models…";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.detail.supported && !root.models-loading: Flickable {
                        content-height: root.models.length * 52px;
                        interactive: self.content-height > self.height;

                        for model[k] in root.models: Rectangle {
                            y: k * 52px;
                            height: 48px;
                            border-radius: Theme.radius-md;
                            background: model-ta.pressed && model.state == "remote" ? Theme.surface-hover
                                : model.selected ? Theme.accent-soft : Theme.surface;

                            // The whole row ticks a model to download
                            model-ta := TouchArea {
                                enabled: model.state == "remote";
                                clicked => {
                                    root.toggle-model(k);
                                }
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-md;
                                padding-right: Theme.space-xs;
                                spacing: Theme.space-md;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        border-width: 2px;
                                        border-color: model.selected ? Theme.accent : Theme.border-strong;
                                        background: model.selected ? Theme.accent : transparent;
                                        opacity: model.state == "remote" ? 1.0 : 0.0;
                                        if model.selected: Icon {
                                            name: "check";
                                            size: 16px;
                                            color: Theme.background;
                                        }
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: model.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: model.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                                if model.state == "remote": Rectangle {
                                    width: 128px;
                                }
                                if model.state == "queued" || model.state == "downloading": Text {
                                    width: 128px;
                                    text: model.state == "queued" ? "Waiting…" : "Downloading…";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if model.state == "local" && !root.can-use && root.detail.block-uri != "": Button {
                                    width: 128px;
                                    text: "Add";
                                    variant: "primary";
                                    clicked => {
                                        root.add-model(root.detail.block-uri, model.path);
                                    }
                                }
                                if model.state == "local" && !root.can-use && root.detail.block-uri == "": HorizontalLayout {
                                    width: 128px;
                                    alignment: center;
                                    spacing: Theme.space-xs;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "check";
                                            color: Theme.success;
                                        }
                                    }
                                    Text {
                                        text: "On board";
                                        color: Theme.success;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                    }
                                }
                                if model.state == "local" && root.can-use: Button {
                                    width: 128px;
                                    text: "Use";
                                    variant: "primary";
                                    clicked => {
                                        root.use-model(model.path);
                                    }
                                }
                            }
                        }
                    }
                }

                // Download bar: what is ticked, what is downloading
                HorizontalLayout {
                    spacing: Theme.space-md;
                    if root.model-pages > 1: HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: Theme.space-xs;
                        Button {
                            icon: "chevron-left";
                            variant: "ghost";
                            enabled: root.model-page > 0;
                            clicked => {
                                root.model-page-changed(root.model-page - 1);
                            }
                        }
                        Text {
                            text: (root.model-page + 1) + " / " + root.model-pages;
                            color: Theme.text-secondary;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Button {
                            icon: "chevron-right";
                            variant: "ghost";
                            enabled: root.model-page + 1 < root.model-pages;
                            clicked => {
                                root.model-page-changed(root.model-page + 1);
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.download-status != "" ? root.download-status
                            : root.models.length > 0 ? "Tick the models to download." : "";
                        color: root.download-status != "" ? Theme.text-primary : Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.download-status != "": Button {
                        horizontal-stretch: 0;
                        text: "Stop";
                        variant: "ghost";
                        clicked => {
                            root.cancel-downloads();
                        }
                    }
                    if root.page-selectable: Button {
                        horizontal-stretch: 0;
                        text: root.page-selected ? "Clear" : root.model-pages > 1 ? "Select page" : "Select all";
                        variant: "ghost";
                        clicked => {
                            root.select-page();
                        }
                    }
                    Button {
                        horizontal-stretch: 0;
                        width: 200px;
                        icon: "download";
                        text: root.selected-count > 0 ? "Download (" + root.selected-count + ")" : "Download";
                        variant: "primary";
                        enabled: root.selected-count > 0;
                        clicked => {
                            root.download-selected();
                        }
                    }
                }

                if root.can-use: Text {
                    text: "Use loads the model in " + root.target-name + ".";
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                }
                if !root.can-use && root.detail.block-uri != "": Text {
                    text: "Add puts the model in a new " + root.detail.block-name + " block at the end of the chain.";
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                }
            }
        }
    }

    // Search: sent once submitted, never while typing
    if root.searching: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        VerticalLayout {
            alignment: end;
            VirtualKeyboard {
                current-text: root.draft;
                placeholder: "Amp, pedal, creator…";
                submit-label: "Search";
                text-changed(t) => {
                    root.draft = t;
                }
                submit => {
                    root.searching = false;
                    root.search(root.draft);
                }
                cancel => {
                    root.searching = false;
                }
            }
        }
    }
}
