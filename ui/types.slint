// Data types shared between the UI and the Rust backend.
// Field names / types are part of the public API (Rust generates structs
// from them): do not rename or remove fields.

// Positioned layout node from the backend layout engine.
// Coordinates are in "layout units": main line at y = 0, split branches one
// or more rows of 64 above (top) / below (bottom) their split, depending on
// nesting; each cell is 96 wide, node centre = x + 48.
export struct PositionedNode {
    instance-id: int,
    x: float,
    y: float,
    width: float,
    height: float,
    name: string,
    is-split: bool,
    split-type: string,
    bypassed: bool,
    ab-select-a: bool,   // A/B split: true when branch A is active
    mix-ratio: float,    // Mix split: 1.0 = all top branch (A), 0.0 = all bottom branch (B)
    pan-a: float,        // Mix split in stereo: branch position, -1 left … 1 right
    pan-b: float,
    kind: string,        // drawing: "amp" | "combo" | "cab" | "pedal" | "space" | ""
    tint: color,         // colour chosen in the editor (when tinted)
    tinted: bool,
    t3k: bool,           // loads a TONE3000 download: shows the T3K mark
    picture: image,      // its store picture, drawn instead of the gear
    has-picture: bool,
}

// Where a dragged block can be dropped (layout units)
export struct DropSlotView {
    x: float,
    y: float,
}

// A colour of the block palette ("" = default look)
export struct ColorChoice {
    name: string,
    label: string,
    color: color,
}

// Connector line segment (same coordinate space as PositionedNode)
export struct Connector {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    is-stereo: bool,
    is-mono: bool,      // only shown in mono mode
    wide: bool,         // carries a stereo signal: drawn as a double line
}

// One controllable parameter of the selected plugin
export struct ParameterInfo {
    index: int,              // LV2 control-param index for set-parameter
    name: string,
    min: float,
    max: float,
    default: float,
    value: float,
    unit: string,            // "dB", "ms", "Hz", "%" or ""
    kind: string,            // "float" | "int" | "toggle" | "enum"
    options: [string],       // enum labels (kind == "enum")
    option-values: [float],  // enum values, same order as options
    has-off: bool,           // off-value is shown as "Off"
    off-value: float,
    midi: string,            // "CC 11" when a MIDI controller drives it
}

export struct PluginItem {
    uri: string,
    name: string,
    author: string,
    category: string,
    kind: string,       // built-in gear ("amp", "cab"…), "" otherwise
    hint: string,       // built-in blocks: what to load in it
    color: color,       // colour of its family, as in the rack
    picture: image,     // its store picture, once downloaded
    has-picture: bool,
}

export struct PresetInfo {
    id: string,
    name: string,
    description: string,
    plugin-count: int,
    modified-date: string,
}

export struct SceneInfo {
    id: string,
    name: string,
    description: string,
    preset-count: int,
}

export struct SceneSlotInfo {
    slot-number: int,
    preset-id: string,
    preset-name: string,
    is-empty: bool,
    active: bool,                     // slot last switched to
}

export struct MenuItem {
    id: string,
    label: string,
    icon: string,
    enabled: bool,
}

export enum LooperState {
    Stopped,
    Recording,
    Playing,
    Overdubbing,
}

// Resource monitor snapshot (refreshed every second by Rust).
// Unknown values are -1 (0 for memory-total-mb).
export struct ResourceStatus {
    dsp-load: float,        // pedalboard audio callback, average fraction of the period
    dsp-peak: float,        // worst cycle of the last second
    jack-load: float,       // whole JACK graph, as reported by the server
    cpu: float,             // whole machine
    cpu-max-core: float,    // busiest core
    temperature: float,     // SoC, °C
    memory-used-mb: int,
    memory-total-mb: int,
    xruns: int,             // audio dropouts since start
    latency-ms: float,      // one buffer period
    buffer-info: string,    // "128 frames @ 48 kHz"
    throttling: string,     // Raspberry Pi firmware state ("" = not available)
    level: int,             // 0 ok, 1 warning, 2 critical
    message: string,        // reason for the level
}

// A TONE3000 tone in the library lists
export struct T3kTone {
    title: string,
    creator: string,     // username, shown as "by @creator"
    gear: string,        // display label ("Amp + cab")
    format: string,      // API value: "nam", "ir", "aida-x"…
    license: string,
    detail: string,      // "28 models · A2"
    supported: bool,     // a block can load its format
    on-board: bool,      // some of its models are downloaded
    usable: bool,        // can be loaded in the block the library was opened from
    block-uri: string,   // block made for it, added to the chain by "Add" ("" = none)
    block-name: string,
    image: image,        // tone picture, empty until loaded
    avatar: image,       // creator's avatar, empty until loaded
    image-key: string,   // which pictures these are, to fill them in once loaded
    avatar-key: string,
}

// A model of the open TONE3000 tone
export struct T3kModel {
    name: string,
    detail: string,      // "A2 · lite", "IR"
    state: string,       // "remote" | "downloading" | "local"
    path: string,        // relative to the models dir once downloaded
}

// An entry of the model / preset pickers of file blocks (NAM, IR)
export struct ModelChoice {
    title: string,
    subtitle: string,
    file: string,        // relative to the models dir (a tone's first preset)
    current: bool,
    image: image,        // picture saved with a TONE3000 tone (empty otherwise)
    t3k: bool,           // a TONE3000 download
}

// A Wi-Fi network in range (Settings)
export struct WifiNetwork {
    ssid: string,
    signal: int,         // 0..100
    secured: bool,
    connected: bool,
    saved: bool,         // joining needs no password
}

// Level meters (rack): 0..1 over -48..0 dBFS
export struct Levels {
    input: float,
    left: float,
    right: float,
    clip-in: bool,
    clip-out: bool,
}

// One footswitch of the Live page, as the current mode uses it
export struct LiveTile {
    title: string,
    subtitle: string,
    active: bool,      // LED lit: current scene, block on, current slot
    empty: bool,       // nothing on it (never-used scene, no block, free slot)
    color: color,      // LED colour (the block's for stomps)
    switch: int,       // physical footswitch number (1-based), 0 if none
}

// An output, or a stereo pair of outputs, in the Routing view
export struct RoutingOutput {
    port: int,          // first output (0 = output 1)
    label: string,      // "1–2", "3"
    stereo: bool,
    can-link: bool,     // can become a pair with the next output
    assigned: bool,     // plays something (else off)
    source: string,     // "Main mix", "Input 2", "Off"
    bus: bool,          // the source is a stereo bus: the main mix or a send
    gain-db: float,
    pan: float,         // -1 left … 1 right
    fold: int,          // stereo source on one output: 0 L+R, 1 L, 2 R
    mute: bool,
    solo: bool,
    invert: bool,
}

// A block of the preset, with its return and send (Routing view)
export struct RoutingBlock {
    instance-id: int,
    name: string,        // "Send 1", "Input 2"
    place: string,       // where it is: "A/B split · B, after Cabinet"
    bypassed: bool,
}

// Plugin store (catalog) entry
export struct CatalogItem {
    id: string,
    name: string,
    author: string,
    family: string,         // the families of the Add effect page
    subcategory: string,    // "Overdrive", "Compressor"…
    summary: string,        // one line, in the list
    description: string,    // the detail page
    inspired-by: string,    // gear it models, as text ("" none)
    tags: string,
    version: string,
    license: string,        // SPDX
    source: string,         // where its source code is
    official: bool,         // the author's own build, else built by OpenRig
    size: string,           // download size, "410 KB" ("" not built for this machine)
    controls: int,          // control ports of the plugin
    // "available" | "installed" | "update" | "manual" (copied by hand)
    // | "unavailable" | "installing" | "removing"
    state: string,
    note: string,           // why it is unavailable, or what went wrong
    progress: float,        // 0..1 while installing
    kind: string,           // gear drawn as its picture: "pedal", "amp", "cab", "space"
    color: color,           // colour of its family, as in the rack
    picture: image,         // the author's own picture, when it has one
    has-picture: bool,      // else the gear is drawn
    picture-credit: string, // "Michael Willis, GPL-3.0"
}

// A family chip of the store, with how many entries match the search
export struct CatalogFamily {
    name: string,
    count: int,
}

// A handle on a view's plot, which the finger drags: the UI gives where to
// (PlotEvents), Rust sets the controls it stands for
export struct PlotHandle {
    shown: bool,
    name: string,           // what it sets: "band 2", "threshold", "time"…
    label: string,          // "1", "LS", "T"…
    on: bool,               // filled, else hollow (an EQ band switched off)
    x: float,               // 0..1 from the left of the plot
    y: float,               // 0..1 from its bottom
}

// Plots draw path commands VIEW (1000) high and as wide as their box is for
// that height (1000 wide for a square)

// EQ curve of the selected block, drawn from its parameters
export struct EqView {
    shown: bool,
    enabled: bool,          // the plugin's own on/off
    curve: string,          // path commands
    fill: string,           // the same, closed on the 0 dB line
    range: float,           // the gain axis spans ± this many dB
}

// Sound going through the selected block, as areas under its spectrum in
// and out (empty when silent)
export struct Spectrum {
    input: string,
    output: string,
}

// Level curve of a compressor, limiter or gate: output level for each input
// level, both from -60 dB (left, bottom) to 0 dB (right, top)
export struct DynView {
    shown: bool,
    enabled: bool,
    kind: string,           // "Compressor", "Limiter", "Gate"
    summary: string,        // "4:1 · knee 6 dB"
    curve: string,          // path commands in the square
    threshold: PlotHandle,  // where the curve bends
    ratio: PlotHandle,      // the 0 dB end of a compressor's curve
}

// What the block does right now
export struct DynLive {
    active: bool,           // sound is going through
    input: float,           // level in and out, 0..1 across and up the square
    output: float,
    reduction: float,       // dB, 0 or less
    reduction-text: string,
    // Last seconds, path commands
    history-in: string,
    history-out: string,
    history-reduction: string,
}

// A line of a delay's echoes: where across, how high, 0 to 1
export struct EchoTap {
    x: float,
    height: float,
}

// What a delay, reverb, drive, modulation or cabinet block does to the sound
// (see plugins::scope)

export struct ScopeView {
    shown: bool,
    kind: string,           // "Delay", "Reverb"…
    summary: string,        // "250 ms · 6 echoes"
    // Square on the left: "history", "wave" (the waves in and out) or ""
    left: string,
    // Wide plot: "history" (levels over the last seconds), "spectrum" or
    // "echoes"
    right: string,
    // The dry sound and the echoes, as lines up from the bottom
    echo-taps: [EchoTap],
    echo-span: string,      // time across the box, "1.2 s"
    echo-time: PlotHandle,  // the first echo
    echo-feedback: PlotHandle, // the second
}

// What it does right now
export struct ScopeLive {
    // Last seconds, path commands
    history-in: string,
    history-out: string,
    // The waves in and out, in the square, empty in silence
    wave-in: string,
    wave-out: string,
    gain: string,           // output against input, "+12.5 dB"
}
