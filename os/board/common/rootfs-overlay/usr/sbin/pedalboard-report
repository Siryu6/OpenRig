#!/bin/sh
#
# What to paste in a bug report: versions, settings, the display, the audio
# interface, its driver and how JACK opened it, the GPIO pins, and the log
# of JACK and the app, the Wi-Fi state and log, and Network MIDI (state,
# sessions, the devices allowed or blocked: names and addresses only).
# Read-only. Run as root over SSH, e.g.
#
#   pedalboard-report > /tmp/report.txt

section() {
	printf '\n===== %s\n' "$1"
}

section "Versions"
/usr/sbin/pedalboard-update status 2>&1
uname -a
[ -r /proc/device-tree/model ] && tr -d '\0' </proc/device-tree/model && echo
cat /proc/cmdline

section "Settings (pedalboard.txt and defaults)"
cat /run/pedalboard/config 2>/dev/null || cat /etc/pedalboard/defaults

# Raspberry Pi: the HAT's EEPROM and the firmware settings added to the
# running boot partition (extra.txt), which is not mounted
if [ -d /proc/device-tree/hat ]; then
	section "HAT EEPROM"
	for f in vendor product product_id product_ver; do
		[ -r "/proc/device-tree/hat/$f" ] &&
			printf '%s: %s\n' "$f" "$(tr -d '\0' <"/proc/device-tree/hat/$f")"
	done
fi
case "$(cat /proc/cmdline)" in
*rauc.slot=B*) boot=/dev/disk/by-partuuid/5eda1b0a-b007-4000-8000-00000000000b ;;
*) boot=/dev/disk/by-partuuid/5eda1b0a-b007-4000-8000-00000000000a ;;
esac
if [ -e "$boot" ] && dir=$(mktemp -d); then
	if mount -t vfat -o ro "$boot" "$dir" 2>/dev/null; then
		section "Firmware settings (extra.txt)"
		grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$dir/extra.txt" 2>/dev/null ||
			echo "(none)"
		umount "$dir"
	fi
	rmdir "$dir"
fi

section "Display"
grep '^display_rotation=' /run/pedalboard/config 2>/dev/null ||
	grep '^display_rotation=' /etc/pedalboard/defaults
for c in /sys/class/drm/card*-*; do
	[ -r "$c/status" ] || continue
	printf '%s: %s, %s, modes: %s\n' "${c##*/}" "$(cat "$c/status")" \
		"$(cat "$c/enabled" 2>/dev/null)" "$(tr '\n' ' ' <"$c/modes" 2>/dev/null)"
done
for d in /sys/class/drm/card[0-9]*; do
	case "${d##*/}" in *-*) continue ;; esac
	[ -e "$d/device/driver" ] || continue
	driver=$(readlink "$d/device/driver")
	echo "${d##*/}: driver ${driver##*/}"
done
echo "modules:"
lsmod | grep -i -E 'panel|ili|il79600|drm|vc4|goodix|edt|touch|regulator|pwm_bl|i2c_mux'

# Raspberry Pi: the bootloader (it detects DSI displays and applies their
# overlay) and the display nodes the overlays added to the device tree
bl=/proc/device-tree/chosen/bootloader
if [ -d "$bl" ]; then
	echo "bootloader:"
	for f in version build-timestamp update-timestamp; do
		[ -r "$bl/$f" ] || continue
		case "$f" in
		*-timestamp)
			n=$((0x$(od -An -tx1 "$bl/$f" | tr -d ' \n')))
			printf '  %s: %s (%s)\n' "$f" "$n" "$(date -u -d "@$n" 2>/dev/null)"
			;;
		*) printf '  %s: %s\n' "$f" "$(tr -d '\0' <"$bl/$f")" ;;
		esac
	done
fi
if [ -d /proc/device-tree ]; then
	echo "device tree display nodes:"
	find /proc/device-tree -name compatible 2>/dev/null | while read -r f; do
		compat=$(tr '\0' ' ' <"$f")
		case "$compat" in
		*dsi* | *panel* | *ili* | *goodix* | *backlight* | *touchscreen*)
			node=${f%/compatible}
			status=$(tr -d '\0' <"$node/status" 2>/dev/null)
			echo "  ${node#/proc/device-tree}: $compat${status:+($status)}"
			;;
		esac
	done
fi

section "Input devices"
grep -E '^(N|H):' /proc/bus/input/devices

section "Kernel messages (display)"
dmesg | grep -i -E 'dsi|panel|ili|drm|vc4|goodix|gt911|touch|backlight|i2c|regulator|v3d' | tail -80

section "Sound cards"
cat /proc/asound/cards
aplay -l 2>&1
arecord -l 2>&1

# Format, rate and number of channels each open stream was set up with
section "Open streams (hw_params)"
open=
for f in /proc/asound/card[0-9]*/pcm*/sub*/hw_params; do
	[ -r "$f" ] || continue
	case "$(cat "$f")" in
	closed) ;;
	*) echo "$f:" && cat "$f" && open=1 ;;
	esac
done
[ -n "$open" ] || echo "(none: is jackd running?)"

section "Mixer controls"
for card in /proc/asound/card[0-9]*; do
	n=${card##*card}
	grep -q "^ *$n \[.*[Hh][Dd][Mm][Ii]" /proc/asound/cards && continue
	echo "card $n:"
	amixer -c "$n" scontents 2>&1 | head -100
done

section "Kernel messages (audio)"
dmesg | grep -i -E 'snd|asoc|i2s|codec|dac|adc|hifiberry|audio|dma|xrun|underrun|usb.*(audio|midi)' | tail -80

# Footswitch / encoder pins, and the GPIOs drivers hold: a footswitch on
# an audio HAT's I2S pin cuts outputs. The pin owners are in debugfs, when
# it is mounted.
section "GPIO"
echo "hardware.json:"
cat /data/pedalboard/hardware.json 2>/dev/null || echo "(none: the defaults)"
echo
for f in /sys/kernel/debug/pinctrl/*/pinmux-pins; do
	[ -r "$f" ] || continue
	echo "$f (claimed pins):"
	grep -v -e 'UNCLAIMED' -e '^Pinmux' "$f" | head -60
done
dmesg | grep -i -E 'pinctrl|gpio' | tail -40

section "Wi-Fi"
# No secrets here: nmcli lists networks and devices, never their passwords
if command -v nmcli >/dev/null 2>&1; then
	nmcli general status 2>&1
	nmcli device 2>&1
	echo
	nmcli -f IN-USE,SSID,SECURITY,SIGNAL,CHAN device wifi list --rescan no 2>&1 | head -30
fi
iw reg get 2>&1 | head -8
dmesg | grep -i -E 'brcmf|cfg80211|ieee80211' | tail -20
echo "wpa_supplicant SAE (WPA3): $(grep -c 'SAE' /usr/sbin/wpa_supplicant 2>/dev/null) references"
grep -E ' (NetworkManager|wpa_supplicant)(\[[0-9]+\])?: ' /var/log/messages 2>/dev/null | tail -80

section "Network MIDI"
echo "enabled: $(cat /data/network-midi/enabled 2>/dev/null || echo off)"
echo "session name: $(cat /data/network-midi/name 2>/dev/null || echo "$(hostname) (host name)")"
# Written by the app: the sessions rtpmidid has, and what the app does with them
cat /run/pedalboard/app/network-midi 2>/dev/null || echo "(no status from the app)"
echo "devices allowed or blocked (network-midi.json):"
cat /data/pedalboard/network-midi.json 2>/dev/null || echo "(none)"
echo
grep -E ' (network-midi|rtpmidid|avahi-daemon)(\[[0-9]+\])?: ' /var/log/messages 2>/dev/null | tail -60

section "JACK and app log"
grep -E ' (jackd|pedalboard|pedalboard-update|S00storage)(\[[0-9]+\])?: ' /var/log/messages 2>/dev/null | tail -200

section "Processes"
# BusyBox pgrep has no -a
# shellcheck disable=SC2009
ps | grep -E 'jackd|pedalboard|rtpmidid|avahi' | grep -v grep
