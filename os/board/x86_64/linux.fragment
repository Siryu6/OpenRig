# Mini PCs (Intel graphics, NVMe / SATA, Ethernet, Intel / Realtek Wi-Fi)
# and QEMU (virtio) for testing the image. Graphics are built in, so the
# display is ready when the UI starts.
CONFIG_DRM_I915=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_INPUT=m
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_EFI_STUB=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_HID_MULTITOUCH=m
# Framebuffer device for the boot splash (pedalboard-splash), without the
# text console on it
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set
