From 1e169fc82f72c22c753e57c3f51fb37ae9c76ad6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Guillaume=20GRAB=C3=89?=
 <guillaume.grabe@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:01:40 +0100
Subject: [PATCH 2/2] control socket: report numeric peer addresses

peer_status() resolved the local and remote addresses with getnameinfo(),
a reverse DNS lookup on the event loop for each status request: MIDI
stops while it waits for a slow or unreachable DNS server, and the
answer is a name chosen by whoever controls the reverse zone. Report the
numeric address instead.

Upstream: not sent yet
---
 src/utils.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/utils.cpp b/src/utils.cpp
index df41ba1..5749c5a 100644
--- a/src/utils.cpp
+++ b/src/utils.cpp
@@ -39,7 +39,7 @@ json_t peer_status(rtpmidid::rtppeer_t &peer) {
            {"name", peer.local_name},                   //
            {"ssrc", peer.local_ssrc},                   //
            {"port", peer.local_address.port()},         //
-           {"hostname", peer.local_address.hostname()}, //
+           {"hostname", peer.local_address.ip()}, //
        }},                                              //
       {
           "remote",
@@ -49,7 +49,7 @@ json_t peer_status(rtpmidid::rtppeer_t &peer) {
               {"sequence_number", peer.remote_seq_nr},      //
               {"ssrc", peer.remote_ssrc},                   //
               {"port", peer.remote_address.port()},         //
-              {"hostname", peer.remote_address.hostname()}, //
+              {"hostname", peer.remote_address.ip()}, //
           } //
       }
       //
