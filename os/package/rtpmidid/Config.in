config BR2_PACKAGE_RTPMIDID
	bool "rtpmidid"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_13 # C++20 <format>
	depends on BR2_USE_MMU # dbus
	depends on BR2_TOOLCHAIN_HAS_THREADS # dbus
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_SEQ
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_DBUS # libavahi-client
	help
	  RTP-MIDI (AppleMIDI) daemon: each network MIDI session
	  becomes an ALSA sequencer port. Sessions are announced with
	  mDNS / DNS-SD through avahi-daemon.

	  Network MIDI of the pedalboard OS (docs/MIDI.md), started by
	  /usr/libexec/pedalboard/network-midi when it is switched on.

	  https://github.com/davidmoreno/rtpmidid

comment "rtpmidid needs a toolchain w/ C++, threads, gcc >= 13"
	depends on BR2_USE_MMU
	depends on !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_13 || !BR2_TOOLCHAIN_HAS_THREADS
